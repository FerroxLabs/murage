expected schtasks prompt cannot ask for a credential.\n  $info = New-Object Diagnostics.ProcessStartInfo\n  $info.FileName = $File\n  $info.Arguments = ($ArgumentList | ForEach-Object { ConvertTo-WindowsArgument $_ }) -join ' '\n  $info.UseShellExecute = $false\n  $info.CreateNoWindow = $true\n  $info.RedirectStandardInput = $true\n  $info.RedirectStandardOutput = $true\n  $info.RedirectStandardError = $true\n  $process = New-Object Diagnostics.Process\n  $process.StartInfo = $info\n  try {\n    if (-not $process.Start()) { throw "Could not start $File" }\n    $process.StandardInput.Close()\n    $stdout = $process.StandardOutput.ReadToEndAsync()\n    $stderr = $process.StandardError.ReadToEndAsync()\n    if (-not $process.WaitForExit(30000)) {\n      $process.Kill(); $process.WaitForExit()\n      throw "Native command timed out: $File"\n    }\n    @{ ExitCode=$process.ExitCode; Stdout=$stdout.GetAwaiter().GetResult(); Stderr=$stderr.GetAwaiter().GetResult() }\n  } finally { $process.Dispose() }\n}\n`,
