// B35-only bounded adaptation of the accepted public AX query primitive.
// Public AX values and actions only; no DOM, AppleScript coordinates, or notification IPC.
// Pure selector: the observed tile changes from Focus to Do Not Disturb.
// A binary AXValue is required; a selected menu/navigation button is not DND state.
function dndToggleSelection(elements){
 var candidates=elements.filter(function(n){return ['AXCheckBox','AXButton'].indexOf(n.role)>=0&&n.names.some(function(name){return name==='Focus'||name==='Do Not Disturb';});});
 if(candidates.length!==1)return {ok:false,error:'AX-dnd-match',count:candidates.length};
 var n=candidates[0],value=[true,1,'1'].indexOf(n.value)>=0?true:[false,0,'0'].indexOf(n.value)>=0?false:null;
 if(value===null)return {ok:false,error:'AX-dnd-value',count:1,role:n.role,names:n.names,value:n.value};
 // A generic active Focus could be another mode; never infer DND from it.
 if(value&&n.names.indexOf('Do Not Disturb')<0)return {ok:false,error:'AX-dnd-mode-ambiguous',count:1,role:n.role,names:n.names,value:value};
 return {ok:true,count:1,index:elements.indexOf(n),role:n.role,names:n.names,value:value};
}
function run(argv){
 var c=JSON.parse(argv[0]),started=Date.now(),nodes=[],windows=[],visited=0,actionAttempted=false;
 if(c.op==='systemApplication'){
  try{
   if(['NotificationCenter','ControlCenter'].indexOf(c.name)<0)throw Error('system-name');
   ObjC.import('AppKit');
   var expected='/System/Library/CoreServices/'+c.name+'.app',bundle=$.NSBundle.bundleWithPath($(expected));
   if(!bundle)throw Error('system-bundle-missing');
   var bundleId=ObjC.unwrap(bundle.bundleIdentifier),executable=ObjC.unwrap(bundle.executablePath);
   if(!bundleId||executable!==expected+'/Contents/MacOS/'+c.name)throw Error('system-bundle-identity');
   var apps=$.NSRunningApplication.runningApplicationsWithBundleIdentifier($(bundleId)),running=[];
   for(var n=0;n<apps.count;n++){var app=apps.objectAtIndex(n);running.push({pid:Number(app.processIdentifier),bundlePath:ObjC.unwrap(app.bundleURL.path),executablePath:ObjC.unwrap(app.executableURL.path)});}
   return JSON.stringify({ok:true,name:c.name,bundleId:bundleId,bundlePath:expected,executablePath:executable,running:running});
  }catch(e){return JSON.stringify({ok:false,error:String(e)});}
 }
 ObjC.import('ApplicationServices');
 ObjC.bindFunction('AXUIElementCreateApplication',['id',['int']]);
 ObjC.bindFunction('AXUIElementCreateSystemWide',['id',[]]);
 ObjC.bindFunction('AXUIElementCopyAttributeValue',['int',['id','id','id *']]);
 ObjC.bindFunction('AXUIElementCopyActionNames',['int',['id','id *']]);
 ObjC.bindFunction('AXUIElementIsAttributeSettable',['int',['id','id','unsigned char *']]);
 ObjC.bindFunction('AXUIElementSetAttributeValue',['int',['id','id','id']]);
 ObjC.bindFunction('AXUIElementPerformAction',['int',['id','id']]);
 ObjC.bindFunction('AXUIElementSetMessagingTimeout',['int',['id','float']]);
 function fail(name,more){throw Object.assign({error:name},more||{});}
 function bound(){if(Date.now()-started>12000||(c.op==='allowNotificationPermission'&&Number.isFinite(c.deadline)&&Date.now()>=c.deadline))fail('AX-deadline',{visited:visited});}
 function read(e,k,required){bound();var r=Ref(),code=$.AXUIElementCopyAttributeValue(e,$(k),r);if(code===0)return ObjC.deepUnwrap(r[0]);if(!required&&(code===-25205||code===-25212))return null;fail('AX-read',{attribute:k,code:code});}
 function names(e){return ['AXTitle','AXDescription'].map(function(k){return read(e,k,false);}).filter(function(x){return typeof x==='string'&&x;});}
 function actions(e){var r=Ref(),code=$.AXUIElementCopyActionNames(e,r);if(code===0)return ObjC.deepUnwrap(r[0])||[];if(code===-25205||code===-25212)return[];fail('AX-actions',{code:code});}
 function walk(e,parent,depth){bound();if(depth>64||++visited>4000)fail('AX-limit',{visited:visited,depth:depth});var role=read(e,'AXRole',true),ns=names(e),value=read(e,'AXValue',false),id=nodes.length;nodes.push({e:e,parent:parent,role:role,names:ns,value:typeof value==='string'?value.slice(0,1200):typeof value==='number'||typeof value==='boolean'?value:null});if(role==='AXWindow'||role==='AXSheet')windows.push(id);var kids=read(e,'AXChildren',false)||[];for(var i=0;i<kids.length;i++)walk(kids[i],id,depth+1);}
 function text(n){return n.names.concat(typeof n.value==='string'?[n.value]:[]).join(' ');}
 function within(id,ancestor){while(id>=0){if(id===ancestor)return true;id=nodes[id].parent;}return false;}
 function scope(){if(!c.scopeName)return null;var s=nodes.map(function(n,i){return {n:n,i:i};}).filter(function(x){return x.n.names.indexOf(c.scopeName)>=0;});if(s.length!==1)fail('AX-scope',{count:s.length});return s[0].i;}
 function matches(){var sc=scope();return nodes.map(function(n,i){return{n:n,i:i};}).filter(function(x){return (sc===null||within(x.i,sc))&&(!c.roles||c.roles.indexOf(x.n.role)>=0)&&x.n.names.some(function(name){return c.prefix?name===c.label||name.indexOf(c.label+' ')===0:name===c.label;});});}
 function one(){var found=matches();if(found.length!==1)fail('AX-match',{count:found.length,label:c.label});return found[0].n;}
 function press(n){if((c.requireEnabled?read(n.e,'AXEnabled',true)!==true:read(n.e,'AXEnabled',false)===false))fail('AX-disabled');if(actions(n.e).indexOf('AXPress')<0)fail('AX-no-press');bound();actionAttempted=true;var code=$.AXUIElementPerformAction(n.e,$('AXPress'));if(code!==0)fail('AX-press',{code:code});}
 try{
  if(!Number.isInteger(c.pid)||c.pid<=0)fail('AX-pid');
  if(!$.AXIsProcessTrusted())fail('AX-client-not-trusted');
  if(c.settingsReadiness!==undefined&&(c.settingsReadiness!==true||c.op!=='tree'))fail('AX-settings-read-contract');
  var app=$.AXUIElementCreateApplication(c.pid),code=$.AXUIElementSetMessagingTimeout($.AXUIElementCreateSystemWide(),c.settingsReadiness===true?3:1);if(code!==0)fail('AX-timeout',{code:code});
  if(c.op==='manual'){code=$.AXUIElementSetAttributeValue(app,$('AXManualAccessibility'),$(true));return JSON.stringify({ok:code===0,code:code});}
  if(c.op==='key'){var allowed={escape:53,return:36,reload:15,quit:12},se=Application('System Events'),ps=se.processes.whose({unixId:c.pid});if(ps.length!==1||!(c.key in allowed))fail('AX-key');ps[0].frontmost=true;se.keyCode(allowed[c.key],{using:c.key==='reload'||c.key==='quit'?['command down']:[]});return JSON.stringify({ok:true});}
  walk(app,-1,0);
  if(c.op==='tree'||c.op==='probe')return JSON.stringify({ok:true,backend:'AXUIElement',visited:visited,elapsedMs:Date.now()-started,elements:nodes.map(function(n,i){return{index:i,parent:n.parent,role:n.role,names:n.names,value:n.value};})});
  if(c.op==='dndState'||c.op==='pressDnd'){
   var chosen=dndToggleSelection(nodes);
   if(!chosen.ok)return JSON.stringify(chosen);
   var control=nodes[chosen.index];chosen.enabled=read(control.e,'AXEnabled',false);chosen.actions=actions(control.e);
   if(c.op==='pressDnd'){
    if(typeof c.expectedValue!=='boolean'||chosen.value!==c.expectedValue)return JSON.stringify({ok:false,error:'AX-dnd-state-changed',observed:chosen});
    press(control);return JSON.stringify({ok:true,before:chosen});
   }
   return JSON.stringify(chosen);
  }
  if(c.op==='count'){var found=matches();return JSON.stringify({ok:true,count:found.length,visited:visited});}
  if(c.op==='state'){var n=one();return JSON.stringify({ok:true,value:n.value,selected:read(n.e,'AXSelected',false),enabled:read(n.e,'AXEnabled',false),role:n.role,names:n.names});}
  if(c.op==='press'){press(one());return JSON.stringify({ok:true});}
  if(c.op==='type'){
   var n=one(),ps=Application('System Events').processes.whose({unixId:c.pid}),observed={requested:c.text,role:n.role,enabled:read(n.e,'AXEnabled',true),readback:null};
   if(ps.length!==1||typeof c.text!=='string'||!c.text.length||['AXTextArea','AXTextField'].indexOf(n.role)<0||observed.enabled!==true)fail('AX-type',{observed:observed});
   var settable=Ref();observed.settableCode=$.AXUIElementIsAttributeSettable(n.e,$('AXValue'),settable);observed.settable=observed.settableCode===0&&Boolean(settable[0]);if(!observed.settable)fail('AX-type-not-settable',{observed:observed});
   observed.setCode=$.AXUIElementSetAttributeValue(n.e,$('AXValue'),$(c.text));if(observed.setCode!==0)fail('AX-type-set',{observed:observed});
   try{for(;;){bound();observed.readback=read(n.e,'AXValue',true);if(observed.readback===c.text)return JSON.stringify({ok:true,observed:observed});delay(.1);}}
   catch(error){error.observed=observed;throw error;}
  }
  if(c.op==='pressNotification'){
   if(typeof c.marker!=='string'||c.marker.length<8)fail('notification-marker');var candidates=[];
   nodes.forEach(function(n,i){if(text(n).indexOf(c.marker)<0)return;var at=i;while(at>=0){var candidate=nodes[at];if(['AXButton','AXGroup'].indexOf(candidate.role)>=0&&actions(candidate.e).indexOf('AXPress')>=0){if(candidates.indexOf(at)<0)candidates.push(at);break;}at=candidate.parent;}});
   if(candidates.length!==1)fail('notification-action-ambiguous',{count:candidates.length});press(nodes[candidates[0]]);return JSON.stringify({ok:true,marker:c.marker,targetRole:nodes[candidates[0]].role});
  }
  if(c.op==='allowNotificationPermission'){
   var title='“Murage” Notifications',body='Notifications may include alerts, sounds, and icon badges.';
   var groups=nodes.map(function(n,i){return{n:n,i:i};}).filter(function(x){return x.n.role==='AXGroup'&&x.n.names.indexOf(title)>=0&&nodes.some(function(n,j){return within(j,x.i)&&n.role==='AXStaticText'&&n.value===body;});});
   if(groups.length!==1)return JSON.stringify({ok:false,error:'consent-notice-not-unique',count:groups.length,actionAttempted:false});
   var group=groups[0],members=nodes.filter(function(n,i){return within(i,group.i);});
   var available=actions(group.n.e),observed={title:title,bodyMatched:true,groupRole:group.n.role,actions:available};
   var popupMenus=nodes.map(function(n,i){return{n:n,i:i};}).filter(function(x){if(x.n.role!=='AXMenu')return false;var at=x.n.parent;while(at>=0){if(nodes[at].role==='AXMenuBar')return false;at=nodes[at].parent;}return true;});
   var candidates;
   if(c.consentPhase==='menu'){
    if(popupMenus.length!==1)fail('consent-menu-not-unique',{observed:observed,count:popupMenus.length});
    candidates=nodes.filter(function(n,i){return within(i,popupMenus[0].i)&&['AXMenuItem','AXButton'].indexOf(n.role)>=0&&n.names.indexOf('Allow')>=0;});
    if(candidates.length!==1)fail('consent-allow-not-unique',{observed:observed,count:candidates.length});
    press(candidates[0]);return JSON.stringify({ok:true,consentPhase:'done',action:'Allow',observed:observed,actionAttempted:true});
   }
   if(['initial','revealed'].indexOf(c.consentPhase)<0)fail('consent-phase');
   candidates=members.filter(function(n){return n.role==='AXButton'&&n.names.indexOf('Allow')>=0;});
   if(candidates.length>1)fail('consent-allow-not-unique',{observed:observed,count:candidates.length});
   if(candidates.length===1){press(candidates[0]);return JSON.stringify({ok:true,consentPhase:'done',action:'Allow',observed:observed,actionAttempted:true});}
   var options=members.filter(function(n){return ['AXButton','AXPopUpButton'].indexOf(n.role)>=0&&n.names.indexOf('Options')>=0;});
   if(options.length>1)fail('consent-options-not-unique',{observed:observed,count:options.length});
   if(options.length===1){if(popupMenus.length)fail('consent-preexisting-menu',{observed:observed});press(options[0]);return JSON.stringify({ok:true,consentPhase:'menu',action:'Options',observed:observed,actionAttempted:true});}
   if(c.consentPhase==='initial'){
    if(popupMenus.length)fail('consent-preexisting-menu',{observed:observed});
    if(available.indexOf('AXShowMenu')>=0){bound();actionAttempted=true;var menuCode=$.AXUIElementPerformAction(group.n.e,$('AXShowMenu'));if(menuCode!==0)fail('AX-press',{code:menuCode,observed:observed});return JSON.stringify({ok:true,consentPhase:'menu',action:'AXShowMenu',observed:observed,actionAttempted:true});}
    return JSON.stringify({ok:true,consentPhase:'hover',action:'read-only-reveal-required',observed:observed,actionAttempted:false});
   }
   return JSON.stringify({ok:false,error:'consent-controls-not-observed',observed:observed,actionAttempted:false});
  }
  fail('AX-op');
 }catch(e){return JSON.stringify({ok:false,actionAttempted:actionAttempted,error:e.error||String(e),code:e.code===undefined?null:e.code,attribute:e.attribute||null,count:e.count===undefined?null:e.count,label:e.label||null,observed:e.observed||null,visited:visited,elapsedMs:Date.now()-started});}
}
