 "carryImmutable#3": {
  "verdict": "EQUIVALENT",
  "kind": "COMBINED",
  "separating": "sep-carryImmutable-3-capture-deletes-carry",
  "by": "outgoingCapturedBeforeSwap",
  "byLine": 1717,
  "argument": "line 2340 `next.carry` operand: removing it only changes a step whose next.carry is null while prev.carry is set. The only such step the mutant can fail is an armed job's capture (it reads next.carry.jobId and throws); every other path returns OK on a prev carry. A step that deletes the carry before its prep committed is rejected by outgoingCapturedBeforeSwap 'carry deleted before its prep committed', so no legal history separates the clause."
 },
 "carryImmutable#4": {
  "verdict": "EQUIVALENT",
  "kind": "COMBINED",
  "separating": "sep-carryImmutable-4-capture-leaves-other-jobs-carry",
  "by": "restoreJobMatchesReality",
  "byLine": 2223,
  "argument": "line 2340 `!same(prev.carry, next.carry)` operand: removing it makes an UNCHANGED carry be judged for provenance on an armed job's capture (next.carry.jobId !== armedJob.id). That differs only when a carry that belongs to another job sits unchanged beside the armed job, and restoreJobMatchesReality (carry.jobId !== job.id) rejects that state, so no accepted history separates it. A must-accept witness cannot exist."
 }
