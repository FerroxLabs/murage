{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.ferroxlabs.com/murage/announcements.schema.json",
  "title": "Murage announcements.yml",
  "description": "Editor help for announcements.yml. lint.mjs is the real check: it runs the app's own rules (shared/announcements.ts) plus the copy rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
          "kind": { "enum": ["info", "important", "security"] },
          "layout": { "enum": ["hero", "split", "spotlight"] },
          "accent": { "enum": ["orange", "blue", "gold", "violet", "mint", "paper"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "body": { "type": "string", "minLength": 1, "maxLength": 400 },
          "image": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(png|jpe?g|webp)$" },
          "imageAlt": { "type": "string", "minLength": 1, "maxLength": 140 },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 30 },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 500 }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "target"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 30 },
              "target": { "enum": ["settings-general", "settings-models", "settings-connections", "settings-skills", "settings-house-rules", "settings-backups", "check-for-updates"] }
            }
          },
          "appVersions": { "type": "string", "maxLength": 100 },
          "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["mac", "windows", "linux"] } },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" }
        },
        "dependentRequired": { "image": ["imageAlt"] },
        "not": { "required": ["link", "action"] }
      }
    }
  }
}
