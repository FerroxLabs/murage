<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>hi</string>
		<string>ja</string>
		<string>pt-BR</string>
		<string>zh</string>
	</array>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Murage</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MurageAppGroup</key><string>group.com.murage.mobile</string>
	<key>MurageAskKeychainGroup</key><string>$(AppIdentifierPrefix)com.murage.mobile.ask</string>
	<key>MurageKeychainGroup</key><string>$(AppIdentifierPrefix)com.murage.mobile.shared</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
    <string>Your bots can add events to your calendar when you ask them to.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
    <string>Your bots can check your calendar and add events when you ask them to.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Your bots can read and add reminders when you ask them to.</string>
    <key>NSContactsUsageDescription</key>
    <string>Your bots can look up a person you name, to start a text or a call for you.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your bots can see roughly where you are when you ask for something nearby.</string>
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict><key>PhonePreciseLocation</key><string>Your bots can use your precise location when you turn on Precise location.</string></dict>
    <key>NSAlarmKitUsageDescription</key>
    <string>Your bots can set alarms and timers when you ask them to.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing code from Murage on your computer, and use the camera in a chat when you choose to.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Murage uses Face ID to confirm that you approve an action on your computer.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to your team and send voice messages when you choose to.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Murage saves photos and videos you choose to your library.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>desktopcomputer</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Switch computer</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.murage.mobile.switch</string>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tailscale</string>
        <string>tel</string>
	</array>
	<key>AppAttestEnvironment</key>
	<string>$(APP_ATTEST_ENVIRONMENT)</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
