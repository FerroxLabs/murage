{
  "manifest_version": 3,
  "incognito": "not_allowed",
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "minimum_chrome_version": "151",
  "description": "__MSG_extDescription__",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "idle",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "sidePanel",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "pause": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdPauseDescription__"
    }
  },
  "action": {
    "default_title": "Murage browser controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
