<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>witness-collector</AssemblyName>
    <PublishAot>true</PublishAot>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.selfcheck.cs;adapters/fixtures/**" />
    <EmbeddedResource Remove="adapters/fixtures/**" />
    <None Remove="adapters/fixtures/**" />
    <Compile Include="../boundary/SigningProcess.cs" Link="SigningProcess.cs" />
    <Compile Include="../boundary/WindowsSigningProcessApi.cs" Link="WindowsSigningProcessApi.cs" />
    <EmbeddedResource Include="../../../scripts/windows-signing-witness/plan.json" LogicalName="witness-plan.json" />
  </ItemGroup>
</Project>
