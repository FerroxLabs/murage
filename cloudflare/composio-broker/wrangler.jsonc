{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "murage-composio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "COMPOSIO_API_BASE": "https://backend.composio.dev/api/v3.1",
    "COMPOSIO_TOOLKIT_BASE": "https://backend.composio.dev/api/v3",
    // These vars are the state the live Worker runs after FluxRouter rollout
    // step 8, so a plain `pnpm broker:deploy` from this tree reproduces it
    // instead of silently reverting a `--var` override. Change them only
    // together with the rollout (FLUX-COMPOSIO-BROKER-DESIGN.md §8.3, §8.4).
    // src/wrangler-config.test.ts fails if CLAIM_MODE or REGISTRATION_MODE
    // drifts back.
    //
    // Rollout step 8 (the same day as the 0.1.52 release, which moves the
    // desktop to FluxRouter): "closed" stops issuing new installation tokens;
    // existing installs keep working. Deploying this tree IS step 8. Roll back
    // with `--var REGISTRATION_MODE:open` only if the desktop release is
    // pulled and new installs must register here again.
    "REGISTRATION_MODE": "closed",
    // On at FluxRouter parity (2000 tool executions per install per UTC day).
    // It was left "off" for the pre-migration population; every install that
    // has not moved is still billed entirely to the shared Ferrox Composio
    // key, so the fuse is back on to cap one runaway install's blast radius.
    // Only JSON-RPC `tools/call` counts (billableCallCount) — `initialize`
    // and `tools/list` are free — and the panel routes are not charged at
    // all, so connecting an app is never refused by this. Over the ceiling
    // the install gets 429 `daily_call_ceiling`, which the desktop's
    // connector bridge renders as a normal failed tool call carrying the
    // Worker's own sentence (server/connector-proxy.ts). Set to "off" or "0"
    // to disable the fuse again.
    "DAILY_CALL_CEILING": "2000",
    // Claims: "open" lets a desktop ask this Worker to sign an assertion.
    // Opened at rollout step 5 (live Worker fa297f66 since 2026-09-11; Flux
    // claims on at step 6). Roll back per §8.4 "Claims paused": deploy with
    // `--var CLAIM_MODE:closed` (unredeemed assertions expire in 5 minutes);
    // if claims stay paused longer than 7 days also `--var MIGRATION_GATE:off`.
    "CLAIM_MODE": "open",
    // "on" retires an install once FluxRouter has confirmed it (rollout step
    // 5). "off" is the FluxRouter-rollback switch: every install with a token
    // is served again, claimed or not, on the token the desktop deliberately
    // kept. Flux broker dark (§8.4) needs `--var MIGRATION_GATE:off` in the
    // same step.
    "MIGRATION_GATE": "on",
    // How long a confirmed install keeps working here after confirmation.
    "CLAIM_GRACE_SECONDS": "900",
    // Backstop for an install that redeemed at FluxRouter and never confirmed.
    "CLAIM_ISSUED_FALLBACK_SECONDS": "604800",
    // ISO-8601 instants; "" means no cut-off. An unparseable value is treated
    // as unset, never as "now" (configuredInstant), so a typo cannot retire
    // the fleet. Claims stay open past the cut-off.
    //
    // Rollout step 9 (the cut-off). This is the same instant as the desktop's
    // COMPOSIO_LEGACY_BROKER_UNTIL in electron/composio-release-config.mjs,
    // already shipped in 0.1.52/0.1.53/0.1.54 — those builds stop *asking*
    // this Worker at that moment, and from it the Worker also stops answering
    // data calls, so a client that ignores its own constant is refused too.
    // Until then nothing changes: migrationGate only fires at now >= this.
    // After it, every data call gets 410 `legacy_broker_retired`.
    "LEGACY_BROKER_UNTIL": "2026-11-10T00:00:00Z",
    // Deliberately still "": claims are the migration path off this Worker,
    // and they are worth accepting after the cut-off, not before it. Set this
    // to cut-off + 90 days only when the Worker is about to be deleted.
    "CLAIM_UNTIL": ""
  },
  "secrets": { "required": ["COMPOSIO_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "murage-composio",
      "database_id": "7386c046-7c54-4301-b5e0-584dd9306a8e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "8261701", "simple": { "limit": 30, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "8261702", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
