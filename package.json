{
  "name": "murage",
  "private": true,
  "version": "1.0.1",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/FerroxLabs/murage",
  "repository": {
    "type": "git",
    "url": "https://github.com/FerroxLabs/murage.git"
  },
  "author": {
    "name": "Ferrox Labs",
    "email": "sean@ferroxlabs.com"
  },
  "license": "AGPL-3.0-or-later",
  "desktopName": "com.murage.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint .",
    "flux-stream:fixtures": "bash tools/flux-stream-conformance/fixtures/gen.sh",
    "flux-stream:conformance": "node --experimental-strip-types tools/flux-stream-conformance/launch.ts run",
    "flux-stream:conformance:full": "FLUX_CONFORMANCE_FULL=1 vitest run tools/flux-stream-conformance/conformance.test.ts",
    "flux-stream:conformance:pack": "node --experimental-strip-types tools/flux-stream-conformance/pack.ts",
    "flux-stream:owner-replay": "node --experimental-strip-types tools/flux-stream-conformance/launch.ts owner-replay",
    "flux-stream:sim": "node --experimental-strip-types tools/flux-stream-sim/server.ts",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "docs:dev": "pnpm --filter @murage/docs dev",
    "docs:build": "pnpm --filter @murage/docs build",
    "docs:preview": "pnpm --filter @murage/docs preview",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "dev:server": "node scripts/dev-server.mjs",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:murage": "node --experimental-strip-types scripts/control-murage.ts",
    "installation:murage": "node --experimental-strip-types scripts/installation-recovery.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tools/flux-stream-conformance/tsconfig.json",
    "test": "pnpm catalog:check && pnpm models:check && pnpm check:contrast && vitest run && pnpm broker:test && pnpm test:electron && pnpm test:packaged-server",
    "test:electron": "node --import ./server/testing/safe-wipe-preload.mjs --test \"electron/*.node-test.mjs\"",
    "test:browser-extension-node": "node scripts/run-extension-node-tests.mjs",
    "test:browser-extension-scripts": "node --test scripts/prepare-browser-extension.node-test.mjs scripts/browser-extension-build.node-test.mjs scripts/browser-extension-host-registration.node-test.mjs scripts/browser-extension-fixture-site/browser-extension-fixture-site.node-test.mjs",
    "test:human": "playwright test src/e2e/*.human.spec.ts",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "smoke:whatsapp-packaged": "node scripts/smoke-whatsapp-packaged.mjs",
    "check:whatsapp-inventory": "node scripts/whatsapp-inventory.mjs dist-server --check",
    "check:electron": "node scripts/check-electron.mjs",
    "catalog:build": "node --experimental-strip-types scripts/build-local-catalog.mjs",
    "catalog:check": "node --experimental-strip-types scripts/build-local-catalog.mjs --check",
    "catalog:vendor": "node --experimental-strip-types scripts/vendor-team-packages.mjs",
    "models:build": "node scripts/build-model-metadata.mjs",
    "models:check": "node scripts/build-model-metadata.mjs --check",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p tsconfig.companion.build.json",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:notification-authorization": "node scripts/build-notification-authorization.mjs",
    "build:recorder": "node electron/build-recorder-helper.mjs",
    "build:recovery": "node scripts/build-recovery-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:fuigo": "node scripts/prepare-fuigo.mjs",
    "build:fuigo-probe": "node scripts/build-fuigo-probe.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "build:browser-extension": "node scripts/prepare-browser-extension.mjs --mode development",
    "build:browser-extension-windows": "node scripts/build-browser-extension-windows.mjs",
    "prepare:browser-extension": "node scripts/prepare-browser-extension.mjs",
    "build:browser-snapshot": "node scripts/build-browser-snapshot.mjs",
    "package:prepare": "node scripts/prepare-backup-age.mjs && node scripts/prepare-backup-restic.mjs && pnpm build && pnpm build:server && pnpm build:companion && pnpm build:updater && pnpm build:android-tools && pnpm build:cloudflared && pnpm build:fuigo && pnpm build:browser && pnpm prepare:browser-extension",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:recorder && pnpm build:notification-authorization && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm prepare:backup-windows && pnpm package:prepare && pnpm build:recovery && pnpm build:browser-extension-windows && pnpm build:fuigo-probe && pnpm build:backup-helper && electron-builder --win --publish never",
    "prepare:backup-windows": "node scripts/prepare-windows-backup-tools.mjs",
    "build:backup-helper": "node scripts/build-backup-helper.mjs",
    "prepare:backup-age:linux": "node scripts/prepare-backup-age.mjs --target=linux-x64",
    "package:linux": "pnpm prepare:backup-age:linux && pnpm package:prepare && pnpm build:cua:linux && pnpm build:fuigo-probe && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm prepare:backup-age:linux && pnpm package:prepare && pnpm build:cua:linux:offline && pnpm build:fuigo-probe && electron-builder --linux --x64 --publish never",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-update": "xvfb-run -a electron --no-sandbox scripts/smoke-linux-update.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm prepare:backup-age:linux && pnpm package:prepare && pnpm build:cua:linux && pnpm build:fuigo-probe && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs && node scripts/smoke-installation-recovery.mjs",
    "test:desktop-recovery": "pnpm build:server && node scripts/test-desktop-recovery.mjs",
    "broker:types": "wrangler types --config cloudflare/composio-broker/wrangler.jsonc cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config cloudflare/composio-broker/wrangler.jsonc",
    "control-plane:types": "pnpm --filter @murage/control-plane types",
    "control-plane:check": "pnpm --filter @murage/control-plane check",
    "control-plane:test": "pnpm --filter @murage/control-plane test",
    "control-plane:dry-run": "pnpm --filter @murage/control-plane dry-run"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-drag-handle": "3.31.3",
    "@tiptap/extension-drag-handle-react": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-node-range": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@trycua/cua-driver": "0.28.2",
    "baileys": "7.0.0-rc14",
    "clsx": "^2.1.1",
    "discord.js": "14.27.0",
    "dompurify": "3.4.13",
    "jimp": "1.6.1",
    "katex": "0.18.7",
    "lucide-react": "^0.539.0",
    "mermaid": "12.0.0",
    "onnxruntime-web": "1.24.3",
    "parse5": "8.0.1",
    "posthog-js": "^1.415.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "undici": "7.25.0",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.13.0",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
