+// Modified by Ferrox Labs: one launch-bound close transaction for every caller.
+use super::*;
+
+#[derive(Clone, Debug)]
+pub struct Expected {
+    pub session: String,
+    pub launch_id: Option<String>,
+    pub daemon: Option<ProcId>,
+    pub dir: PathBuf,
+    pub endpoint: PathBuf,
+    pub port: Option<u16>,
+    pub token: Option<String>,
+    pub sid: Option<i32>,
+    pub observation: Option<PathBuf>,
+    pub job_name: String,
+    pub owner: Option<Value>,
+}
+#[derive(Debug)]
+pub struct CloseError {
+    pub code: String,
+    pub save_status: String,
+}
+impl From<&str> for CloseError {
+    fn from(code: &str) -> Self {
+        Self {
+            code: code.into(),
+            save_status: "lost".into(),
+        }
+    }
+}
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Closed {
+    pub launch_id: Option<String>,
+    pub closed: bool,
+    pub path: String,
+    pub save_status: String,
+    pub group_exhausted: bool,
+    pub tree_exhausted: bool,
+    pub outside_seen: usize,
+    pub unconfirmed: Option<String>,
+}
+#[derive(Default)]
+pub struct Census {
+    pub members: usize,
+    pub outside: usize,
+}
+pub trait CloseIo {
+    fn windows(&self) -> bool {
+        cfg!(windows)
+    }
+    fn linux(&self) -> bool {
+        cfg!(target_os = "linux")
+    }
+    fn now(&self) -> Instant {
+        Instant::now()
+    }
+    fn pause(&self) {
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    fn read_owner(&self, path: &Path) -> Result<Option<Value>, CloseError>;
+    fn identity(&self, pid: u32) -> Result<Option<ProcId>, CloseError>;
+    fn send_close_only(&self, expected: &Expected, deadline: Instant) -> Result<Value, CloseError>;
+    fn send_stop(&self, expected: &Expected, deadline: Instant) -> Result<Value, CloseError>;
+    fn census(&self, expected: &Expected, deadline: Instant) -> Result<Census, CloseError>;
+    fn open_job(&self, name: &str) -> Result<Option<usize>, CloseError>;
+    fn terminate_job(&self, job: usize) -> Result<(), CloseError>;
+    fn active_processes(&self, job: usize) -> Result<u32, CloseError>;
+    fn release_job(&self, job: usize);
+    fn signal_adapter(&self) -> bool {
+        false
+    }
+}
+fn same(a: &ProcId, b: &ProcId) -> bool {
+    a.pid == b.pid && a.start == b.start && a.exe == b.exe
+}
+fn owner_path(e: &Expected) -> PathBuf {
+    e.dir.join(format!("{}.owner.json", e.session))
+}
+impl Expected {
+    /// Exactly one evidence read. Inputs from arguments/environment are authoritative.
+    pub fn resolve(
+        session: &str,
+        supplied: Option<&str>,
+        env_id: Option<&str>,
+        dir: PathBuf,
+        exe: &str,
+        io: &dyn CloseIo,
+    ) -> Result<Self, CloseError> {
+        if !crate::validation::is_valid_session_name(session) {
+            return Err("usage".into());
+        }
+        if supplied.zip(env_id).is_some_and(|(a, b)| a != b) {
+            return Err("launch_mismatch".into());
+        }
+        let authority = supplied.or(env_id);
+        if authority.is_some_and(|id| validate_launch_id(id).is_err()) {
+            return Err("ownership_unproven".into());
+        }
+        let owner = io.read_owner(&dir.join(format!("{session}.owner.json")))?;
+        let mut e = Self {
+            session: session.into(),
+            launch_id: authority.map(str::to_owned),
+            daemon: None,
+            endpoint: dir.join(format!("{session}.sock")),
+            dir,
+            port: None,
+            token: None,
+            sid: None,
+            observation: None,
+            job_name: String::new(),
+            owner: owner.clone(),
+        };
+        let Some(owner) = owner else {
+            if authority.is_some() {
+                return Err("ownership_unproven".into());
+            }
+            // L1 can observe a recorded identity, but can never signal it.
+            if let Ok(pid) = fs::read_to_string(e.dir.join(format!("{session}.pid"))) {
+                let pid = pid
+                    .trim()
+                    .parse()
+                    .map_err(|_| CloseError::from("ownership_unproven"))?;
+                e.daemon = io.identity(pid)?;
+            }
+            return Ok(e);
+        };
+        if authority.is_some() && owner["launchId"].as_str() != authority {
+            return Err("launch_mismatch".into());
+        }
+        let id = match owner.get("launchId") {
+            Some(Value::Null) => None,
+            Some(Value::String(id)) if validate_launch_id(id).is_ok() => Some(id.clone()),
+            _ => return Err("ownership_unproven".into()),
+        };
+        let daemon: ProcId = serde_json::from_value(owner["daemon"].clone())
+            .map_err(|_| CloseError::from("ownership_unproven"))?;
+        if owner["v"] != 1
+            || owner["session"] != session
+            || daemon.pid == 0
+            || daemon.start.is_empty()
+            || daemon.exe.is_empty()
+        {
+            return Err("ownership_unproven".into());
+        }
+        if daemon.exe != exe {
+            return Err("engine_mismatch".into());
+        }
+        e.launch_id = id;
+        e.job_name = format!(
+            "Local\\agent-browser-{}",
+            e.launch_id
+                .clone()
+                .unwrap_or_else(|| format!("{session}-{}", daemon.pid))
+        );
+        if io.windows() {
+            if owner["group"]["kind"] != "job" || owner["group"]["name"] != e.job_name {
+                return Err("ownership_unproven".into());
+            }
+        } else {
+            if owner["group"]["kind"] != "sid"
+                || owner["group"]["id"].as_u64() != Some(daemon.pid as u64)
+                || daemon.pid > i32::MAX as u32
+            {
+                return Err("ownership_unproven".into());
+            }
+            e.sid = Some(daemon.pid as i32);
+            e.observation = owner["observationDir"].as_str().map(PathBuf::from);
+            if e.observation.as_ref().is_some_and(|p| !p.is_absolute()) {
+                return Err("ownership_unproven".into());
+            }
+        }
+        e.daemon = Some(daemon);
+        Ok(e)
+    }
+}
+fn corroborate(e: &Expected, io: &dyn CloseIo) -> Result<(), CloseError> {
+    if let Some(owner) = io.read_owner(&owner_path(e))? {
+        let before = e
+            .owner
+            .as_ref()
+            .ok_or_else(|| CloseError::from("launch_mismatch"))?;
+        for key in [
+            "v",
+            "session",
+            "launchId",
+            "daemon",
+            "group",
+            "observationDir",
+        ] {
+            if owner.get(key) != before.get(key) {
+                return Err("launch_mismatch".into());
+            }
+        }
+    }
+    Ok(())
+}
+fn alive(e: &Expected, io: &dyn CloseIo) -> Result<bool, CloseError> {
+    match &e.daemon {
+        Some(expected) => Ok(io
+            .identity(expected.pid)?
+            .is_some_and(|actual| same(&actual, expected))),
+        None => Ok(false),
+    }
+}
+fn proof(e: &Expected, io: &dyn CloseIo, value: &Value) -> Result<bool, CloseError> {
+    if value["error"] == "launch_mismatch" {
+        return Err("launch_mismatch".into());
+    }
+    if value.get("launchId").is_some() && value["launchId"] != json!(e.launch_id) {
+        return Err("launch_mismatch".into());
+    }
+    Ok(value.get("launchId").is_some()
+        && value["groupExhausted"] == true
+        && value["outsideSeen"] == 0
+        && value.get("unconfirmed") == Some(&Value::Null)
+        && (!io.linux() || e.launch_id.is_none() || value["treeExhausted"] == true))
+}
+fn closed(e: &Expected, path: &str, save: &str, tree: bool) -> Closed {
+    Closed {
+        launch_id: e.launch_id.clone(),
+        closed: true,
+        path: path.into(),
+        save_status: save.into(),
+        group_exhausted: true,
+        tree_exhausted: tree,
+        outside_seen: 0,
+        unconfirmed: None,
+    }
+}
+fn gone(e: &Expected, io: &dyn CloseIo, deadline: Instant) -> Result<Closed, CloseError> {
+    let census = io.census(e, deadline)?;
+    if census.members != 0 || census.outside != 0 {
+        return Err("orphans_remain".into());
+    }
+    // An empty observational scan cannot prove detached descendants disappeared.
+    Err("ownership_unproven".into())
+}
+fn job(e: &Expected, io: &dyn CloseIo, force: bool, deadline: Instant) -> Result<bool, CloseError> {
+    if io.now() >= deadline {
+        return Err("tree_lingering".into());
+    }
+    corroborate(e, io)?;
+    if io.now() >= deadline {
+        return Err("tree_lingering".into());
+    }
+    let Some(handle) = io.open_job(&e.job_name)? else {
+        return Ok(false);
+    };
+    let result = (|| {
+        if io.now() >= deadline {
+            return Err("tree_lingering".into());
+        }
+        if force {
+            io.terminate_job(handle)?;
+        }
+        loop {
+            if io.now() >= deadline {
+                return Err("tree_lingering".into());
+            }
+            if io.active_processes(handle)? == 0 {
+                return Ok(true);
+            }
+            io.pause();
+        }
+    })();
+    io.release_job(handle);
+    result
+}
+/// S0 has already frozen authority and every observation/transport input in Expected.
+/// No caller can skip the graceful save attempt and reach a force primitive.
+pub fn close_session(e: &Expected, io: &dyn CloseIo) -> Result<Closed, CloseError> {
+    let start = io.now();
+    let total = start + Duration::from_secs(40);
+    let mut save = "lost".to_string();
+    let result = (|| {
+        if e.owner.is_none() {
+            if e.launch_id.is_some() {
+                return Err("ownership_unproven".into());
+            }
+            return match io.send_close_only(e, start + Duration::from_secs(20)) {
+                Ok(reply) if reply["success"] == true => Ok(closed(e, "graceful", "lost", false)),
+                Err(error) if error.code == "not_running" && !alive(e, io)? => {
+                    Ok(closed(e, "not_running", "no_browser", false))
+                }
+                _ => Err("daemon_unresponsive".into()),
+            };
+        }
+        if !io.windows() && !alive(e, io)? {
+            return gone(e, io, total);
+        }
+        corroborate(e, io)?;
+        let grace_end = start + Duration::from_secs(if io.signal_adapter() { 5 } else { 20 });
+        let response = io.send_close_only(e, grace_end);
+        let mut graceful = false;
+        let mut tree = false;
+        match response {
+            Err(error) if error.code == "launch_mismatch" => return Err(error),
+            Ok(reply) => {
+                if reply["error"] == "launch_mismatch" {
+                    return Err("launch_mismatch".into());
+                }
+                let data = reply.get("data").unwrap_or(&reply);
+                if let Some(status) = data["saveStatus"].as_str() {
+                    save = match status {
+                        "saved" => "saved",
+                        "never" | "disabled" => "never",
+                        "no_browser" => "no_browser",
+                        _ => "failed",
+                    }
+                    .into();
+                }
+                let exhausted = proof(e, io, data)?;
+                graceful = reply["success"] == true && data["closed"] == true && exhausted;
+                tree = data["treeExhausted"] == true;
+            }
+            _ => {}
+        }
+        if !graceful {
+            let force_end =
+                (io.now() + Duration::from_secs(15)).min(total - Duration::from_secs(5));
+            if io.now() >= force_end {
+                return Err("tree_lingering".into());
+            }
+            if io.windows() && !io.signal_adapter() {
+                let exists = job(e, io, true, force_end)?;
+                return Ok(closed(
+                    e,
+                    if exists { "forced" } else { "job_gone" },
+                    if exists { &save } else { "lost" },
+                    true,
+                ));
+            }
+            corroborate(e, io)?;
+            if !alive(e, io)? {
+                return gone(e, io, force_end);
+            }
+            if io.now() >= force_end {
+                return Err("tree_lingering".into());
+            }
+            let reply = io.send_stop(e, force_end)?;
+            if !proof(e, io, &reply)? {
+                return Err(reply["unconfirmed"]
+                    .as_str()
+                    .unwrap_or("tree_lingering")
+                    .into());
+            }
+            tree = reply["treeExhausted"] == true;
+        }
+        // The signal adapter is executing inside the daemon: its caller retires
+        // this process immediately after the successful held-child proof.
+        if io.signal_adapter() {
+            return Ok(closed(
+                e,
+                if graceful { "graceful" } else { "forced" },
+                &save,
+                tree,
+            ));
+        }
+        let confirm_end = (io.now() + Duration::from_secs(5)).min(total);
+        if io.windows() {
+            job(e, io, false, confirm_end)?;
+        } else {
+            let mut retirement_sent = false;
+            while alive(e, io)? {
+                if io.now() >= confirm_end {
+                    return Err("tree_lingering".into());
+                }
+                if !retirement_sent && io.now() + Duration::from_secs(4) >= confirm_end {
+                    corroborate(e, io)?;
+                    let reply = io.send_stop(e, confirm_end)?;
+                    if !proof(e, io, &reply)? {
+                        return Err("tree_lingering".into());
+                    }
+                    retirement_sent = true;
+                }
+                io.pause();
+            }
+            loop {
+                if io.now() >= confirm_end {
+                    return Err("tree_lingering".into());
+                }
+                let census = io.census(e, confirm_end)?;
+                if io.now() >= confirm_end {
+                    return Err("tree_lingering".into());
+                }
+                if census.members == 0 && census.outside == 0 {
+                    break;
+                }
+                io.pause();
+            }
+        }
+        Ok(closed(
+            e,
+            if graceful { "graceful" } else { "forced" },
+            &save,
+            tree,
+        ))
+    })();
+    result.map_err(|mut error: CloseError| {
+        error.save_status = save;
+        error
+    })
+}
+
+pub struct RealCloseIo {
+    pub signal: bool,
+    runtime: Option<(
+        tokio::runtime::Handle,
+        Arc<tokio::sync::Mutex<super::super::actions::DaemonState>>,
+    )>,
+}
+impl CloseIo for RealCloseIo {
+    fn signal_adapter(&self) -> bool {
+        self.signal
+    }
+    fn read_owner(&self, path: &Path) -> Result<Option<Value>, CloseError> {
+        match fs::read(path) {
+            Ok(bytes) => serde_json::from_slice(&bytes)
+                .map(Some)
+                .map_err(|_| "ownership_unproven".into()),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(_) => Err("ownership_unproven".into()),
+        }
+    }
+    fn identity(&self, pid: u32) -> Result<Option<ProcId>, CloseError> {
+        match super::identity(pid) {
+            Ok(id) => Ok(Some(id)),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(_) => Err("census_unavailable".into()),
+        }
+    }
+    fn send_close_only(&self, e: &Expected, deadline: Instant) -> Result<Value, CloseError> {
+        if let Some((runtime, state)) = &self.runtime {
+            let state = state.clone();
+            let launch = e.launch_id.clone();
+            let (tx, rx) = std::sync::mpsc::sync_channel(1);
+            let task = runtime.spawn(async move {
+                let command = json!({"id":"signal-close","action":"close","closeOnly":true,"launchId":launch,"requireSaved":false});
+                let mut state = state.lock().await;
+                let reply = super::super::actions::execute_command(&command, &mut state).await;
+                let _ = tx.send(reply);
+            });
+            let result = rx.recv_timeout(deadline.saturating_duration_since(Instant::now()));
+            if result.is_err() {
+                task.abort();
+            }
+            return result.map_err(|_| "daemon_unresponsive".into());
+        }
+        crate::connection::send_close_pinned(e, deadline).map_err(|error| {
+            if error == "endpoint_missing" {
+                "not_running".into()
+            } else {
+                "daemon_unresponsive".into()
+            }
+        })
+    }
+    fn send_stop(&self, e: &Expected, deadline: Instant) -> Result<Value, CloseError> {
+        if self.signal {
+            return serde_json::to_value(super::stop()).map_err(|_| "ownership_unproven".into());
+        }
+        #[cfg(unix)]
+        {
+            use crate::native::control_token as ct;
+            use std::io::BufReader;
+            let mut socket = crate::connection::Connection::Unix(
+                crate::connection::connect_unix_by(
+                    &e.dir.join(format!("{}.stop", e.session)),
+                    deadline,
+                )
+                .map_err(|_| CloseError::from("daemon_unresponsive"))?,
+            );
+            let budget = deadline
+                .checked_duration_since(Instant::now())
+                .ok_or_else(|| CloseError::from("tree_lingering"))?;
+            let end = ct::Deadline::after(budget);
+            ct::write_all_by(
+                &mut socket,
+                format!("{}\n", json!({"launchId":e.launch_id})).as_bytes(),
+                end,
+            )
+            .map_err(|_| CloseError::from("tree_lingering"))?;
+            let line = ct::read_line_by_blocking(
+                &mut BufReader::new(socket),
+                65536,
+                ct::Grammar::LineOrEof,
+                end,
+            )
+            .map_err(|_| CloseError::from("tree_lingering"))?;
+            serde_json::from_slice(&line).map_err(|_| "tree_lingering".into())
+        }
+        #[cfg(windows)]
+        {
+            let _ = (e, deadline);
+            Err("ownership_unproven".into())
+        }
+    }
+    fn census(&self, e: &Expected, deadline: Instant) -> Result<Census, CloseError> {
+        let observation = e
+            .observation
+            .as_deref()
+            .ok_or_else(|| CloseError::from("census_unavailable"))?;
+        let sid = e
+            .sid
+            .ok_or_else(|| CloseError::from("census_unavailable"))?;
+        let mut members = 0;
+        #[cfg(target_os = "linux")]
+        for entry in fs::read_dir("/proc").map_err(|_| CloseError::from("census_unavailable"))? {
+            if Instant::now() >= deadline {
+                return Err("tree_lingering".into());
+            }
+            let entry = entry.map_err(|_| CloseError::from("census_unavailable"))?;
+            let Ok(pid) = entry.file_name().to_string_lossy().parse::<u32>() else {
+                continue;
+            };
+            match super::proc_stat(pid) {
+                Ok(stat) if stat.session == sid && stat.state != 'Z' => members += 1,
+                Ok(_) => {}
+                Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+                Err(_) => return Err("census_unavailable".into()),
+            }
+        }
+        #[cfg(target_os = "macos")]
+        {
+            members = super::macos::status(sid)
+                .map_err(|_| CloseError::from("census_unavailable"))?
+                .len();
+        }
+        #[cfg(unix)]
+        let outside = super::observe_outside_by(Some(observation), deadline)
+            .map_err(|_| CloseError::from("census_unavailable"))?;
+        #[cfg(windows)]
+        let outside = {
+            let _ = (observation, sid, deadline);
+            0
+        };
+        Ok(Census { members, outside })
+    }
+    fn open_job(&self, name: &str) -> Result<Option<usize>, CloseError> {
+        #[cfg(windows)]
+        {
+            return super::windows::open_close_job(name).map_err(|_| "census_unavailable".into());
+        }
+        #[cfg(not(windows))]
+        {
+            let _ = name;
+            Err("ownership_unproven".into())
+        }
+    }
+    fn terminate_job(&self, job: usize) -> Result<(), CloseError> {
+        #[cfg(windows)]
+        {
+            return super::windows::terminate_close_job(job).map_err(|_| "tree_lingering".into());
+        }
+        #[cfg(not(windows))]
+        {
+            let _ = job;
+            Err("ownership_unproven".into())
+        }
+    }
+    fn active_processes(&self, job: usize) -> Result<u32, CloseError> {
+        #[cfg(windows)]
+        {
+            return super::windows::close_job_active(job).map_err(|_| "census_unavailable".into());
+        }
+        #[cfg(not(windows))]
+        {
+            let _ = job;
+            Err("ownership_unproven".into())
+        }
+    }
+    fn release_job(&self, job: usize) {
+        #[cfg(windows)]
+        super::windows::release_close_job(job);
+        #[cfg(not(windows))]
+        let _ = job;
+    }
+}
+pub fn close_existing(session: &str, supplied: Option<&str>) -> Result<Closed, CloseError> {
+    close_entry(session, supplied, false)
+}
+pub fn close_entry(
+    session: &str,
+    supplied: Option<&str>,
+    signal: bool,
+) -> Result<Closed, CloseError> {
+    let io = RealCloseIo {
+        signal,
+        runtime: None,
+    };
+    close_with_io(session, supplied, &io)
+}
+pub fn close_runtime_signal(
+    session: &str,
+    runtime: tokio::runtime::Handle,
+    state: Arc<tokio::sync::Mutex<super::super::actions::DaemonState>>,
+) -> Result<Closed, CloseError> {
+    let io = RealCloseIo {
+        signal: true,
+        runtime: Some((runtime, state)),
+    };
+    close_with_io(session, launch_id().as_deref(), &io)
+}
+fn close_with_io(
+    session: &str,
+    supplied: Option<&str>,
+    io: &RealCloseIo,
+) -> Result<Closed, CloseError> {
+    let exe = std::env::current_exe()
+        .and_then(fs::canonicalize)
+        .map_err(|_| CloseError::from("engine_mismatch"))?;
+    let dir = crate::connection::get_socket_dir();
+    let dir = match fs::canonicalize(&dir) {
+        Ok(dir) => dir,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => dir,
+        Err(_) => return Err("ownership_unproven".into()),
+    };
+    let mut e = Expected::resolve(
+        session,
+        supplied,
+        launch_id().as_deref(),
+        dir,
+        &exe.to_string_lossy(),
+        io,
+    )?;
+    #[cfg(windows)]
+    {
+        e.port = fs::read_to_string(e.dir.join(format!("{session}.port")))
+            .ok()
+            .and_then(|p| p.trim().parse().ok());
+        e.token = std::env::var("AGENT_BROWSER_CONTROL_TOKEN").ok();
+    }
+    close_session(&e, io)
+}
