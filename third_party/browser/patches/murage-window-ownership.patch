+#[cfg(windows)]
+fn validated_job_name(owner: &Value) -> Result<String, String> {
+    let session = owner["session"]
+        .as_str()
+        .filter(|s| crate::validation::is_valid_session_name(s))
+        .ok_or("invalid session")?;
+    let pid = owner["daemon"]["pid"]
+        .as_u64()
+        .filter(|p| *p > 0 && *p <= u32::MAX as u64)
+        .ok_or("invalid daemon")?;
+    let identity: ProcId =
+        serde_json::from_value(owner["daemon"].clone()).map_err(|_| "invalid daemon identity")?;
+    if identity.start.is_empty() || identity.exe.is_empty() || owner.get("launchId").is_none() {
+        return Err("invalid owner evidence".into());
+    }
+    let suffix = match &owner["launchId"] {
+        Value::Null => format!("{session}-{pid}"),
+        Value::String(id) => {
+            validate_launch_id(id).map_err(|e| e.to_string())?;
+            id.clone()
+        }
+        _ => return Err("invalid launch identity".into()),
+    };
+    let expected = format!("Local\\agent-browser-{suffix}");
+    if owner["v"] != 1 || owner["group"]["kind"] != "job" || owner["group"]["name"] != expected {
+        return Err("invalid job identity".into());
+    }
+    Ok(expected)
+}
