index 0000000..e6a4241
--- /dev/null
+++ b/cli/src/native/ownership/macos.rs
@@ -0,0 +1,210 @@
+// Modified by Ferrox Labs: macOS owns only the unreaped Chrome group.
+use super::*;
+
+fn info(pid: u32) -> io::Result<libc::proc_bsdinfo> {
+    let mut info: libc::proc_bsdinfo = unsafe { std::mem::zeroed() };
+    let size = std::mem::size_of_val(&info) as i32;
+    if unsafe {
+        libc::proc_pidinfo(
+            pid as i32,
+            libc::PROC_PIDTBSDINFO,
+            0,
+            &mut info as *mut _ as *mut _,
+            size,
+        )
+    } != size
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(info)
+}
+
+pub(super) fn identity(pid: u32) -> io::Result<ProcId> {
+    let info = info(pid)?;
+    let mut path = vec![0u8; 4096];
+    let count =
+        unsafe { libc::proc_pidpath(pid as i32, path.as_mut_ptr().cast(), path.len() as u32) };
+    if count <= 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let end = path.iter().position(|b| *b == 0).unwrap_or(count as usize);
+    let exe = fs::canonicalize(String::from_utf8_lossy(&path[..end]).as_ref())?;
+    Ok(ProcId {
+        pid,
+        start: format!("{}.{:06}", info.pbi_start_tvsec, info.pbi_start_tvusec),
+        exe: exe.to_string_lossy().into_owned(),
+    })
+}
+
+fn group_members(group: i32) -> io::Result<Vec<u32>> {
+    super::platform_contract::list_group(|pids, size| unsafe {
+        libc::proc_listpgrppids(group, pids.as_mut_ptr().cast(), size)
+    })
+}
+
+pub(super) fn stop(held: &mut HeldChild) -> Exhaustion {
+    let mut result = Exhaustion::pending("group_lingering");
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let chrome = held.child.id();
+    let group = held.pgid.unwrap();
+    // No per-pid signals, even for helpers that escaped through setsid.
+    if unsafe { libc::killpg(group, libc::SIGKILL) } != 0
+        && io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+    {
+        return result;
+    }
+    while Instant::now() < deadline {
+        let members = match group_members(group) {
+            Ok(members) => members,
+            Err(_) => return Exhaustion::pending("enumeration_failed"),
+        };
+        if members.iter().all(|pid| *pid == chrome) && exited_no_reap(chrome).unwrap_or(false) {
+            if held.child.wait().is_err() {
+                return result;
+            }
+            held.pgid = None;
+            result.group_exhausted = true;
+            let deadline = Instant::now() + Duration::from_secs(10);
+            loop {
+                match observe_outside(held.launch_dir.as_deref()) {
+                    Ok(count) => {
+                        result.outside_seen = count;
+                        result.unconfirmed = if count == 0 {
+                            None
+                        } else {
+                            Some("helper_lingering".into())
+                        };
+                        if count == 0 || Instant::now() >= deadline {
+                            break;
+                        }
+                    }
+                    Err(_) => {
+                        result.unconfirmed = Some("enumeration_failed".into());
+                        break;
+                    }
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            return result;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    result
+}
+
+fn all_pids() -> io::Result<Vec<u32>> {
+    super::platform_contract::list_all(|pids, size| unsafe {
+        libc::proc_listpids(libc::PROC_ALL_PIDS, 0, pids.as_mut_ptr().cast(), size)
+    })
+}
+
+pub(super) fn status(group: i32) -> io::Result<Vec<Value>> {
+    let mut members = Vec::new();
+    for pid in all_pids()? {
+        if unsafe { libc::getsid(pid as i32) } == group {
+            let proc = info(pid)?;
+            // SZOMB is 5 on Darwin; zombies have no executable path to query.
+            if proc.pbi_status == 5 {
+                continue;
+            }
+            let identity = identity(pid)?;
+            members.push(
+                json!({"pid":pid,"start":identity.start,"exe":identity.exe,"pgid":proc.pbi_pgid}),
+            );
+        }
+    }
+    Ok(members)
+}
+
+pub(super) fn outside(path: &Path) -> io::Result<usize> {
+    use std::os::unix::ffi::OsStrExt;
+    let needle = path.as_os_str().as_bytes();
+    if needle.is_empty() {
+        return Err(io::Error::other("missing launch directory"));
+    }
+    let mut count = 0;
+    for pid in all_pids()? {
+        if pid == std::process::id() {
+            continue;
+        }
+        let proc = match info(pid) {
+            Ok(proc) => proc,
+            Err(e) if e.raw_os_error() == Some(libc::ESRCH) => continue,
+            Err(e) => return Err(e),
+        };
+        if proc.pbi_status == 5 {
+            continue;
+        }
+        let mut mib = [libc::CTL_KERN, libc::KERN_PROCARGS2, pid as i32];
+        let mut size = 0usize;
+        if unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                std::ptr::null_mut(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        } != 0
+        {
+            let error = io::Error::last_os_error();
+            if error.raw_os_error() == Some(libc::ESRCH) {
+                continue;
+            }
+            // An unreadable argv is not evidence that a helper is absent.
+            return Err(error);
+        }
+        if size > 16 * 1024 * 1024 || size < 4 {
+            return Err(io::Error::other("argument listing limit"));
+        }
+        let mut bytes = vec![0u8; size];
+        if unsafe {
+            libc::sysctl(
+                mib.as_mut_ptr(),
+                3,
+                bytes.as_mut_ptr().cast(),
+                &mut size,
+                std::ptr::null_mut(),
+                0,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        bytes.truncate(size);
+        let argc = i32::from_ne_bytes(bytes[..4].try_into().unwrap());
+        if argc < 0 {
+            return Err(io::Error::other("invalid argument count"));
+        }
+        // Skip the executable path and its padding; inspect argv, never environment.
+        let mut offset = 4 + bytes[4..]
+            .iter()
+            .position(|b| *b == 0)
+            .ok_or_else(|| io::Error::other("invalid process args"))?;
+        while offset < bytes.len() && bytes[offset] == 0 {
+            offset += 1;
+        }
+        let mut found = false;
+        for _ in 0..argc {
+            if offset >= bytes.len() {
+                return Err(io::Error::other("truncated process args"));
+            }
+            let length = bytes[offset..]
+                .iter()
+                .position(|b| *b == 0)
+                .ok_or_else(|| io::Error::other("truncated argument"))?;
+            if bytes[offset..offset + length]
+                .windows(needle.len())
+                .any(|value| value == needle)
+            {
+                found = true;
+            }
+            offset += length + 1;
+        }
+        if found {
+            count += 1;
+        }
+    }
+    Ok(count)
+}
diff --git a/cli/src/native/ownership/platform_contract.rs b/cli/src/native/ownership/platform_contract.rs
new file mode 100644
