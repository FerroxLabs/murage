+#[cfg(unix)]
+fn observe_outside(path: Option<&Path>) -> io::Result<usize> {
+    let Some(path) = path else {
+        return Ok(0);
+    };
+    #[cfg(target_os = "macos")]
+    {
+        return macos::outside(path);
+    }
+    #[cfg(target_os = "linux")]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        let needle = path.as_os_str().as_bytes();
+        if needle.is_empty() {
+            return Err(io::Error::other("missing launch directory"));
+        }
+        let mut count = 0;
+        for entry in fs::read_dir("/proc")? {
+            let entry = entry?;
+            let Ok(pid) = entry.file_name().to_string_lossy().parse::<u32>() else {
+                continue;
+            };
+            if pid == std::process::id() {
+                continue;
+            }
+            let stat = match proc_stat(pid) {
+                Ok(stat) => stat,
+                Err(e) if e.kind() == io::ErrorKind::NotFound => continue,
+                Err(e) => return Err(e),
+            };
+            if stat.state == 'Z' {
+                continue;
+            }
+            match fs::read(entry.path().join("cmdline")) {
+                Ok(args) if args.windows(needle.len()).any(|bytes| bytes == needle) => count += 1,
+                Ok(_) => {}
+                Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+                Err(e) => return Err(e),
+            }
+        }
+        Ok(count)
+    }
+}
