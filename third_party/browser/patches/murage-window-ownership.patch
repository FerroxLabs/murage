+        let target = dir.path().join("owner.json");
+        let pause = dir.path().join("before-rename");
+        fs::write(&target, b"{\"v\":1}").unwrap();
+        let mut child = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "native::ownership::publication_tests::ownership_e3_writer_fixture",
+                "--ignored",
