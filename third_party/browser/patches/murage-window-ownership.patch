+/// Only an existing authenticated/local endpoint is used; never launch configuration.
+pub fn stop_existing(session: &str) -> Result<(), String> {
+    let dir = crate::connection::get_socket_dir();
+    let owner: Value = serde_json::from_slice(
+        &fs::read(dir.join(format!("{session}.owner.json"))).map_err(|_| "daemon_unresponsive")?,
+    )
+    .map_err(|_| "daemon_unresponsive")?;
+    #[cfg(windows)]
+    return windows::stop_existing(&owner);
+    let expected: ProcId =
+        serde_json::from_value(owner["daemon"].clone()).map_err(|_| "daemon_unresponsive")?;
+    match identity(expected.pid) {
+        Ok(actual) if actual.start == expected.start && actual.exe == expected.exe => {}
+        Ok(_) => return Ok(()), // reused identity is observationally gone; never signal it
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(_) => return Err("daemon_unresponsive".into()),
+    }
+    #[cfg(unix)]
+    {
+        use std::io::{BufRead, BufReader, Read};
+        use std::os::unix::net::UnixStream;
+        let mut socket = UnixStream::connect(dir.join(format!("{session}.stop")))
+            .map_err(|_| "daemon_unresponsive")?;
+        socket
+            .set_read_timeout(Some(Duration::from_secs(15)))
+            .map_err(|e| e.to_string())?;
+        socket
+            .set_write_timeout(Some(Duration::from_secs(2)))
+            .map_err(|e| e.to_string())?;
+        writeln!(socket, "{}", json!({"launchId":owner["launchId"]})).map_err(|e| e.to_string())?;
+        let mut line = String::new();
+        BufReader::new(socket.take(65537))
+            .read_line(&mut line)
+            .map_err(|_| "daemon_unresponsive")?;
+        if line.len() > 65536 {
+            return Err("daemon_unresponsive".into());
+        }
+        let reply: Exhaustion = serde_json::from_str(&line).map_err(|_| "daemon_unresponsive")?;
+        if reply.launch_id.as_deref() != owner["launchId"].as_str() || !reply.closed() {
+            return Err(reply.unconfirmed.unwrap_or_else(|| "tree_lingering".into()));
+        }
+        return Ok(());
+    }
+    #[cfg(windows)]
+    {
+        return windows::stop_existing(&owner);
+    }
+}
