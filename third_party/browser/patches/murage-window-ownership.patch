+use super::*;
+use std::cell::{Cell, RefCell};
+const A: &str = "0123456789abcdef";
+const B: &str = "fedcba9876543210";
+fn owner(windows: bool, id: &str) -> Value {
+    json!({"v":1,"session":"fixture","launchId":id,"daemon":{"pid":123,"start":"1","exe":"engine"},
+        "group":if windows {json!({"kind":"job","name":format!("Local\\agent-browser-{id}")})} else {json!({"kind":"sid","id":123})},
+        "observationDir":"/launch/a"})
+}
+fn exhaustion(id: &str) -> Value {
+    json!({"launchId":id,"closed":true,"groupExhausted":true,"treeExhausted":true,"outsideSeen":0,"unconfirmed":null,"saveStatus":"saved"})
+}
+struct Fake {
+    windows: bool,
+    owner: RefCell<Option<Value>>,
+    reads: Cell<usize>,
+    swap: Cell<usize>,
+    log: RefCell<Vec<String>>,
+    clock: Cell<Instant>,
+    alive: Cell<bool>,
+    reused: Cell<bool>,
+    close_elapsed: Cell<Duration>,
+    retire: Cell<bool>,
+    keep_after_close: Cell<bool>,
+    graceful: RefCell<Value>,
+    stop: RefCell<Value>,
+    members: Cell<usize>,
+    outside: Cell<usize>,
+    job_gone: Cell<bool>,
+    active: Cell<u32>,
+    census_error: Cell<bool>,
+}
+impl Fake {
+    fn new(windows: bool) -> Self {
+        Self {
+            windows,
+            owner: RefCell::new(Some(owner(windows, A))),
+            reads: Cell::new(0),
+            swap: Cell::new(usize::MAX),
+            log: RefCell::new(vec![]),
+            clock: Cell::new(Instant::now()),
+            alive: Cell::new(true),
+            reused: Cell::new(false),
+            close_elapsed: Cell::new(Duration::ZERO),
+            retire: Cell::new(true),
+            keep_after_close: Cell::new(false),
+            graceful: RefCell::new(json!({"success":true,"data":exhaustion(A)})),
+            stop: RefCell::new(exhaustion(A)),
+            members: Cell::new(0),
+            outside: Cell::new(0),
+            job_gone: Cell::new(false),
+            active: Cell::new(0),
+            census_error: Cell::new(false),
+        }
+    }
+    fn expected(&self) -> Expected {
+        Expected::resolve("fixture", Some(A), None, "/socket/a".into(), "engine", self).unwrap()
+    }
+    fn record(&self, value: &str) {
+        self.log.borrow_mut().push(value.into());
+    }
+    fn failure(&self) {
+        *self.graceful.borrow_mut() = json!({"success":false});
+    }
+    fn code(&self, e: &Expected) -> String {
+        close_session(e, self).unwrap_err().code
+    }
+}
+impl CloseIo for Fake {
+    fn windows(&self) -> bool {
+        self.windows
+    }
+    fn linux(&self) -> bool {
+        !self.windows
+    }
+    fn now(&self) -> Instant {
+        self.clock.get()
+    }
+    fn pause(&self) {
+        self.clock
+            .set(self.clock.get() + Duration::from_millis(100));
+    }
+    fn read_owner(&self, _: &Path) -> Result<Option<Value>, CloseError> {
+        self.record("read_owner");
+        let n = self.reads.get() + 1;
+        self.reads.set(n);
+        if n == self.swap.get() || (self.swap.get() == 100 && n >= 4) {
+            *self.owner.borrow_mut() = Some(owner(self.windows, B));
+        }
+        Ok(self.owner.borrow().clone())
+    }
+    fn identity(&self, _: u32) -> Result<Option<ProcId>, CloseError> {
+        self.record("identity");
+        Ok(self.alive.get().then(|| ProcId {
+            pid: 123,
+            start: if self.reused.get() { "reused" } else { "1" }.into(),
+            exe: "engine".into(),
+        }))
+    }
+    fn send_close_only(&self, e: &Expected, _: Instant) -> Result<Value, CloseError> {
+        self.record(&format!("close:{}", e.endpoint.display()));
+        self.clock.set(self.clock.get() + self.close_elapsed.get());
+        let reply = self.graceful.borrow().clone();
+        if self.retire.get() && !self.keep_after_close.get() && reply["data"]["closed"] == true {
+            self.alive.set(false);
+        }
+        if let Some(error) = reply["transportError"].as_str() {
+            return Err(error.into());
+        }
+        Ok(reply)
+    }
+    fn send_stop(&self, _: &Expected, _: Instant) -> Result<Value, CloseError> {
+        self.record("stop");
+        if self.retire.get() {
+            self.alive.set(false);
+        }
+        Ok(self.stop.borrow().clone())
+    }
+    fn census(&self, e: &Expected, _: Instant) -> Result<Census, CloseError> {
+        self.record(&format!("census:{:?}:{:?}", e.sid, e.observation));
+        if self.census_error.get() {
+            return Err("census_unavailable".into());
+        }
+        Ok(Census {
+            members: self.members.get(),
+            outside: self.outside.get(),
+        })
+    }
+    fn open_job(&self, name: &str) -> Result<Option<usize>, CloseError> {
+        self.record(&format!("open:{name}"));
+        // Swap after corroboration, while entering the real dispatch boundary.
+        if self.swap.get() == 100 {
+            *self.owner.borrow_mut() = Some(owner(true, B));
+        }
+        Ok((!self.job_gone.get()).then_some(1))
+    }
+    fn terminate_job(&self, _: usize) -> Result<(), CloseError> {
+        self.record("terminate");
+        Ok(())
+    }
+    fn active_processes(&self, _: usize) -> Result<u32, CloseError> {
+        self.record("active");
+        Ok(self.active.get())
+    }
+    fn release_job(&self, _: usize) {
+        self.record("release");
+    }
+}
+#[test]
+fn ownership_n1_close_all_graceful_before_force() {
+    let f = Fake::new(false);
+    let e = f.expected();
+    assert_eq!(close_session(&e, &f).unwrap().path, "graceful");
+    let log = f.log.borrow();
+    let close = log.iter().position(|s| s.starts_with("close:")).unwrap();
+    let census = log.iter().position(|s| s.starts_with("census:")).unwrap();
+    assert!(close < census);
+    assert!(!log.iter().any(|s| s == "stop"));
+    assert!(log[close + 1..census].contains(&"identity".into()));
+}
+#[test]
+fn ownership_n1_graceful_failure_then_force() {
+    let f = Fake::new(false);
