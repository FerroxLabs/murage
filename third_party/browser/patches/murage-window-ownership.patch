+/// Read-only status. A recorded SID/PGID never authorizes a signal.
+pub fn group_status(path: &Path) -> io::Result<Value> {
+    let owner: Value = serde_json::from_slice(&fs::read(path)?)?;
+    #[cfg(windows)]
+    {
+        return windows::status(
+            owner["group"]["name"]
+                .as_str()
+                .ok_or_else(|| io::Error::other("missing job name"))?,
+        );
+    }
+    let expected: ProcId = serde_json::from_value(owner["daemon"].clone())?;
+    let current = match identity(expected.pid) {
+        Ok(value) => Some(value),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(error) => return Err(error),
+    };
+    let daemon_alive = current
+        .as_ref()
+        .is_some_and(|actual| actual.start == expected.start && actual.exe == expected.exe);
+    let leader_reused = current.is_some() && !daemon_alive;
+    let mut members = Vec::new();
+    #[cfg(target_os = "linux")]
+    {
+        let group = owner["group"]["id"]
+            .as_i64()
+            .ok_or_else(|| io::Error::other("invalid session identity"))?
+            as i32;
+        for entry in fs::read_dir("/proc")? {
+            let entry = entry?;
+            let Ok(pid) = entry.file_name().to_string_lossy().parse::<u32>() else {
+                continue;
+            };
+            if let Ok(stat) = proc_stat(pid) {
+                if stat.session == group {
+                    if let Ok(identity) = identity(pid) {
+                        members.push(json!({"pid":pid,"start":identity.start,"exe":identity.exe,"pgid":stat.group}));
+                    } else if stat.state != 'Z' {
+                        return Err(io::Error::other("unreadable session member"));
+                    }
+                }
+            }
+        }
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let group = owner["group"]["id"]
+            .as_i64()
+            .ok_or_else(|| io::Error::other("missing session id"))? as i32;
+        members = macos::status(group)?;
+    }
+    #[allow(unreachable_code)]
+    Ok(json!({"daemonAlive":daemon_alive,"members":members,"leaderReused":leader_reused}))
+}
