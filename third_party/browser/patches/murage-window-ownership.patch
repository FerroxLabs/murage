+// Modified by Ferrox Labs: mandatory launch ownership and held-child shutdown (omb.4).
+// The CLI/status reader never signals a process selected by an on-disk identity.
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{
+    fs,
+    io::{self, Write},
+    path::{Path, PathBuf},
+    process::{Child, Command},
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct ProcId {
+    pub pid: u32,
+    pub start: String,
+    pub exe: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Exhaustion {
+    pub launch_id: Option<String>,
+    pub group_exhausted: bool,
+    pub tree_exhausted: bool,
+    pub outside_seen: usize,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub live_children: Option<usize>,
+    pub unconfirmed: Option<String>,
+}
+impl Exhaustion {
+    fn pending(reason: &str) -> Self {
+        Self {
+            launch_id: launch_id(),
+            group_exhausted: false,
+            tree_exhausted: false,
+            outside_seen: 0,
+            live_children: None,
+            unconfirmed: Some(reason.into()),
+        }
+    }
+    pub fn closed(&self) -> bool {
+        self.group_exhausted
+            && self.unconfirmed.is_none()
+            && self.outside_seen == 0
+            && (!cfg!(target_os = "linux") || self.tree_exhausted || self.launch_id.is_none())
+    }
+}
+
+struct Runtime {
+    path: PathBuf,
+    owner: Mutex<Value>,
+}
+static RUNTIME: OnceLock<Runtime> = OnceLock::new();
+static CHILD: Mutex<Option<Arc<Mutex<HeldChild>>>> = Mutex::new(None);
+static STOPPING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static STOP_COUNT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+pub fn stop_count() -> u64 {
+    STOP_COUNT.load(std::sync::atomic::Ordering::Acquire)
+}
+
+/// A close transaction reports its completed attempt instead of retrying from
+/// Drop and again during proof collection. A later request still calls stop().
+pub fn stop_after_close(before: u64) -> Exhaustion {
+    if CHILD.is_poisoned()
+        || RUNTIME
+            .get()
+            .is_some_and(|runtime| runtime.owner.is_poisoned())
+    {
+        return Exhaustion::pending("ownership_poisoned");
+    }
+    STOPPING.store(true, std::sync::atomic::Ordering::Release);
+    if stop_count() != before {
+        if let Ok(slot) = CHILD.try_lock() {
+            if let Some(held) = slot.as_ref() {
+                if let Ok(held) = held.try_lock() {
+                    return held.result.clone();
+                }
+            }
+        }
+        return Exhaustion::pending("stop_in_progress");
+    }
+    stop()
+}
+pub fn launch_id() -> Option<String> {
+    std::env::var("AGENT_BROWSER_LAUNCH_ID").ok()
+}
+pub fn validate_launch_id(id: &str) -> io::Result<()> {
+    if id.len() == 16
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        Ok(())
+    } else {
+        Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid launch id",
+        ))
+    }
+}
+
+pub fn atomic_write(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "missing parent"))?;
+    let temporary = parent.join(format!(".ownership-{}.tmp", uuid::Uuid::new_v4()));
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    drop(file);
+    // Test-only crash boundary: never present in a vendor binary.
+    #[cfg(test)]
+    if let Some(marker) = std::env::var_os("OMB4_ATOMIC_PAUSE") {
+        fs::write(marker, b"ready")?;
+        loop {
+            std::thread::park();
+        }
+    }
+    #[cfg(unix)]
+    {
+        fs::rename(&temporary, path)?;
+        fs::File::open(parent)?.sync_all()?;
+    }
+    #[cfg(windows)]
+    windows::replace(&temporary, path)?;
+    Ok(())
+}
