+// A syscall-denied stand-in exercises the bounded protocol without claiming
+// the native FUSE/uninterruptible-sleep row.
+#[test]
+#[cfg(target_os = "linux")]
+fn ownership_e22_denied_termination_keeps_hold_and_status_for_retry() {
+    use std::{
+        io::{BufRead, BufReader, Write},
+        os::unix::{fs::PermissionsExt, net::UnixStream},
+    };
+    let mut fixture = Fixture::new();
+    let script = fixture.dir.path().join("chrome-fixture");
+    std::fs::write(&script, "#!/bin/sh\nfor arg do case $arg in --user-data-dir=*) dir=${arg#*=};; esac; done\nprintf '9\\n/devtools/browser/fixture\\n' > \"$dir/DevToolsActivePort\"\nexec sleep 90\n").unwrap();
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let mut command = fixture.command();
+    command.env("AGENT_BROWSER_DAEMON", "1");
+    deny_syscall(&mut command, libc::SYS_kill, libc::ESRCH);
+    deny_syscall(&mut command, libc::SYS_pidfd_send_signal, libc::EPERM);
+    fixture.child = Some(command.spawn().unwrap());
+    fixture.wait_ready();
+    let launch = fixture.request(serde_json::json!({"id":"e22", "action":"launch", "noXvfb":true, "headless":true, "executablePath":script}));
+    assert_eq!(launch["success"], false);
+    let owner: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(fixture.dir.path().join("fixture.owner.json")).unwrap(),
+    )
+    .unwrap();
+    let chrome = owner["chrome"]["pid"].as_u64().unwrap() as u32;
+    let stop_path = fixture.dir.path().join("fixture.stop");
+    let start = Instant::now();
+    let mut stop = UnixStream::connect(&stop_path).unwrap();
+    stop.set_read_timeout(Some(Duration::from_secs(13)))
+        .unwrap();
+    writeln!(stop, "{{\"launchId\":\"0123456789abcdef\"}}").unwrap();
+    std::thread::sleep(Duration::from_millis(200));
+    let mut status = UnixStream::connect(&stop_path).unwrap();
+    status
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    writeln!(
+        status,
+        "{{\"launchId\":\"0123456789abcdef\",\"action\":\"status\"}}"
+    )
+    .unwrap();
+    let mut line = String::new();
+    BufReader::new(status).read_line(&mut line).unwrap();
+    assert!(
+        serde_json::from_str::<serde_json::Value>(&line).unwrap()["stopping"]
+            .as_bool()
+            .unwrap()
+    );
+    line.clear();
+    BufReader::new(stop).read_line(&mut line).unwrap();
+    let result: serde_json::Value = serde_json::from_str(&line).unwrap();
+    assert_eq!(result["treeExhausted"], false, "{result}");
+    assert_eq!(result["unconfirmed"], "tree_lingering", "{result}");
+    assert!(start.elapsed() < Duration::from_secs(13));
+    assert!(
+        std::path::Path::new(&format!("/proc/{chrome}")).exists(),
+        "deadline preserves the held child"
+    );
+    // This test owns the fixture: release its pinned child through a pidfd.
+    let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, chrome, 0) } as i32;
+    assert!(fd >= 0);
+    assert_eq!(
+        unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                fd,
+                libc::SIGKILL,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        },
+        0
+    );
+    unsafe {
+        libc::close(fd);
+    }
+    let mut retry = UnixStream::connect(stop_path).unwrap();
+    retry
+        .set_read_timeout(Some(Duration::from_secs(13)))
+        .unwrap();
+    writeln!(retry, "{{\"launchId\":\"0123456789abcdef\"}}").unwrap();
+    line.clear();
+    BufReader::new(retry).read_line(&mut line).unwrap();
+    let result: serde_json::Value = serde_json::from_str(&line).unwrap();
+    assert_eq!(result["treeExhausted"], true, "{result}");
+}
