index 0000000..90e0d09
--- /dev/null
+++ b/cli/src/native/ownership/windows.rs
@@ -0,0 +1,257 @@
+// Modified by Ferrox Labs: named, non-breakaway job ownership for every child.
+use super::*;
+use std::os::windows::ffi::OsStrExt;
+use windows_sys::Win32::{
+    Foundation::*,
+    Storage::FileSystem::*,
+    System::{
+        JobObjects::*,
+        SystemServices::{JOB_OBJECT_QUERY, JOB_OBJECT_TERMINATE},
+        Threading::*,
+    },
+};
+
+struct Handle(HANDLE);
+impl Drop for Handle {
+    fn drop(&mut self) {
+        unsafe {
+            CloseHandle(self.0);
+        }
+    }
+}
+static JOB: OnceLock<HANDLE> = OnceLock::new();
+fn wide(path: &std::ffi::OsStr) -> Vec<u16> {
+    path.encode_wide().chain(Some(0)).collect()
+}
+pub(super) fn job_name(session: &str) -> String {
+    format!(
+        "Local\\agent-browser-{}",
+        launch_id().unwrap_or_else(|| format!("{session}-{}", std::process::id()))
+    )
+}
+pub(super) fn replace(from: &Path, to: &Path) -> io::Result<()> {
+    if unsafe {
+        MoveFileExW(
+            wide(from.as_os_str()).as_ptr(),
+            wide(to.as_os_str()).as_ptr(),
+            MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH,
+        )
+    } == 0
+    {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+pub(super) fn prepare(session: &str) -> io::Result<()> {
+    let name = wide(std::ffi::OsStr::new(&job_name(session)));
+    let raw = unsafe { CreateJobObjectW(std::ptr::null(), name.as_ptr()) };
+    if raw == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let job = Handle(raw);
+    if unsafe { GetLastError() } == ERROR_ALREADY_EXISTS {
+        return Err(io::Error::other("launch_used"));
+    }
+    let mut limits: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = unsafe { std::mem::zeroed() };
+    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if unsafe {
+        SetInformationJobObject(
+            job.0,
+            JobObjectExtendedLimitInformation,
+            &limits as *const _ as *const _,
+            std::mem::size_of_val(&limits) as u32,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    if unsafe { AssignProcessToJobObject(job.0, GetCurrentProcess()) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    JOB.set(job.0)
+        .map_err(|_| io::Error::other("job already held"))?;
+    std::mem::forget(job); // The OS closes this sole non-inheritable handle on daemon exit.
+    Ok(())
+}
+pub(super) fn identity(pid: u32) -> io::Result<ProcId> {
+    let raw = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+    if raw == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let handle = Handle(raw);
+    let mut creation: FILETIME = unsafe { std::mem::zeroed() };
+    let mut exit = creation;
+    let mut kernel = creation;
+    let mut user = creation;
+    if unsafe { GetProcessTimes(handle.0, &mut creation, &mut exit, &mut kernel, &mut user) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut path = vec![0u16; 32768];
+    let mut size = path.len() as u32;
+    if unsafe { QueryFullProcessImageNameW(handle.0, 0, path.as_mut_ptr(), &mut size) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(ProcId {
+        pid,
+        start: (((creation.dwHighDateTime as u64) << 32) | creation.dwLowDateTime as u64)
+            .to_string(),
+        exe: fs::canonicalize(String::from_utf16_lossy(&path[..size as usize]))?
+            .to_string_lossy()
+            .into_owned(),
+    })
+}
+fn members(job: HANDLE) -> io::Result<Vec<u32>> {
+    let mut count = 256usize;
+    loop {
+        // Pointer-sized allocation provides the alignment required by ULONG_PTR.
+        let mut bytes = vec![0usize; count + 2];
+        let list = bytes.as_mut_ptr() as *mut JOBOBJECT_BASIC_PROCESS_ID_LIST;
+        let ok = unsafe {
+            QueryInformationJobObject(
+                job,
+                JobObjectBasicProcessIdList,
+                list.cast(),
+                (bytes.len() * std::mem::size_of::<usize>()) as u32,
+                std::ptr::null_mut(),
+            )
+        };
+        if ok != 0 {
+            let actual = unsafe { (*list).NumberOfProcessIdsInList } as usize;
+            if actual > count {
+                return Err(io::Error::other("job listing overflow"));
+            }
+            return super::platform_contract::decode_job(
+                &bytes,
+                actual,
+                std::mem::offset_of!(JOBOBJECT_BASIC_PROCESS_ID_LIST, ProcessIdList),
+            );
+        }
+        if unsafe { GetLastError() } != ERROR_MORE_DATA || count >= 1_048_576 {
+            return Err(io::Error::last_os_error());
+        }
+        count *= 2;
+    }
+}
+pub(super) fn stop(held: &mut HeldChild) -> Exhaustion {
+    let mut result = Exhaustion::pending("tree_lingering");
+    let Some(job) = JOB.get() else {
+        return result;
+    };
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        let pids = match members(*job) {
+            Ok(pids) => pids,
+            Err(_) => return result,
+        };
+        let others: Vec<_> = pids
+            .into_iter()
+            .filter(|pid| *pid != std::process::id())
+            .collect();
+        if others.is_empty() {
+            // Only the daemon remains in its own job; the last handle closes on exit.
+            let _ = held.child.wait();
+            held.pgid = None;
+            result.group_exhausted = true;
+            result.tree_exhausted = true;
+            result.unconfirmed = None;
+            return result;
+        }
+        for pid in others {
+            if Instant::now() >= deadline {
+                break;
+            }
+            let raw = unsafe {
+                OpenProcess(
+                    PROCESS_TERMINATE | PROCESS_QUERY_LIMITED_INFORMATION,
+                    0,
+                    pid,
+                )
+            };
+            if raw == 0 {
+                continue;
+            }
+            let process = Handle(raw);
+            let mut member = 0;
+            // The opened handle pins the identity through membership check and termination.
+            if unsafe { IsProcessInJob(process.0, *job, &mut member) } != 0 && member != 0 {
+                unsafe {
+                    TerminateProcess(process.0, 1);
+                }
+            }
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    result
+}
+pub(super) fn exited(pid: u32) -> bool {
+    let raw = unsafe { OpenProcess(PROCESS_SYNCHRONIZE, 0, pid) };
+    if raw == 0 {
+        return true;
+    }
+    let handle = Handle(raw);
+    unsafe { WaitForSingleObject(handle.0, 0) == WAIT_OBJECT_0 }
+}
+
+pub(super) fn status(name: &str) -> io::Result<Value> {
+    let name = wide(std::ffi::OsStr::new(name));
+    let raw = unsafe { OpenJobObjectW(JOB_OBJECT_QUERY, 0, name.as_ptr()) };
+    if raw == 0 {
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() == Some(ERROR_FILE_NOT_FOUND as i32) {
+            return Ok(json!({"jobGone":true}));
+        }
+        return Err(error);
+    }
+    let job = Handle(raw);
+    let mut processes = Vec::new();
+    for pid in members(job.0)? {
+        let process = identity(pid)?;
+        processes.push(json!({"pid":pid, "start":process.start, "exe":process.exe, "pgid":null}));
+    }
+    Ok(json!({"jobGone":false,"members":processes}))
+}
+
+pub(super) fn stop_existing(owner: &Value) -> Result<(), String> {
+    let name = super::validated_job_name(owner)?;
+    let name = wide(std::ffi::OsStr::new(&name));
+    let raw = unsafe { OpenJobObjectW(JOB_OBJECT_QUERY | JOB_OBJECT_TERMINATE, 0, name.as_ptr()) };
+    if raw == 0 {
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() == Some(ERROR_FILE_NOT_FOUND as i32) {
+            return Ok(());
+        }
+        return Err(error.to_string());
+    }
+    let job = Handle(raw);
+    if unsafe { TerminateJobObject(job.0, 1) } == 0 {
+        return Err(io::Error::last_os_error().to_string());
+    }
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        let mut accounting: JOBOBJECT_BASIC_ACCOUNTING_INFORMATION = unsafe { std::mem::zeroed() };
+        if unsafe {
+            QueryInformationJobObject(
+                job.0,
+                JobObjectBasicAccountingInformation,
+                &mut accounting as *mut _ as *mut _,
+                std::mem::size_of_val(&accounting) as u32,
+                std::ptr::null_mut(),
+            )
+        } == 0
+        {
+            return Err(io::Error::last_os_error().to_string());
+        }
+        if accounting.ActiveProcesses == 0 {
+            return Ok(());
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    Err("tree_lingering".into())
+}
+
+pub(super) fn only_daemon_remains() -> bool {
+    JOB.get().is_some_and(|job| {
+        members(*job).is_ok_and(|pids| pids.iter().all(|pid| *pid == std::process::id()))
+    })
+}
