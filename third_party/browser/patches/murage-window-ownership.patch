+// Modified by Ferrox Labs: behavioral mutant witnesses at the syscall boundary.
+// PID cycling and uninterruptible-sleep tracing remain native proof obligations.
+use super::*;
+use std::cell::RefCell;
+#[derive(Default)]
+struct Hooks {
+    children: Option<Vec<u32>>,
+    exited: bool,
+    signals: usize,
+}
+thread_local! { static HOOKS: RefCell<Hooks> = RefCell::new(Hooks::default()); }
+pub(super) fn listed_children() -> Option<Vec<u32>> {
+    HOOKS.with(|h| h.borrow().children.clone())
+}
+pub(super) fn report_exited() -> bool {
+    HOOKS.with(|h| h.borrow().exited)
+}
+pub(super) fn record_pidfd_signal() {
+    HOOKS.with(|h| h.borrow_mut().signals += 1);
+}
+fn signals() -> usize {
+    HOOKS.with(|h| h.borrow().signals)
+}
+fn child() -> Child {
+    use std::os::unix::process::CommandExt;
+    let mut cmd = Command::new("sleep");
+    cmd.arg("60");
+    unsafe {
+        cmd.pre_exec(|| {
+            if libc::setpgid(0, 0) != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    cmd.spawn().unwrap()
+}
+struct Cleanup(Vec<Child>);
+impl Drop for Cleanup {
+    fn drop(&mut self) {
+        for child in &mut self.0 {
+            if exited_no_reap(child.id()).is_ok() {
+                let _ = child.kill();
+                let _ = child.wait();
+            }
+        }
+    }
+}
+fn run(arm: &str) {
+    let result = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "native::ownership::behavior_tests::ownership_behavior_fixture",
+            "--ignored",
+        ])
+        .env("OMB4_BEHAVIOR_ARM", arm)
+        .status()
+        .unwrap();
+    assert!(result.success(), "behavioral mutant witness {arm}");
+}
+#[test]
+fn ownership_m_e1_pidfd_signal_reaches_owned_helper() {
+    run("e1");
+}
+#[test]
+fn ownership_m_e2_parent_refuses_nonchild() {
+    run("e2_parent");
+}
+#[test]
+fn ownership_m_e2_live_refuses_exited_descriptor() {
+    run("e2_live");
+}
+#[test]
+fn ownership_m_e3_kernel_child_blocks_exhaustion() {
+    run("e3");
+}
+#[test]
+fn ownership_m_e4_expired_deadline_retains_group() {
+    run("e4");
+}
+#[test]
+#[ignore]
+fn ownership_behavior_fixture() {
+    let arm = std::env::var("OMB4_BEHAVIOR_ARM").unwrap();
+    let mut held = HeldChild::new(child(), true);
+    let chrome = held.child.id();
+    let mut helpers = Cleanup(Vec::new());
+    let mut grandchild = None;
+    if arm == "e2_parent" {
+        use std::io::{BufRead, BufReader};
+        let mut parent = Command::new("sh")
+            .args(["-c", "sleep 60 & echo $!; wait"])
+            .stdout(std::process::Stdio::piped())
+            .spawn()
+            .unwrap();
+        let mut line = String::new();
+        BufReader::new(parent.stdout.take().unwrap())
+            .read_line(&mut line)
+            .unwrap();
+        let nominee: u32 = line.trim().parse().unwrap();
+        grandchild = Some(PidFd::open(nominee).unwrap());
+        helpers.0.push(parent);
+        HOOKS.with(|h| h.borrow_mut().children = Some(vec![chrome, nominee]));
+    } else if arm != "e4" {
+        helpers.0.push(child());
+        let helper = helpers.0[0].id();
+        HOOKS.with(|h| {
+            let mut h = h.borrow_mut();
+            h.children = if arm == "e3" {
+                Some(vec![chrome])
+            } else {
+                None
+            };
+            h.exited = arm == "e2_live";
+        });
+        assert!(helper > 0);
+    }
+    let deadline = if arm == "e4" {
+        Instant::now()
+    } else {
+        Instant::now() + Duration::from_millis(100)
+    };
+    let result = stop_linux(&mut held, deadline);
+    let count = signals();
+    let pinned = held.pgid.is_some();
+    if let Some(fd) = grandchild {
+        let _ = fd.kill();
+    }
+    // Cleanup uses only children this fixture still owns.
+    if pinned {
+        let _ = held.child.kill();
+        let _ = held.child.wait();
+    }
+    match arm.as_str() {
+        "e1" => {
+            assert!(count > 0, "helper termination must use its held pidfd");
+            assert!(result.tree_exhausted);
+        }
+        "e2_parent" | "e2_live" => {
+            assert_eq!(count, 0, "unverified descriptor must never be signalled");
+            assert!(!result.closed());
+        }
+        "e3" => {
+            assert!(
+                !result.tree_exhausted,
+                "a kernel child survives the incomplete listing"
+            );
+            assert!(!result.closed());
+        }
+        "e4" => {
+            assert!(!result.closed());
+            assert!(pinned, "deadline retains the leader pin");
+            assert_eq!(count, 0);
+        }
+        _ => panic!("unknown arm"),
+    }
+}
