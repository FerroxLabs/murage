--- /dev/null
+++ b/cli/src/native/ownership/fixture.rs
@@ -0,0 +1,89 @@
+// Protocol fixture compiled only with the explicit ownership-test-fixtures feature.
+// It exercises caller routing and dirty-state save order, not Chromium persistence.
+use serde_json::{json, Value};
+use std::{
+    fs,
+    io::{BufRead, BufReader, Write},
+    os::unix::net::UnixListener,
+    path::Path,
+    thread,
+    time::Duration,
+};
+pub fn run(dir: &Path, session: &str) -> ! {
+    unsafe {
+        assert!(libc::setsid() > 0);
+    }
+    let pid = std::process::id();
+    let launch = "0123456789abcdef";
+    let stat = fs::read_to_string(format!("/proc/{pid}/stat")).unwrap();
+    let ticks = stat
+        .rsplit_once(')')
+        .unwrap()
+        .1
+        .split_whitespace()
+        .nth(19)
+        .unwrap();
+    let start = format!(
+        "{}:{ticks}",
+        fs::read_to_string("/proc/sys/kernel/random/boot_id")
+            .unwrap()
+            .trim()
+    );
+    let exe = fs::canonicalize(std::env::current_exe().unwrap()).unwrap();
+    let sock = UnixListener::bind(dir.join(format!("{session}.sock"))).unwrap();
+    sock.set_nonblocking(true).unwrap();
+    let stop = UnixListener::bind(dir.join(format!("{session}.stop"))).unwrap();
+    stop.set_nonblocking(true).unwrap();
+    fs::write(dir.join(format!("{session}.pid")), pid.to_string()).unwrap();
+    fs::write(dir.join(format!("{session}.owner.json")),json!({"v":1,"session":session,"launchId":launch,
+        "daemon":{"pid":pid,"start":start,"exe":exe},"group":{"kind":"sid","id":pid},"observationDir":dir}).to_string()).unwrap();
+    fs::write(dir.join("ready"), b"ready").unwrap();
+    loop {
+        for (name, listener) in [("sock", &sock), ("stop", &stop)] {
+            let Ok((mut socket, _)) = listener.accept() else {
+                continue;
+            };
+            socket
+                .set_read_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+            let mut line = String::new();
+            if BufReader::new(&socket).read_line(&mut line).is_err() || line.is_empty() {
+                continue;
+            }
+            let request: Value = serde_json::from_str(&line).unwrap();
+            let proof = json!({"launchId":launch,"closed":true,"saveStatus":"saved","groupExhausted":true,"treeExhausted":true,"outsideSeen":0,"unconfirmed":null});
+            let mut trace = fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(dir.join("trace"))
+                .unwrap();
+            if name == "sock" {
+                if request["action"] != "close"
+                    || request["closeOnly"] != true
+                    || request["launchId"] != launch
+                    || request["requireSaved"] != false
+                {
+                    writeln!(trace, "invalid:{request}").unwrap();
+                    writeln!(
+                        socket,
+                        "{}",
+                        json!({"success":false,"error":"invalid_close"})
+                    )
+                    .unwrap();
+                    continue;
+                }
+                writeln!(trace, "graceful").unwrap();
+                let dirty = fs::read(dir.join("dirty.json")).unwrap();
+                fs::write(dir.join("restore.json"), dirty).unwrap();
+                writeln!(trace, "saved").unwrap();
+                writeln!(socket, "{}", json!({"success":true,"data":proof})).unwrap();
+            } else {
+                writeln!(trace, "force").unwrap();
+                writeln!(socket, "{proof}").unwrap();
+            }
+            socket.flush().unwrap();
+            std::process::exit(0);
+        }
+        thread::sleep(Duration::from_millis(5));
+    }
+}
diff --git a/cli/src/native/ownership/macos.rs b/cli/src/native/ownership/macos.rs
