+// Modified by Ferrox Labs: isolated daemon publication and close-only fixtures.
+use std::{
+    process::{Child, Command, Stdio},
+    time::{Duration, Instant},
+};
+
+struct Fixture {
+    dir: tempfile::TempDir,
+    child: Option<Child>,
+}
+impl Fixture {
+    fn new() -> Self {
+        Self {
+            dir: tempfile::tempdir().unwrap(),
+            child: None,
+        }
+    }
+    fn command(&self) -> Command {
+        let mut cmd = Command::new(env!("CARGO_BIN_EXE_agent-browser"));
+        cmd.env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .env("HOME", self.dir.path())
+            .env("AGENT_BROWSER_SOCKET_DIR", self.dir.path())
+            .env("AGENT_BROWSER_LAUNCH_ID", "0123456789abcdef")
+            .env("AGENT_BROWSER_SESSION", "fixture")
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        cmd
+    }
+    fn start(&mut self) {
+        self.child = Some(
+            self.command()
+                .env("AGENT_BROWSER_DAEMON", "1")
+                .spawn()
+                .unwrap(),
+        );
+    }
+    fn wait_ready(&mut self) {
+        let until = Instant::now() + Duration::from_secs(5);
+        while Instant::now() < until {
+            if self.dir.path().join("fixture.sock").exists() {
+                return;
+            }
+            assert!(
+                self.child.as_mut().unwrap().try_wait().unwrap().is_none(),
+                "daemon exited before ready"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        panic!("daemon did not bind");
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        if let Some(child) = self.child.as_mut() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+    }
+}
+#[test]
+#[cfg(unix)]
+fn ownership_e1_owner_precedes_socket() {
+    let mut fixture = Fixture::new();
+    fixture.start();
+    fixture.wait_ready();
+    let owner: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(fixture.dir.path().join("fixture.owner.json")).expect("owner before bind"),
+    )
+    .unwrap();
+    assert_eq!(owner["launchId"], "0123456789abcdef");
+    assert_eq!(owner["daemon"]["pid"], fixture.child.as_ref().unwrap().id());
+    assert_eq!(
+        unsafe { libc::getsid(fixture.child.as_ref().unwrap().id() as i32) },
+        fixture.child.as_ref().unwrap().id() as i32
+    );
+    assert!(fixture.dir.path().join("fixture.pid").exists());
+    assert!(fixture.dir.path().join("fixture.stop").exists());
+}
