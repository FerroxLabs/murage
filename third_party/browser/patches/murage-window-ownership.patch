+    let mut fixture = Fixture::new();
+    std::fs::create_dir(fixture.dir.path().join("fixture.owner.json")).unwrap();
+    fixture.start();
+    let until = Instant::now() + Duration::from_secs(5);
+    loop {
+        if let Some(status) = fixture.child.as_mut().unwrap().try_wait().unwrap() {
+            assert_eq!(status.code(), Some(78));
+            break;
+        }
+        assert!(Instant::now() < until, "publication failure must exit");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    assert!(!fixture.dir.path().join("fixture.sock").exists());
+    assert!(!fixture.dir.path().join("fixture.port").exists());
