+#[test]
+#[cfg(target_os = "linux")]
+fn ownership_e22_close_transaction_attempts_one_bounded_stop() {
+    use std::os::unix::fs::PermissionsExt;
+    let mut fixture = Fixture::new();
+    let wrapper = fixture.dir.path().join("chrome-with-helper");
+    let helper = fixture.dir.path().join("escape.pid");
+    std::fs::write(&wrapper, format!("#!/bin/sh\nsetsid /bin/sh -c 'echo $$ > {}; exec sleep 90' </dev/null >/dev/null 2>&1 &\nexec /usr/bin/chromium \"$@\"\n", helper.display())).unwrap();
+    std::fs::set_permissions(&wrapper, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let mut command = fixture.command();
+    command.env("AGENT_BROWSER_DAEMON", "1");
+    deny_syscall(&mut command, libc::SYS_kill, libc::ESRCH);
+    deny_syscall(&mut command, libc::SYS_pidfd_send_signal, libc::EPERM);
+    fixture.child = Some(command.spawn().unwrap());
+    fixture.wait_ready();
+    let launch = fixture.request(serde_json::json!({"id":"e22", "action":"launch", "noXvfb":true, "headless":true, "executablePath":wrapper, "args":["--no-sandbox"]}));
+    assert_eq!(launch["success"], true, "{launch}");
+    // 25-second fixture request timeout is longer than the allowed one-attempt
+    // bound but shorter than repeated stops from close, Drop and final proof.
+    let started = Instant::now();
+    let close = fixture.close(false);
+    assert!(
+        started.elapsed() < Duration::from_secs(15),
+        "one close must not retry its own ten-second stop"
+    );
+    assert_eq!(close["data"]["closed"], false, "{close}");
+    assert_eq!(close["data"]["unconfirmed"], "tree_lingering", "{close}");
+    let pid: u32 = std::fs::read_to_string(helper)
+        .unwrap()
+        .trim()
+        .parse()
+        .unwrap();
+    let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid, 0) } as i32;
+    assert!(fd >= 0);
+    assert_eq!(
+        unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                fd,
+                libc::SIGKILL,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        },
+        0
+    );
+    unsafe {
+        libc::close(fd);
+    }
+    let retry = fixture.close(false);
+    assert_eq!(retry["data"]["treeExhausted"], true, "{retry}");
+}
