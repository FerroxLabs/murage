+// Modified by Ferrox Labs: mandatory launch ownership and held-child shutdown (omb.4).
+// The CLI/status reader never signals a process selected by an on-disk identity.
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{
+    fs,
+    io::{self, Write},
+    path::{Path, PathBuf},
+    process::{Child, Command},
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct ProcId {
+    pub pid: u32,
+    pub start: String,
+    pub exe: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Exhaustion {
+    pub launch_id: Option<String>,
+    pub group_exhausted: bool,
+    pub tree_exhausted: bool,
+    pub outside_seen: usize,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub live_children: Option<usize>,
+    pub unconfirmed: Option<String>,
+}
+impl Exhaustion {
+    fn pending(reason: &str) -> Self {
+        Self {
+            launch_id: launch_id(),
+            group_exhausted: false,
+            tree_exhausted: false,
+            outside_seen: 0,
+            live_children: None,
+            unconfirmed: Some(reason.into()),
+        }
+    }
+    pub fn closed(&self) -> bool {
+        self.group_exhausted
+            && self.unconfirmed.is_none()
+            && self.outside_seen == 0
+            && (!cfg!(target_os = "linux") || self.tree_exhausted || self.launch_id.is_none())
+    }
+}
+
+struct Runtime {
+    path: PathBuf,
+    owner: Mutex<Value>,
+}
+static RUNTIME: OnceLock<Runtime> = OnceLock::new();
+static CHILD: Mutex<Option<Arc<Mutex<HeldChild>>>> = Mutex::new(None);
+static STOPPING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static STOP_COUNT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+pub fn stop_count() -> u64 {
+    STOP_COUNT.load(std::sync::atomic::Ordering::Acquire)
+}
+
+/// A close transaction reports its completed attempt instead of retrying from
+/// Drop and again during proof collection. A later request still calls stop().
+pub fn stop_after_close(before: u64) -> Exhaustion {
+    if CHILD.is_poisoned()
+        || RUNTIME
+            .get()
+            .is_some_and(|runtime| runtime.owner.is_poisoned())
+    {
+        return Exhaustion::pending("ownership_poisoned");
+    }
+    STOPPING.store(true, std::sync::atomic::Ordering::Release);
+    if stop_count() != before {
+        if let Ok(slot) = CHILD.try_lock() {
+            if let Some(held) = slot.as_ref() {
+                if let Ok(held) = held.try_lock() {
+                    return held.result.clone();
+                }
+            }
+        }
+        return Exhaustion::pending("stop_in_progress");
+    }
+    stop()
+}
+pub fn launch_id() -> Option<String> {
+    std::env::var("AGENT_BROWSER_LAUNCH_ID").ok()
+}
+pub fn validate_launch_id(id: &str) -> io::Result<()> {
+    if id.len() == 16
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+    {
+        Ok(())
+    } else {
+        Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid launch id",
+        ))
+    }
+}
+
+pub fn atomic_write(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "missing parent"))?;
+    let temporary = parent.join(format!(".ownership-{}.tmp", uuid::Uuid::new_v4()));
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    drop(file);
+    // Test-only crash boundary: never present in a vendor binary.
+    #[cfg(test)]
+    if let Some(marker) = std::env::var_os("OMB4_ATOMIC_PAUSE") {
+        fs::write(marker, b"ready")?;
+        loop {
+            std::thread::park();
+        }
+    }
+    #[cfg(unix)]
+    {
+        fs::rename(&temporary, path)?;
+        fs::File::open(parent)?.sync_all()?;
+    }
+    #[cfg(windows)]
+    windows::replace(&temporary, path)?;
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+#[derive(Debug)]
+struct Stat {
+    state: char,
+    parent: u32,
+    group: i32,
+    session: i32,
+    start: String,
+}
+#[cfg(target_os = "linux")]
+fn proc_stat(pid: u32) -> io::Result<Stat> {
+    let text = fs::read_to_string(format!("/proc/{pid}/stat"))?;
+    let end = text
+        .rfind(')')
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "proc stat"))?;
+    let parts: Vec<_> = text[end + 1..].split_whitespace().collect();
+    let invalid = || io::Error::new(io::ErrorKind::InvalidData, "proc stat");
+    if parts.len() < 20 {
+        return Err(invalid());
+    }
+    Ok(Stat {
+        state: parts[0].chars().next().ok_or_else(invalid)?,
+        parent: parts[1].parse().map_err(|_| invalid())?,
+        group: parts[2].parse().map_err(|_| invalid())?,
+        session: parts[3].parse().map_err(|_| invalid())?,
+        start: parts[19].into(),
+    })
+}
+
+pub fn identity(pid: u32) -> io::Result<ProcId> {
+    #[cfg(target_os = "linux")]
+    {
+        let stat = proc_stat(pid)?;
+        let boot = fs::read_to_string("/proc/sys/kernel/random/boot_id")?;
+        return Ok(ProcId {
+            pid,
+            start: format!("{}:{}", boot.trim(), stat.start),
+            exe: fs::read_link(format!("/proc/{pid}/exe"))?
+                .to_string_lossy()
+                .into_owned(),
+        });
+    }
+    #[cfg(target_os = "macos")]
+    {
+        return macos::identity(pid);
+    }
+    #[cfg(windows)]
+    {
+        return windows::identity(pid);
+    }
+    #[allow(unreachable_code)]
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "process identity unavailable",
+    ))
+}
+
+/// Called before creating the runtime: inherited SIGCHLD ignore must not reap children.
+pub fn prepare(session: &str) -> io::Result<()> {
+    if !crate::validation::is_valid_session_name(session) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid session",
+        ));
+    }
+
+    if let Some(id) = launch_id() {
+        validate_launch_id(&id)?;
+    }
+    #[cfg(unix)]
+    unsafe {
+        let mut action: libc::sigaction = std::mem::zeroed();
+        action.sa_sigaction = libc::SIG_DFL;
+        action.sa_flags = 0;
+        libc::sigemptyset(&mut action.sa_mask);
+        if libc::sigaction(libc::SIGCHLD, &action, std::ptr::null_mut()) != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let mut signals: libc::sigset_t = std::mem::zeroed();
+        libc::sigemptyset(&mut signals);
+        for signal in [libc::SIGTERM, libc::SIGHUP, libc::SIGINT] {
+            libc::sigaddset(&mut signals, signal);
+        }
+        let error = libc::pthread_sigmask(libc::SIG_BLOCK, &signals, std::ptr::null_mut());
+        if error != 0 {
+            return Err(io::Error::from_raw_os_error(error));
+        }
+
+        if libc::getsid(0) != libc::getpid() && libc::setsid() == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        if libc::getsid(0) != libc::getpid() {
+            return Err(io::Error::other("daemon session not owned"));
+        }
+    }
+    #[cfg(target_os = "linux")]
+    if launch_id().is_some()
+        && unsafe { libc::prctl(libc::PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) } != 0
+    {
+        return Err(io::Error::other("launch_failed: subreaper unavailable"));
+    }
+    #[cfg(windows)]
+    windows::prepare(session)?;
+    let dir = crate::connection::get_socket_dir();
+    fs::create_dir_all(&dir)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&dir, fs::Permissions::from_mode(0o700))?;
+    }
+    #[cfg(unix)]
+    {
+        let stop_path = dir.join(format!("{session}.stop"));
+        if stop_path.exists() {
+            let old: Value =
+                serde_json::from_slice(&fs::read(dir.join(format!("{session}.owner.json")))?)?;
+            let expected: ProcId = serde_json::from_value(old["daemon"].clone())?;
+            match identity(expected.pid) {
+                Ok(actual) if actual.start == expected.start && actual.exe == expected.exe => {
+                    return Err(io::Error::other("daemon_unresponsive"))
+                }
+                Ok(_) => {}
+                Err(error)
+                    if error.kind() == io::ErrorKind::NotFound
+                        || error.raw_os_error() == Some(libc::ESRCH) => {}
+                Err(error) => return Err(error),
+            }
+            fs::remove_file(stop_path)?;
+        }
+    }
+    let daemon = identity(std::process::id())?;
+    #[cfg(unix)]
+    let group = json!({"kind":"sid", "id":std::process::id()});
+    #[cfg(windows)]
+    let group = json!({"kind":"job", "name":windows::job_name(session)});
+    let owner = json!({"observationDir":fs::canonicalize(&dir).ok(), "v":1, "launchId":launch_id(), "session":session, "daemon":daemon, "group":group, "chrome":null});
+    let path = dir.join(format!("{session}.owner.json"));
+    atomic_write(&path, &serde_json::to_vec(&owner)?)?;
+    atomic_write(
+        &dir.join(format!("{session}.pid")),
+        std::process::id().to_string().as_bytes(),
+    )?;
+    RUNTIME
+        .set(Runtime {
+            path,
+            owner: Mutex::new(owner),
+        })
+        .map_err(|_| io::Error::other("ownership already prepared"))?;
+    #[cfg(unix)]
+    start_stop_channel(&dir.join(format!("{session}.stop")))?;
+    Ok(())
+}
+
+pub fn publish_chrome(pid: u32) -> io::Result<()> {
+    let Some(runtime) = RUNTIME.get() else {
+        return Ok(());
+    };
+    let identity = identity(pid)?;
+    #[cfg(unix)]
+    if unsafe { libc::getpgid(pid as i32) } != pid as i32 {
+        return Err(io::Error::other("Chrome group not owned"));
+    }
+    let mut owner = runtime
+        .owner
+        .lock()
+        .map_err(|_| io::Error::other("ownership mutex"))?;
+    owner["chrome"] =
+        json!({"pid":identity.pid, "start":identity.start, "exe":identity.exe, "pgid":pid});
+    atomic_write(&runtime.path, &serde_json::to_vec(&*owner)?)
+}
+
+pub struct HeldChild {
+    pub child: Child,
+    pub pgid: Option<i32>,
+    window: bool,
+    launch_dir: Option<PathBuf>,
+    result: Exhaustion,
+    attempted: bool,
+}
+impl HeldChild {
+    pub fn new(child: Child, window: bool) -> Self {
+        let pgid = Some(child.id() as i32);
+        Self {
+            child,
+            pgid,
+            window,
+            launch_dir: None,
+            result: Exhaustion::pending("not_stopped"),
+            attempted: false,
+        }
+    }
+    pub fn is_exhausted(&self) -> bool {
+        self.result.closed()
+    }
+    pub fn stop_on_drop(&mut self) {
+        if !self.attempted {
+            let _ = self.stop();
+        }
+    }
+    pub fn stop(&mut self) -> Exhaustion {
+        self.attempted = true;
+        STOP_COUNT.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+        if self.pgid.is_none() {
+            #[cfg(unix)]
+            if self.window && self.result.group_exhausted {
+                match observe_outside(self.launch_dir.as_deref()) {
+                    Ok(count) => {
+                        self.result.outside_seen = count;
+                        self.result.unconfirmed = if count == 0 {
+                            None
+                        } else {
+                            Some("helper_lingering".into())
+                        };
+                    }
+                    Err(_) => {
+                        self.result.unconfirmed = Some("enumeration_failed".into());
+                    }
+                }
+            }
+            return self.result.clone();
+        }
+        #[cfg(target_os = "linux")]
+        {
+            self.result = stop_linux(self, Instant::now() + Duration::from_secs(10));
+        }
+        #[cfg(target_os = "macos")]
+        {
+            self.result = macos::stop(self);
+        }
+        #[cfg(windows)]
+        {
+            self.result = windows::stop(self);
+        }
+        self.result.clone()
+    }
+}
+
+/// Poison never authorizes a stop or a profile deletion. Keep the held identity for diagnosis.
+pub fn lock_held(
+    held: &Mutex<HeldChild>,
+) -> Result<std::sync::MutexGuard<'_, HeldChild>, &'static str> {
+    if CHILD.is_poisoned()
+        || RUNTIME
+            .get()
+            .is_some_and(|runtime| runtime.owner.is_poisoned())
+    {
+        return Err("ownership_poisoned");
+    }
+    held.lock().map_err(|poison| {
+        let mut held = poison.into_inner();
+        held.attempted = true;
+        held.result = Exhaustion::pending("ownership_poisoned");
+        "ownership_poisoned"
+    })
+}
+pub fn stop_held(held: &Mutex<HeldChild>) -> Exhaustion {
+    match lock_held(held) {
+        Ok(mut held) => held.stop(),
+        Err(reason) => Exhaustion::pending(reason),
+    }
+}
+
+/// Register under the same mutex as stop, before the launch waiter can return.
+pub fn spawn_owned(command: &mut Command, profile: &Path) -> io::Result<Arc<Mutex<HeldChild>>> {
+    use std::sync::atomic::Ordering;
+    if RUNTIME
+        .get()
+        .is_some_and(|runtime| runtime.owner.is_poisoned())
+    {
+        return Err(io::Error::other("ownership_poisoned"));
+    }
+    let mut slot = CHILD
+        .lock()
+        .map_err(|_| io::Error::other("ownership mutex"))?;
+    if (launch_id().is_some() || RUNTIME.get().is_some()) && STOPPING.load(Ordering::Acquire) {
+        return Err(io::Error::other("launch_used"));
+    }
+    if let Some(previous) = slot.as_ref() {
+        if previous
+            .lock()
+            .map_err(|_| io::Error::other("ownership mutex"))?
+            .pgid
+            .is_some()
+        {
+            return Err(io::Error::other("previous browser still held"));
+        }
+        if launch_id().is_some() {
+            return Err(io::Error::other("launch_used"));
+        }
+    }
+    let mut observation = None;
+    if launch_id().is_some() {
+        // S2 places its temp profile under <launchDir>/tmp. Other callers use
+        // the exact profile as the conservative observation boundary.
+        observation = Some(
+            if profile.parent().and_then(Path::file_name) == Some(std::ffi::OsStr::new("tmp"))
+                && profile
+                    .parent()
+                    .and_then(Path::parent)
+                    .and_then(Path::file_name)
+                    == launch_id().as_deref().map(std::ffi::OsStr::new)
+            {
+                profile
+                    .parent()
+                    .and_then(Path::parent)
+                    .unwrap_or(profile)
+                    .to_path_buf()
+            } else {
+                profile.to_path_buf()
+            },
+        );
+    }
+    if let Some(path) = observation.as_mut() {
+        *path = fs::canonicalize(&*path)?;
+        if let Some(runtime) = RUNTIME.get() {
+            let mut owner = runtime
+                .owner
+                .lock()
+                .map_err(|_| io::Error::other("ownership_poisoned"))?;
+            owner["observationDir"] = json!(path);
+            atomic_write(&runtime.path, &serde_json::to_vec(&*owner)?)
+                .map_err(|e| io::Error::other(format!("identity publication: {e}")))?;
+        }
+    }
+    // Every fallible evidence write precedes spawn. A publication failure must
+    // never drop a newly spawned process before it is registered as HeldChild.
+    let child = command.spawn()?;
+    let mut child = HeldChild::new(child, launch_id().is_some());
+    child.launch_dir = observation;
+    let held = Arc::new(Mutex::new(child));
+    *slot = Some(held.clone());
+    Ok(held)
+}
+
+pub fn stop() -> Exhaustion {
+    if CHILD.is_poisoned()
+        || RUNTIME
+            .get()
+            .is_some_and(|runtime| runtime.owner.is_poisoned())
+    {
+        return Exhaustion::pending("ownership_poisoned");
+    }
+    STOPPING.store(true, std::sync::atomic::Ordering::Release);
+    let held = match CHILD.try_lock() {
+        Ok(slot) => slot.clone(),
+        Err(_) => return Exhaustion::pending("stop_in_progress"),
+    };
+    if let Some(held) = held {
+        return match held.try_lock() {
+            Ok(mut held) => held.stop(),
+            Err(std::sync::TryLockError::Poisoned(_)) => Exhaustion::pending("ownership_poisoned"),
+            Err(std::sync::TryLockError::WouldBlock) => Exhaustion::pending("stop_in_progress"),
+        };
+    }
+    let mut result = Exhaustion::pending("tree_lingering");
+    #[cfg(unix)]
+    if no_children() {
+        result.group_exhausted = true;
+        result.tree_exhausted = true;
+        result.unconfirmed = None;
+    }
+    #[cfg(windows)]
+    if windows::only_daemon_remains() {
+        result.group_exhausted = true;
+        result.tree_exhausted = true;
+        result.unconfirmed = None;
+    }
+    result
+}
+
+#[cfg(unix)]
+pub fn exited_no_reap(pid: u32) -> io::Result<bool> {
+    let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+    if unsafe {
+        libc::waitid(
+            libc::P_PID,
+            pid,
+            &mut info,
+            libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { info.si_pid() } != 0)
+}
+
+#[cfg(unix)]
+fn no_children() -> bool {
+    let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+    (unsafe {
+        libc::waitid(
+            libc::P_ALL,
+            0,
+            &mut info,
+            libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+        )
+    }) == -1
+        && io::Error::last_os_error().raw_os_error() == Some(libc::ECHILD)
+}
+
+#[cfg(target_os = "linux")]
+fn direct_children() -> io::Result<Vec<u32>> {
+    #[cfg(test)]
+    if let Some(list) = behavior_tests::listed_children() {
+        return Ok(list);
+    }
+
+    let mut children = std::collections::BTreeSet::new();
+    let mut fallback = false;
+    for task in fs::read_dir("/proc/self/task")? {
+        let task = task?;
+        match fs::read_to_string(task.path().join("children")) {
+            Ok(list) => {
+                for pid in list.split_whitespace() {
+                    children.insert(
+                        pid.parse()
+                            .map_err(|_| io::Error::other("invalid child listing"))?,
+                    );
+                }
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => fallback = true,
+            Err(error) => return Err(error),
+        }
+    }
+    if fallback {
+        for entry in fs::read_dir("/proc")? {
+            let entry = entry?;
+            if let Ok(pid) = entry.file_name().to_string_lossy().parse::<u32>() {
+                match proc_stat(pid) {
+                    Ok(stat) if stat.parent == std::process::id() => {
+                        children.insert(pid);
+                    }
+                    Ok(_) => {}
+                    Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                    Err(error) => return Err(error),
+                }
+            }
+        }
+    }
+    Ok(children.into_iter().collect())
+}
+
+#[cfg(target_os = "linux")]
+struct PidFd(std::os::fd::OwnedFd);
+#[cfg(target_os = "linux")]
+impl PidFd {
+    fn open(pid: u32) -> io::Result<Self> {
+        use std::os::fd::FromRawFd;
+        let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid, 0) } as i32;
+        if fd < 0 {
+            Err(io::Error::last_os_error())
+        } else {
+            Ok(Self(unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) }))
+        }
+    }
+    fn alive(&self) -> io::Result<bool> {
+        #[cfg(test)]
+        if behavior_tests::report_exited() {
+            return Ok(false);
+        }
+
+        use std::os::fd::AsRawFd;
+        let mut poll = libc::pollfd {
+            fd: self.0.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        match unsafe { libc::poll(&mut poll, 1, 0) } {
+            0 => Ok(true),
+            n if n > 0 => Ok(false),
+            _ => Err(io::Error::last_os_error()),
+        }
+    }
+    fn kill(&self) -> io::Result<()> {
+        #[cfg(test)]
+        behavior_tests::record_pidfd_signal();
+
+        use std::os::fd::AsRawFd;
+        if unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                self.0.as_raw_fd(),
+                libc::SIGKILL,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        } == 0
+        {
+            Ok(())
+        } else {
+            Err(io::Error::last_os_error())
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn reap_exited(pid: u32) {
+    if exited_no_reap(pid).unwrap_or(false) {
+        let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+        unsafe {
+            libc::waitid(libc::P_PID, pid, &mut info, libc::WEXITED | libc::WNOHANG);
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn stop_linux(held: &mut HeldChild, deadline: Instant) -> Exhaustion {
+    let mut result = Exhaustion::pending("tree_lingering");
+    let chrome = held.child.id();
+    let pgid = held.pgid.unwrap();
+    // Confirm pidfd support before sending even a group signal for a window.
+    if held.window {
+        if let Err(error) = PidFd::open(chrome) {
+            if error.raw_os_error() == Some(libc::ENOSYS) {
+                return Exhaustion::pending("pidfd_unsupported");
+            }
+            return result;
+        }
+    }
+    while Instant::now() < deadline {
+        // This is the only numeric signal: Chrome remains our unreaped child.
+        if unsafe { libc::killpg(pgid, libc::SIGKILL) } != 0
+            && io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+        {
+            return result;
+        }
+        if held.window {
+            let children = match direct_children() {
+                Ok(value) => value,
+                Err(_) => return Exhaustion::pending("enumeration_failed"),
+            };
+            for pid in children.iter().copied().filter(|p| *p != chrome) {
+                if Instant::now() >= deadline {
+                    break;
+                }
+                let fd = match PidFd::open(pid) {
+                    Ok(fd) => fd,
+                    Err(e) if e.raw_os_error() == Some(libc::ENOSYS) => {
+                        return Exhaustion::pending("pidfd_unsupported")
+                    }
+                    Err(_) => continue,
+                };
+                // Order is security-critical: open, direct-parent check, live check.
+                if !proc_stat(pid).is_ok_and(|stat| stat.parent == std::process::id()) {
+                    continue;
+                }
+                match fd.alive() {
+                    Ok(true) if Instant::now() < deadline => {
+                        let _ = fd.kill();
+                    }
+                    Ok(false) => reap_exited(pid),
+                    _ => {}
+                }
+            }
+            // Observe the leader's zombie FIRST: its orphans have then been
+            // handed to this subreaper. A listing taken before that observation
+            // can miss newly adopted children and must never authorize reaping.
+            if !exited_no_reap(chrome).unwrap_or(false) {
+                std::thread::sleep(Duration::from_millis(10));
+                continue;
+            }
+            let remaining = match direct_children() {
+                Ok(value) => value,
+                Err(_) => return result,
+            };
+            if remaining.iter().all(|pid| *pid == chrome) {
+                if held.child.wait().is_err() {
+                    return result;
+                }
+                held.pgid = None;
+                if no_children() {
+                    result.group_exhausted = true;
+                    result.tree_exhausted = true;
+                    match observe_outside(held.launch_dir.as_deref()) {
+                        Ok(count) => {
+                            result.outside_seen = count;
+                            result.unconfirmed = if count == 0 {
+                                None
+                            } else {
+                                Some("helper_lingering".into())
+                            };
+                        }
+                        Err(_) => {
+                            result.unconfirmed = Some("enumeration_failed".into());
+                        }
+                    }
+                }
+                return result;
+            }
+        } else {
+            // Panel daemons can also own Xvfb/recording. Only the held Chrome group is ours here.
+            let group_empty = fs::read_dir("/proc").ok().is_some_and(|entries| {
+                entries.filter_map(Result::ok).all(|entry| {
+                    let Ok(pid) = entry.file_name().to_string_lossy().parse::<u32>() else {
+                        return true;
+                    };
+                    pid == chrome || !proc_stat(pid).is_ok_and(|stat| stat.group == pgid)
+                })
+            });
+            if group_empty && exited_no_reap(chrome).unwrap_or(false) {
+                if held.child.wait().is_ok() {
+                    held.pgid = None;
+                    result.group_exhausted = true;
+                    result.unconfirmed = None;
+                }
+                return result;
+            }
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    result.live_children = direct_children().ok().and_then(|children| {
+        children
+            .into_iter()
+            .map(proc_stat)
+            .collect::<io::Result<Vec<_>>>()
+            .ok()
+            .map(|children| children.iter().filter(|child| child.state != 'Z').count())
+    });
+    // Deadline never releases a live child or its pinned group. A retry owns the same handles.
+    if held.window {
+        if let Ok(children) = direct_children() {
+            for pid in children {
+                if pid != chrome {
+                    reap_exited(pid);
+                }
+            }
+        }
+    }
+    result
+}
+
+#[cfg(unix)]
+fn start_stop_channel(path: &Path) -> io::Result<()> {
+    use std::io::{BufRead, BufReader, Read};
+    use std::os::unix::{fs::PermissionsExt, net::UnixListener};
+    let listener = UnixListener::bind(path)?;
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600))?;
+    let signal_session = RUNTIME
+        .get()
+        .and_then(|r| r.owner.lock().ok())
+        .and_then(|o| o["session"].as_str().map(str::to_owned))
+        .ok_or_else(|| io::Error::other("missing session"))?;
+    std::thread::Builder::new()
+        .name("ownership-signals".into())
+        .spawn(move || unsafe {
+            let mut signals: libc::sigset_t = std::mem::zeroed();
+            libc::sigemptyset(&mut signals);
+            for signal in [libc::SIGTERM, libc::SIGHUP, libc::SIGINT] {
+                libc::sigaddset(&mut signals, signal);
+            }
+            loop {
+                let mut signal = 0;
+                if libc::sigwait(&signals, &mut signal) == 0
+                    && close_entry(&signal_session, launch_id().as_deref(), true).is_ok()
+                {
+                    libc::_exit(0);
+                }
+            }
+        })?;
+    let busy = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    std::thread::Builder::new()
+        .name("ownership-stop".into())
+        .spawn(move || {
+            for connection in listener.incoming() {
+                let Ok(mut connection) = connection else {
+                    continue;
+                };
+                let _ = connection.set_read_timeout(Some(Duration::from_secs(2)));
+                let _ = connection.set_write_timeout(Some(Duration::from_secs(2)));
+                let mut line = String::new();
+                if BufReader::new((&connection).take(4097))
+                    .read_line(&mut line)
+                    .is_err()
+                    || line.len() > 4096
+                {
+                    continue;
+                }
+                let Ok(request) = serde_json::from_str::<Value>(&line) else {
+                    continue;
+                };
+                if request.get("launchId").and_then(Value::as_str) != launch_id().as_deref() {
+                    let _ = writeln!(connection, "{{\"error\":\"launch_mismatch\"}}");
+                    continue;
+                }
+                if request.get("action").and_then(Value::as_str) == Some("status") {
+                    let _ = writeln!(
+                        connection,
+                        "{{\"stopping\":{}}}",
+                        STOPPING.load(std::sync::atomic::Ordering::Acquire)
+                    );
+                    continue;
+                }
+                // One worker owns the routine; status and competing requests stay bounded.
+                if busy.swap(true, std::sync::atomic::Ordering::AcqRel) {
+                    let _ = writeln!(connection, "{{\"unconfirmed\":\"stop_in_progress\"}}");
+                    continue;
+                }
+                let busy = busy.clone();
+                std::thread::spawn(move || {
+                    let result = stop();
+                    let _ = writeln!(connection, "{}", serde_json::to_string(&result).unwrap());
+                    let _ = connection.flush();
+                    if result.closed() {
+                        unsafe {
+                            libc::_exit(0);
+                        }
+                    }
+                    busy.store(false, std::sync::atomic::Ordering::Release);
+                });
+            }
+        })?;
+    Ok(())
+}
