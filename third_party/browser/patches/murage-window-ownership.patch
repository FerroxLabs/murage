+// Test-only healthy daemon protocol fixture. This models persistence at the
+// daemon boundary and retirement; it does not claim Chromium persistence.
+use serde_json::{json, Value};
+use std::{
+    process::{Child, Command},
+    thread,
+    time::{Duration, Instant},
+};
+pub struct HealthyCloseFixture {
+    pub dir: tempfile::TempDir,
+    pub session: String,
+    pub launch: &'static str,
+    child: Child,
+    dirty: Value,
+}
+impl HealthyCloseFixture {
+    pub fn new(session: &str) -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let launch = "0123456789abcdef";
+        let dirty = json!({"cookies":[{"name":"session","value":"changed-cookie"}],
+            "origins":[{"origin":"https://fixture.invalid","localStorage":[{"name":"draft","value":"changed-storage"}]}]});
+        std::fs::write(
+            dir.path().join("restore.json"),
+            json!({"cookies":[],"origins":[]}).to_string(),
+        )
+        .unwrap();
+        std::fs::write(dir.path().join("dirty.json"), dirty.to_string()).unwrap();
+        let mut command = if let Some(binary) = option_env!("CARGO_BIN_EXE_agent-browser") {
+            let mut cmd = Command::new(binary);
+            cmd.arg("--ownership-test-fixture");
+            cmd
+        } else {
+            let mut cmd = Command::new(std::env::current_exe().unwrap());
+            cmd.args(["ownership_fixture_child", "--nocapture"]);
+            cmd
+        };
+        let mut child = command
+            .env("OMB4_FIXTURE_DIR", dir.path())
+            .env("OMB4_FIXTURE_SESSION", session)
+            .spawn()
+            .unwrap();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !dir.path().join("ready").exists() {
+            assert!(
+                child.try_wait().unwrap().is_none(),
+                "fixture exited before ready"
+            );
+            assert!(Instant::now() < deadline, "fixture readiness timeout");
+            thread::sleep(Duration::from_millis(10));
+        }
+        Self {
+            dir,
+            session: session.into(),
+            launch,
+            child,
+            dirty,
+        }
+    }
+    pub fn assert_saved_before_force(&self) {
+        let trace = std::fs::read_to_string(self.dir.path().join("trace")).unwrap_or_default();
+        assert_eq!(
+            trace, "graceful\nsaved\n",
+            "healthy dirty close must save exactly once before retirement"
+        );
+        let saved: Value =
+            serde_json::from_slice(&std::fs::read(self.dir.path().join("restore.json")).unwrap())
+                .unwrap();
+        assert_eq!(
+            saved, self.dirty,
+            "changed cookies and storage must survive close"
+        );
+    }
+}
+impl Drop for HealthyCloseFixture {
+    fn drop(&mut self) {
+        if self.child.try_wait().unwrap().is_none() {
+            let _ = self.child.kill();
+        }
+        let _ = self.child.wait();
+    }
+}
