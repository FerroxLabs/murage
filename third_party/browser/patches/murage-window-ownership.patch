+#[cfg(unix)]
+pub(crate) fn connect_unix_by(
+    path: &std::path::Path,
+    deadline: Instant,
+) -> Result<UnixStream, String> {
+    // A full Unix listen backlog can block connect. The worker owns only the
+    // frozen path and never sends a command after the receiver times out.
+    let path = path.to_path_buf();
+    let (tx, rx) = std::sync::mpsc::sync_channel(1);
+    thread::spawn(move || {
+        let _ = tx.send(UnixStream::connect(path));
+    });
+    rx.recv_timeout(deadline.saturating_duration_since(Instant::now()))
+        .map_err(|_| "daemon_unresponsive".to_string())?
+        .map_err(|err| {
+            if matches!(
+                err.kind(),
+                std::io::ErrorKind::NotFound | std::io::ErrorKind::ConnectionRefused
+            ) {
+                "endpoint_missing".into()
+            } else {
+                err.to_string()
+            }
+        })
+}
+
