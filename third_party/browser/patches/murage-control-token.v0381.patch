+    /// Rev B frames: a 16-character counter field that is a sign plus 15 zeros, MAC'd as n = 0.
+    fn negative_counter_frames(key: &[u8; 32], dir: u8) -> Vec<Vec<u8>> {
+        let tag = hex::encode(mac(key, &[b"ab1", &[dir], &0u64.to_be_bytes(), b"x"]));
+        ["+", "-"]
+            .iter()
+            .map(|sign| format!("ab1 {sign}000000000000000 {tag} x\n").into_bytes())
+            .collect()
+    }
