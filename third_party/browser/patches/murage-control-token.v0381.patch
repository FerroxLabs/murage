+
+    /// A peer that never finishes a proof line: it hands over ONE byte per read, after sleeping
+    /// min(its current read timeout, 4.9 s); a sleep cut short by the timeout is `TimedOut`.
+    struct DripPeer {
+        cur: std::cell::Cell<Duration>,
+        start: std::time::Instant,
+        /// (time since construction, value) of every timeout the code under test set.
+        sets: std::cell::RefCell<Vec<(Duration, Duration)>>,
+    }
+
+    impl DripPeer {
+        fn new(initial_read_timeout: Duration) -> DripPeer {
+            DripPeer {
+                cur: std::cell::Cell::new(initial_read_timeout),
+                start: std::time::Instant::now(),
+                sets: std::cell::RefCell::new(Vec::new()),
+            }
+        }
+    }
+
+    impl Timed for DripPeer {
+        fn set_read_timeout(&self, dur: Option<Duration>) -> std::io::Result<()> {
+            // `None` (no timeout at all) is recorded as a day: it can never satisfy "no more than the time left".
+            let value = dur.unwrap_or(Duration::from_secs(86_400));
+            self.cur.set(value);
+            self.sets.borrow_mut().push((self.start.elapsed(), value));
+            Ok(())
+        }
+        fn set_write_timeout(&self, _dur: Option<Duration>) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    impl std::io::Read for DripPeer {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            let current = self.cur.get();
+            let cap = Duration::from_millis(4900);
+            if current <= cap {
+                std::thread::sleep(current);
+                return Err(std::io::Error::from(std::io::ErrorKind::TimedOut));
+            }
+            std::thread::sleep(cap);
+            buf[0] = b'a';
+            Ok(1)
+        }
+    }
+
+    impl std::io::Write for DripPeer {
+        fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+            Ok(b.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn slow_peer_drip_fails_at_the_handshake_deadline() {
+        // The caller (send_command_once) has already set a 5 s read timeout before the handshake.
+        let mut peer = DripPeer::new(Duration::from_secs(5));
+        let started = std::time::Instant::now();
+        let result = client_handshake_blocking(&mut peer, &token(GOOD));
+        let elapsed = started.elapsed();
+        let err = result.err().expect("a dripping peer must fail the handshake");
+        let lower = err.to_lowercase();
+        assert!(lower.contains("timed out") || lower.contains("timeout"), "{err}");
+        assert!(
+            elapsed >= Duration::from_millis(5000) && elapsed <= Duration::from_millis(5300),
+            "the handshake must end at its 5 s deadline, took {elapsed:?}"
+        );
+        let mut previous = Duration::MAX;
+        for (at, value) in peer.sets.borrow().iter() {
+            assert!(*value <= previous, "timeouts must not grow: {value:?} after {previous:?}");
+            previous = *value;
+            let left = Duration::from_secs(5).saturating_sub(*at) + Duration::from_millis(50);
+            assert!(*value <= left, "timeout {value:?} set at {at:?} exceeds the time left ({left:?})");
+        }
+    }
