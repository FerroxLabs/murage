index 0000000..fd15a01
--- /dev/null
+++ b/cli/src/native/control_token.rs
@@ -0,0 +1,1445 @@
+// Murage patch (MURAGE-CONTROL-TOKEN): a per-launch control token for the loopback listeners.
+//
+// Threat boundary. Kept out: other OS accounts, and any loopback client (a web page that can reach
+// 127.0.0.1 included) that does not hold the token. The token reaches the engine only through the
+// environment (AGENT_BROWSER_CONTROL_TOKEN), never argv. Out of scope: same-account processes with
+// debug rights (they can read the token from the process environment) and the Chromium CDP port
+// itself (pipe mode is a separate item).
+//
+// Stream port (every platform): `Authorization: Bearer <token>` on the WebSocket handshake and on
+// every HTTP request except OPTIONS.
+// Windows daemon TCP: the token never goes over the wire. A mutual challenge-response proves both
+// sides hold it, then every line in both directions is a MAC-framed message with a counter, so a
+// process that squats the port and relays the handshake can neither inject nor alter a command.
+//
+// Every comparison is constant time (`subtle`). Missing or malformed configuration refuses: a
+// guarded listener never starts without a valid token.
+
+use hmac::{Hmac, Mac};
+use sha2::{Digest, Sha256};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::time::Duration;
+use subtle::ConstantTimeEq;
+use tokio::io::{AsyncBufRead, AsyncBufReadExt, AsyncWrite, AsyncWriteExt};
+
+pub const ENV: &str = "AGENT_BROWSER_CONTROL_TOKEN";
+
+// Rev B: one absolute deadline per phase and a hard cap on every line a daemon connection can make
+// us hold. A deadline is computed once and never refreshed by progress; every read and write spends
+// what is left of it (see `Deadline`).
+/// Handshake phase, daemon and client.
+pub const HANDSHAKE_BUDGET: Duration = Duration::from_secs(5);
+/// Daemon: one wait for a command frame (and each reply write).
+pub const FRAME_BUDGET: Duration = Duration::from_secs(30);
+/// Hello, proof and auth lines.
+pub const HANDSHAKE_LINE_MAX: usize = 4096;
+/// Payload of one client-to-daemon command.
+pub const COMMAND_PAYLOAD_MAX: usize = 16 * 1024 * 1024;
+/// Payload of one daemon-to-client reply (screenshots and network bodies are base64 inside it).
+pub const REPLY_PAYLOAD_MAX: usize = 128 * 1024 * 1024;
+/// `ab1 ` + 16 hex + space + 64 hex + space.
+pub const FRAME_PREFIX_LEN: usize = 86;
+
+/// The longest framed line (prefix, payload, newline) for a payload cap.
+pub const fn frame_line_max(payload_max: usize) -> usize {
+    FRAME_PREFIX_LEN + payload_max + 1
+}
+
+type HmacSha256 = Hmac<Sha256>;
+
+/// 32 random bytes, kept both raw (HMAC key) and as the hex string clients present.
+#[derive(Clone, PartialEq, Eq)]
+pub struct Token {
+    raw: [u8; 32],
+    hex: String,
+}
+
+impl std::fmt::Debug for Token {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Token(..)")
+    }
+}
+
+impl Token {
+    /// Exactly 64 hex characters, else None.
+    pub fn from_hex(value: &str) -> Option<Token> {
+        if value.len() != 64 {
+            return None;
+        }
+        let bytes = hex::decode(value).ok()?;
+        let raw: [u8; 32] = bytes.try_into().ok()?;
+        Some(Token {
+            raw,
+            hex: value.to_ascii_lowercase(),
+        })
+    }
+
+    pub fn as_hex(&self) -> &str {
+        &self.hex
+    }
+}
+
+/// What a guarded listener enforces.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Gate {
+    /// No token required. Only produced by `from_env` in `cfg(test)` builds when the env is unset,
+    /// and by tests that ask for it explicitly.
+    Open,
+    /// The token every client must hold.
+    Token(Token),
+    /// No valid token is configured: nothing is accepted, and a guarded listener does not start.
+    Refuse,
+}
+
+impl Gate {
+    pub fn from_env() -> Gate {
+        Gate::from_value(std::env::var_os(ENV).as_deref(), cfg!(test))
+    }
+
+    /// `value` is what the environment holds (None: unset). `open_when_unset` is true only in
+    /// test builds, so the engine's own pre-existing tests keep running without a token; a
+    /// production build refuses when unset. A present value that is not exactly 64 hex characters
+    /// (non-UTF-8 included) always refuses.
+    pub fn from_value(value: Option<&std::ffi::OsStr>, open_when_unset: bool) -> Gate {
+        match value {
+            Some(value) => match value.to_str().and_then(Token::from_hex) {
+                Some(token) => Gate::Token(token),
+                None => Gate::Refuse,
+            },
+            None if open_when_unset => Gate::Open,
+            None => Gate::Refuse,
+        }
+    }
+
+    /// Is a bearer value (the part after `Bearer `) acceptable?
+    pub fn allows_bearer(&self, presented: Option<&str>) -> bool {
+        match self {
+            Gate::Open => true,
+            Gate::Refuse => false,
+            Gate::Token(token) => match presented {
+                // Hash both sides first: the comparison length never depends on what was presented.
+                Some(value) => {
+                    let a = Sha256::digest(value.as_bytes());
+                    let b = Sha256::digest(token.hex.as_bytes());
+                    a.as_slice().ct_eq(b.as_slice()).into()
+                }
+                None => {
+                    // Same work as a real comparison, so absent and wrong look alike.
+                    let a = Sha256::digest(b"");
+                    let b = Sha256::digest(token.hex.as_bytes());
+                    let _: bool = a.as_slice().ct_eq(b.as_slice()).into();
+                    false
+                }
+            },
+        }
+    }
+
+    /// The error a guarded listener reports when it cannot start.
+    pub fn start_error(&self) -> Option<String> {
+        match self {
+            Gate::Refuse => Some(format!(
+                "{ENV} is missing or malformed (it must be 64 hex characters); the control listener was not started"
+            )),
+            _ => None,
+        }
+    }
+}
+
+/// `Authorization: Bearer <token>` header value to the token part.
+pub fn bearer_token(header_value: &str) -> Option<&str> {
+    let (scheme, rest) = header_value.trim().split_once(' ')?;
+    if scheme.eq_ignore_ascii_case("bearer") {
+        Some(rest.trim())
+    } else {
+        None
+    }
+}
+
+/// First header of that name in a raw HTTP head (request line first).
+pub fn header_value<'a>(head: &'a str, name: &str) -> Option<&'a str> {
+    // Headers end at the first empty line: nothing in a body is a header.
+    let headers = head.split("\r\n\r\n").next().unwrap_or("");
+    headers.split("\r\n").skip(1).find_map(|line| {
+        let (key, value) = line.split_once(':')?;
+        if key.trim().eq_ignore_ascii_case(name) {
+            Some(value.trim())
+        } else {
+            None
+        }
+    })
+}
+
+fn mac(key: &[u8], parts: &[&[u8]]) -> [u8; 32] {
+    let mut m = <HmacSha256 as Mac>::new_from_slice(key).expect("HMAC accepts any key length");
+    for part in parts {
+        m.update(part);
+    }
+    m.finalize().into_bytes().into()
+}
+
+fn mac_matches(expected: &[u8; 32], presented_hex: &str) -> bool {
+    match hex::decode(presented_hex) {
+        Ok(bytes) if bytes.len() == 32 => expected.as_slice().ct_eq(&bytes).into(),
+        _ => {
+            let _: bool = expected.as_slice().ct_eq(&[0u8; 32]).into();
+            false
+        }
+    }
+}
+
+fn random_hex() -> Result<String, ()> {
+    let mut bytes = [0u8; 16];
+    getrandom::getrandom(&mut bytes).map_err(|_| ())?;
+    Ok(hex::encode(bytes))
+}
+
+fn is_nonce(value: &str) -> bool {
+    value.len() == 32 && value.bytes().all(is_lower_hex)
+}
+
+/// A failure to open or seal one frame. Nothing is parsed before the MAC has passed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FrameError {
+    /// Not an `ab1` frame (prefix grammar, fixed-width hex, newline placement).
+    Grammar,
+    BadMac,
+    /// Not exactly the next counter (repeat, skip, overflow).
+    Counter,
+    /// Authentic but not UTF-8.
+    Utf8,
+    /// A payload that could not be sealed (embedded newline) or a counter that is spent.
+    Seal,
+}
+
+/// Strict lowercase-hex decoder for a fixed-width field: no sign, no whitespace, no uppercase.
+fn decode_hex_fixed<const N: usize>(field: &[u8]) -> Option<[u8; N]> {
+    if field.len() != N * 2 {
+        return None;
+    }
+    fn nibble(b: u8) -> Option<u8> {
+        match b {
+            b'0'..=b'9' => Some(b - b'0'),
+            b'a'..=b'f' => Some(b - b'a' + 10),
+            _ => None,
+        }
+    }
+    let mut out = [0u8; N];
+    for (i, pair) in field.chunks_exact(2).enumerate() {
+        out[i] = (nibble(pair[0])? << 4) | nibble(pair[1])?;
+    }
+    Some(out)
+}
+
+fn is_lower_hex(b: u8) -> bool {
+    matches!(b, b'0'..=b'9' | b'a'..=b'f')
+}
+
+/// Is `b` allowed at byte `pos` of the 86-byte frame prefix?
+fn prefix_byte_ok(pos: usize, b: u8) -> bool {
+    match pos {
+        0 => b == b'a',
+        1 => b == b'b',
+        2 => b == b'1',
+        3 => b == b' ',
+        4..=19 => is_lower_hex(b),
+        20 => b == b' ',
+        21..=84 => is_lower_hex(b),
+        85 => b == b' ',
+        _ => true,
+    }
+}
+
+/// One authenticated connection. Post-handshake wire line, both directions:
+/// `ab1 <n: 16 lowercase hex> <mac: 64 lowercase hex> <payload, no newline>\n`
+/// with `mac = HMAC-SHA256(K, "ab1" || dir || n as 8 big-endian bytes || payload)`.
+pub struct Session {
+    key: [u8; 32],
+    send_dir: u8,
+    recv_dir: u8,
+    send_n: u64,
+    recv_n: u64,
+}
+
+impl Session {
+    fn new(key: [u8; 32], client_side: bool) -> Session {
+        Session {
+            key,
+            send_dir: if client_side { b'c' } else { b's' },
+            recv_dir: if client_side { b's' } else { b'c' },
+            send_n: 0,
+            recv_n: 0,
+        }
+    }
+
+    /// The whole wire line (newline included) for one message.
+    pub fn seal(&mut self, payload: &str) -> Result<Vec<u8>, FrameError> {
+        if payload.as_bytes().contains(&b'\n') {
+            return Err(FrameError::Seal);
+        }
+        let n = self.send_n;
+        let next = n.checked_add(1).ok_or(FrameError::Seal)?;
+        let tag = mac(
+            &self.key,
+            &[b"ab1", &[self.send_dir], &n.to_be_bytes(), payload.as_bytes()],
+        );
+        let line = format!("ab1 {:016x} {} {}\n", n, hex::encode(tag), payload);
+        self.send_n = next;
+        Ok(line.into_bytes())
+    }
+
+    /// The message inside one wire line (newline included), in this order and no other:
+    /// (1) grammar, (2) strict hex decode, (3) MAC over the raw payload bytes, constant time,
+    /// (4) the counter is exactly the next one, (5) only now UTF-8. State advances only on success.
+    pub fn open(&mut self, line: &[u8]) -> Result<String, FrameError> {
+        // (1) grammar
+        if line.len() <= FRAME_PREFIX_LEN || line[line.len() - 1] != b'\n' {
+            return Err(FrameError::Grammar);
+        }
+        if !line[..FRAME_PREFIX_LEN]
+            .iter()
+            .enumerate()
+            .all(|(i, &b)| prefix_byte_ok(i, b))
+        {
+            return Err(FrameError::Grammar);
+        }
+        let payload = &line[FRAME_PREFIX_LEN..line.len() - 1];
+        if payload.contains(&b'\n') {
+            return Err(FrameError::Grammar);
+        }
+        // (2) decode
+        let n_bytes: [u8; 8] = decode_hex_fixed(&line[4..20]).ok_or(FrameError::Grammar)?;
+        let presented: [u8; 32] = decode_hex_fixed(&line[21..85]).ok_or(FrameError::Grammar)?;
+        // (3) MAC
+        let expected = mac(
+            &self.key,
+            &[b"ab1", &[self.recv_dir], &n_bytes, payload],
+        );
+        if !bool::from(expected.as_slice().ct_eq(presented.as_slice())) {
+            return Err(FrameError::BadMac);
+        }
+        // (4) counter
+        let n = u64::from_be_bytes(n_bytes);
+        if n != self.recv_n {
+            return Err(FrameError::Counter);
+        }
+        let next = self.recv_n.checked_add(1).ok_or(FrameError::Counter)?;
+        // (5) UTF-8
+        let message = std::str::from_utf8(payload).map_err(|_| FrameError::Utf8)?;
+        self.recv_n = next;
+        Ok(message.to_string())
+    }
+
+    /// Test adapters, shared by name with the tests that ran against the previous frame format.
+    #[cfg(test)]
+    pub fn open_bytes(&mut self, line: &[u8]) -> Result<String, FrameError> {
+        self.open(line)
+    }
+
+    #[cfg(test)]
+    pub fn seal_bytes(&mut self, payload: &str) -> Vec<u8> {
+        self.seal(payload).expect("seal")
+    }
+}
+
+// ---- deadlines, bounded line reading, bounded writing ----
+
+/// An absolute point in time, computed once. Tokio is built without `test-util`, so there is no
+/// paused clock: timing tests run on real time with short injected budgets.
+#[derive(Clone, Copy, Debug)]
+pub struct Deadline(tokio::time::Instant);
+
+impl Deadline {
+    pub fn after(budget: Duration) -> Deadline {
+        Deadline(tokio::time::Instant::now() + budget)
+    }
+
+    pub fn at(&self) -> tokio::time::Instant {
+        self.0
+    }
+
+    /// What is left, or `TimedOut` when it is zero or past (std refuses a zero socket timeout).
+    pub fn remaining(&self) -> Result<Duration, ReadError> {
+        let now = tokio::time::Instant::now();
+        if now >= self.0 {
+            Err(ReadError::TimedOut)
+        } else {
+            Ok(self.0 - now)
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ReadError {
+    TimedOut,
+    TooLong,
+    Closed,
+    BadFrame,
+    Io(std::io::ErrorKind),
+}
+
+/// Socket timeouts, so a blocking reader or writer can spend only what is left of a deadline.
+pub trait Timed {
+    fn set_read_timeout(&self, dur: Option<Duration>) -> std::io::Result<()>;
+    fn set_write_timeout(&self, dur: Option<Duration>) -> std::io::Result<()>;
+}
+
+impl Timed for std::net::TcpStream {
+    fn set_read_timeout(&self, dur: Option<Duration>) -> std::io::Result<()> {
+        std::net::TcpStream::set_read_timeout(self, dur)
+    }
+    fn set_write_timeout(&self, dur: Option<Duration>) -> std::io::Result<()> {
+        std::net::TcpStream::set_write_timeout(self, dur)
+    }
+}
+
+impl<T: Timed + ?Sized> Timed for &mut T {
+    fn set_read_timeout(&self, dur: Option<Duration>) -> std::io::Result<()> {
+        (**self).set_read_timeout(dur)
+    }
+    fn set_write_timeout(&self, dur: Option<Duration>) -> std::io::Result<()> {
+        (**self).set_write_timeout(dur)
+    }
+}
+
+/// What kind of line a reader expects.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Grammar {
+    /// Any bytes up to a newline; end of input before the newline is `Closed`.
+    Line,
+    /// As `Line`, but a final unterminated line at end of input is returned (the plain Unix
+    /// socket's upstream behaviour).
+    LineOrEof,
+    /// An `ab1` frame: each of the first 86 bytes is checked as it arrives.
+    Framed,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Step {
+    NeedMore(usize),
+    Done(usize),
+    Reject(ReadError, usize),
+}
+
+/// The pure core of every bounded line read. It copies bytes up to and including the first
+/// newline, never lets `buf` exceed `max` (the cap counts the whole line, prefix and newline
+/// included), and grows only with bytes that actually arrived.
+pub struct LineAccumulator {
+    buf: Vec<u8>,
+    max: usize,
+    grammar: Grammar,
+}
+
+impl LineAccumulator {
+    pub fn new(max: usize, grammar: Grammar) -> LineAccumulator {
+        LineAccumulator {
+            buf: Vec::new(),
+            max: max.max(1),
+            grammar,
+        }
+    }
+
+    pub fn partial(&self) -> &[u8] {
+        &self.buf
+    }
+
+    pub fn into_bytes(self) -> Vec<u8> {
+        self.buf
+    }
+
+    pub fn feed(&mut self, available: &[u8]) -> Step {
+        let mut used = 0usize;
+        while used < available.len() {
+            let pos = self.buf.len();
+            if self.grammar == Grammar::Framed && pos < FRAME_PREFIX_LEN {
+                let b = available[used];
+                used += 1;
+                if !prefix_byte_ok(pos, b) {
+                    return Step::Reject(ReadError::BadFrame, used);
+                }
+                self.buf.push(b);
+                if self.buf.len() >= self.max {
+                    return Step::Reject(ReadError::TooLong, used);
+                }
+                continue;
+            }
+            // `pos < max` always holds here: reaching the cap without a newline returns below.
+            let room = self.max - pos;
+            let end = used + room.min(available.len() - used);
+            let window = &available[used..end];
+            match window.iter().position(|&b| b == b'\n') {
+                Some(i) => {
+                    self.buf.extend_from_slice(&window[..=i]);
+                    used += i + 1;
+                    return Step::Done(used);
+                }
+                None => {
+                    self.buf.extend_from_slice(window);
+                    used += window.len();
+                    if self.buf.len() >= self.max {
+                        return Step::Reject(ReadError::TooLong, used);
+                    }
+                }
+            }
+        }
+        Step::NeedMore(used)
+    }
+}
+
+/// Async bounded line read. With a deadline every wait is `timeout_at` (absolute by construction).
+pub async fn read_line_by<R: AsyncBufRead + Unpin>(
+    reader: &mut R,
+    max: usize,
+    grammar: Grammar,
+    deadline: Option<Deadline>,
+) -> Result<Vec<u8>, ReadError> {
+    let mut acc = LineAccumulator::new(max, grammar);
+    loop {
+        let step = {
+            let filled = match deadline {
+                Some(d) => {
+                    d.remaining()?;
+                    match tokio::time::timeout_at(d.at(), reader.fill_buf()).await {
+                        Ok(result) => result,
+                        Err(_) => return Err(ReadError::TimedOut),
+                    }
+                }
+                None => reader.fill_buf().await,
+            };
+            let available = filled.map_err(|e| ReadError::Io(e.kind()))?;
+            if available.is_empty() {
+                return if grammar == Grammar::LineOrEof && !acc.partial().is_empty() {
+                    Ok(acc.into_bytes())
+                } else {
+                    Err(ReadError::Closed)
+                };
+            }
+            acc.feed(available)
+        };
+        match step {
+            Step::NeedMore(n) => reader.consume(n),
+            Step::Done(n) => {
+                reader.consume(n);
+                return Ok(acc.into_bytes());
+            }
+            Step::Reject(e, n) => {
+                reader.consume(n);
+                return Err(e);
+            }
+        }
+    }
+}
+
+/// Blocking bounded line read: before every `fill_buf` the socket timeout is set to what is left
+/// of the deadline, so a peer that drips bytes cannot hold the caller past it.
+pub fn read_line_by_blocking<S: Read + Timed>(
+    reader: &mut BufReader<S>,
+    max: usize,
+    grammar: Grammar,
+    deadline: Deadline,
+) -> Result<Vec<u8>, ReadError> {
+    let mut acc = LineAccumulator::new(max, grammar);
+    loop {
+        let left = deadline.remaining()?;
+        reader
+            .get_ref()
+            .set_read_timeout(Some(left))
+            .map_err(|e| ReadError::Io(e.kind()))?;
+        let step = {
+            let available = match reader.fill_buf() {
+                Ok(a) => a,
+                Err(e) => match e.kind() {
+                    std::io::ErrorKind::Interrupted => continue,
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut => {
+                        return Err(ReadError::TimedOut)
+                    }
+                    kind => return Err(ReadError::Io(kind)),
+                },
+            };
+            if available.is_empty() {
+                return if grammar == Grammar::LineOrEof && !acc.partial().is_empty() {
+                    Ok(acc.into_bytes())
+                } else {
+                    Err(ReadError::Closed)
+                };
+            }
+            acc.feed(available)
+        };
+        match step {
+            Step::NeedMore(n) => reader.consume(n),
+            Step::Done(n) => {
+                reader.consume(n);
+                return Ok(acc.into_bytes());
+            }
+            Step::Reject(e, n) => {
+                reader.consume(n);
+                return Err(e);
+            }
+        }
+    }
+}
+
+/// Blocking write of the whole buffer under one deadline: a loop of single `write` calls, each
+/// preceded by the remaining-time timeout (std `write_all` would give every inner write the full one).
+pub fn write_all_by<S: Write + Timed>(
+    stream: &mut S,
+    mut buf: &[u8],
+    deadline: Deadline,
+) -> Result<(), ReadError> {
+    while !buf.is_empty() {
+        let left = deadline.remaining()?;
+        stream
+            .set_write_timeout(Some(left))
+            .map_err(|e| ReadError::Io(e.kind()))?;
+        match stream.write(buf) {
+            Ok(0) => return Err(ReadError::Closed),
+            Ok(n) => buf = &buf[n..],
+            Err(e) => match e.kind() {
+                std::io::ErrorKind::Interrupted => continue,
+                std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut => {
+                    return Err(ReadError::TimedOut)
+                }
+                kind => return Err(ReadError::Io(kind)),
+            },
+        }
+    }
+    Ok(())
+}
+
+/// Async write of the whole buffer under one absolute deadline.
+pub async fn write_all_async_by<W: AsyncWrite + Unpin>(
+    writer: &mut W,
+    buf: &[u8],
+    deadline: Deadline,
+) -> Result<(), ReadError> {
+    let write = async {
+        writer.write_all(buf).await?;
+        writer.flush().await
+    };
+    deadline.remaining()?;
+    match tokio::time::timeout_at(deadline.at(), write).await {
+        Ok(result) => result.map_err(|e| ReadError::Io(e.kind())),
+        Err(_) => Err(ReadError::TimedOut),
+    }
+}
+
+/// Socket timeout for one command's reply. Ordinary commands get a 30s floor. Commands carrying an
+/// operation timeout (the wait family, which parse_command stamps with AGENT_BROWSER_DEFAULT_TIMEOUT
+/// when no explicit --timeout is given) get that timeout plus margin, so the daemon can report a
+/// proper operation timeout instead of the client giving up at 30s and the retry loop re-sending the
+/// whole long-running command.
+///
+/// The env var is deliberately NOT consulted here. Reading it would apply a long wait budget to
+/// every command, so a genuinely hung daemon on a simple `url`/`title`/`snapshot` call would take the
+/// full budget to surface instead of 30s. Only commands that actually carry a `timeout` field get the
+/// extended budget, and that field is set client-side per invocation.
+pub fn reply_budget(cmd: &serde_json::Value) -> Duration {
+    let mut op_ms = cmd.get("timeout").and_then(|v| v.as_u64()).unwrap_or(0);
+    if cmd.get("action").and_then(serde_json::Value::as_str) == Some("mousemove") {
+        op_ms = op_ms.max(
+            cmd.get("duration")
+                .and_then(serde_json::Value::as_u64)
+                .unwrap_or(0),
+        );
+    }
+    Duration::from_millis(op_ms.saturating_add(10_000).max(30_000))
+}
+
+// ---- handshake state machine (pure; the I/O wrappers below are thin) ----
+
+pub struct ClientPending {
+    cn: String,
+}
+
+pub struct ServerPending {
+    cn: String,
+    sn: String,
+}
+
+/// Client step 1: the hello line to send.
+pub fn client_hello() -> Result<(String, ClientPending), ()> {
+    let cn = random_hex()?;
+    let line = serde_json::json!({ "hello": cn }).to_string();
+    Ok((line, ClientPending { cn }))
+}
+
+/// Client step 2: check the server's proof BEFORE sending anything else; on success the auth line
+/// to send and the session.
+pub fn client_finish(
+    token: &Token,
+    pending: &ClientPending,
+    server_line: &str,
+) -> Result<(String, Session), ()> {
+    let value: serde_json::Value = serde_json::from_str(server_line.trim()).map_err(|_| ())?;
+    let proof = value.get("proof").and_then(|v| v.as_str()).ok_or(())?;
+    let sn = value.get("nonce").and_then(|v| v.as_str()).ok_or(())?;
+    if !is_nonce(sn) {
+        return Err(());
+    }
+    let expected = mac(&token.raw, &[b"srv", pending.cn.as_bytes()]);
+    if !mac_matches(&expected, proof) {
+        return Err(());
+    }
+    let auth = mac(&token.raw, &[b"cli", sn.as_bytes(), pending.cn.as_bytes()]);
+    let key = mac(&token.raw, &[b"key", pending.cn.as_bytes(), sn.as_bytes()]);
+    Ok((
+        serde_json::json!({ "auth": hex::encode(auth) }).to_string(),
+        Session::new(key, true),
+    ))
+}
+
+/// Server step 1: answer a hello with the proof and a fresh nonce.
+pub fn server_reply(token: &Token, hello_line: &str) -> Result<(String, ServerPending), ()> {
+    let value: serde_json::Value = serde_json::from_str(hello_line.trim()).map_err(|_| ())?;
+    let cn = value.get("hello").and_then(|v| v.as_str()).ok_or(())?;
+    if !is_nonce(cn) {
+        return Err(());
+    }
+    let sn = random_hex()?;
+    let proof = mac(&token.raw, &[b"srv", cn.as_bytes()]);
+    let line = serde_json::json!({ "proof": hex::encode(proof), "nonce": sn }).to_string();
+    Ok((
+        line,
+        ServerPending {
+            cn: cn.to_string(),
+            sn,
+        },
+    ))
+}
+
+/// Server step 2: the client's auth line decides.
+pub fn server_finish(
+    token: &Token,
+    pending: &ServerPending,
+    auth_line: &str,
+) -> Result<Session, ()> {
+    let value: serde_json::Value = serde_json::from_str(auth_line.trim()).map_err(|_| ())?;
+    let presented = value.get("auth").and_then(|v| v.as_str()).ok_or(())?;
+    let expected = mac(
+        &token.raw,
+        &[b"cli", pending.sn.as_bytes(), pending.cn.as_bytes()],
+    );
+    if !mac_matches(&expected, presented) {
+        return Err(());
+    }
+    let key = mac(
+        &token.raw,
+        &[b"key", pending.cn.as_bytes(), pending.sn.as_bytes()],
+    );
+    Ok(Session::new(key, false))
+}
+
+/// Why a blocking handshake read or write failed, as the CLI reports it.
+pub fn handshake_error_text(e: ReadError) -> String {
+    match e {
+        ReadError::TimedOut => {
+            "control_handshake_timeout: the daemon handshake timed out".to_string()
+        }
+        ReadError::TooLong => {
+            "control_frame_too_large: a daemon handshake line exceeded its limit".to_string()
+        }
+        ReadError::Closed => "Daemon closed the connection during the handshake".to_string(),
+        ReadError::BadFrame => {
+            "control_token_mismatch: the daemon sent an invalid handshake line".to_string()
+        }
+        ReadError::Io(kind) => format!("Failed to talk to the daemon during the handshake: {kind}"),
+    }
+}
+
+/// Daemon side of the Windows TCP handshake. Nothing is read as a command before this succeeds.
+/// `deadline` is taken in the accept loop the moment `accept()` returns, so scheduling delay counts.
+pub async fn server_handshake_by<R, W>(
+    reader: &mut R,
+    writer: &mut W,
+    token: &Token,
+    deadline: Deadline,
+) -> Result<Session, ReadError>
+where
+    R: AsyncBufRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    let hello = read_line_by(reader, HANDSHAKE_LINE_MAX, Grammar::Line, Some(deadline)).await?;
+    let hello = String::from_utf8(hello).map_err(|_| ReadError::BadFrame)?;
+    let (reply, pending) = server_reply(token, &hello).map_err(|_| ReadError::BadFrame)?;
+    write_all_async_by(writer, format!("{reply}\n").as_bytes(), deadline).await?;
+    let auth = read_line_by(reader, HANDSHAKE_LINE_MAX, Grammar::Line, Some(deadline)).await?;
+    let auth = String::from_utf8(auth).map_err(|_| ReadError::BadFrame)?;
+    server_finish(token, &pending, &auth).map_err(|_| ReadError::BadFrame)
+}
+
+/// `server_handshake_by` with a deadline built on entry (tests; production passes the accept-loop one).
+pub async fn server_handshake<R, W>(
+    reader: &mut R,
+    writer: &mut W,
+    token: &Token,
+) -> Result<Session, ReadError>
+where
+    R: AsyncBufRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    server_handshake_by(reader, writer, token, Deadline::after(HANDSHAKE_BUDGET)).await
+}
+
+/// Async client side (the stream port's `/api/command` forwarding). `deadline` is taken the moment
+/// `connect` returns and covers every handshake read and write.
+pub async fn client_handshake_async_by<R, W>(
+    reader: &mut R,
+    writer: &mut W,
+    token: &Token,
+    deadline: Deadline,
+) -> Result<Session, ReadError>
+where
+    R: AsyncBufRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    let (hello, pending) = client_hello().map_err(|_| ReadError::BadFrame)?;
+    write_all_async_by(writer, format!("{hello}\n").as_bytes(), deadline).await?;
+    let reply = read_line_by(reader, HANDSHAKE_LINE_MAX, Grammar::Line, Some(deadline)).await?;
+    let reply = String::from_utf8(reply).map_err(|_| ReadError::BadFrame)?;
+    let (auth, session) =
+        client_finish(token, &pending, &reply).map_err(|_| ReadError::BadFrame)?;
+    write_all_async_by(writer, format!("{auth}\n").as_bytes(), deadline).await?;
+    Ok(session)
+}
+
+pub async fn client_handshake_async<R, W>(
+    reader: &mut R,
+    writer: &mut W,
+    token: &Token,
+) -> Result<Session, ReadError>
+where
+    R: AsyncBufRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    client_handshake_async_by(reader, writer, token, Deadline::after(HANDSHAKE_BUDGET)).await
+}
+
+/// Blocking client side (the CLI). The stream is only written to after the server's proof checks.
+/// The caller keeps the one `BufReader` for the whole connection, so the framed reply is read from
+/// the same buffer as the handshake reply.
+pub fn client_handshake_blocking_by<S: Read + Write + Timed>(
+    reader: &mut BufReader<S>,
+    token: &Token,
+    deadline: Deadline,
+) -> Result<Session, String> {
+    let (hello, pending) = client_hello().map_err(|_| "Failed to start handshake".to_string())?;
+    write_all_by(reader.get_mut(), format!("{hello}\n").as_bytes(), deadline)
+        .map_err(handshake_error_text)?;
+    let reply = read_line_by_blocking(reader, HANDSHAKE_LINE_MAX, Grammar::Line, deadline)
+        .map_err(handshake_error_text)?;
+    let reply = String::from_utf8(reply).map_err(|_| "Invalid handshake reply".to_string())?;
+    let (auth, session) = client_finish(token, &pending, &reply).map_err(|_| {
+        "control_token_mismatch: the daemon did not prove the control token".to_string()
+    })?;
+    write_all_by(reader.get_mut(), format!("{auth}\n").as_bytes(), deadline)
+        .map_err(handshake_error_text)?;
+    Ok(session)
+}
+
+/// `client_handshake_blocking_by` over a bare stream with a deadline built on entry.
+pub fn client_handshake_blocking<S: Read + Write + Timed>(
+    stream: &mut S,
+    token: &Token,
+) -> Result<Session, String> {
+    let deadline = Deadline::after(HANDSHAKE_BUDGET);
+    let mut reader = BufReader::new(stream);
+    client_handshake_blocking_by(&mut reader, token, deadline)
+}
+
+/// Unix: the socket directory must belong to this user and be closed to group and other.
+#[cfg(unix)]
+pub fn check_private_dir(dir: &std::path::Path) -> Result<(), String> {
+    use std::os::unix::fs::MetadataExt;
+    let meta = std::fs::symlink_metadata(dir)
+        .map_err(|e| format!("Socket directory {} is not readable: {}", dir.display(), e))?;
+    if !meta.is_dir() {
+        return Err(format!("{} is not a directory", dir.display()));
+    }
+    // SAFETY: geteuid has no preconditions.
+    let euid = unsafe { libc::geteuid() };
+    if meta.uid() != euid {
+        return Err(format!(
+            "Socket directory {} is not owned by this user",
+            dir.display()
+        ));
+    }
+    if meta.mode() & 0o077 != 0 {
+        return Err(format!(
+            "Socket directory {} must not be accessible to group or other (mode {:o})",
+            dir.display(),
+            meta.mode() & 0o7777
+        ));
+    }
+    Ok(())
+}
