+        const GOOD: &str = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+        // Kernel socket buffers on loopback (send plus receive, both sides) may hold unread bytes.
+        const SOCKET_SLACK: usize = 32 * 1024 * 1024;
+
+        fn token() -> Token {
