+        let mut split = LineAccumulator::new(10, Grammar::Line);
+        assert_eq!(split.feed(b"123456"), Step::NeedMore(6));
+        assert_eq!(split.feed(b"7890xx"), Step::Reject(ReadError::TooLong, 4));
+        // A newline at the 11th byte is too late.
+        let mut late = LineAccumulator::new(10, Grammar::Line);
+        assert_eq!(late.feed(b"1234567890\n"), Step::Reject(ReadError::TooLong, 10));
+        // Bytes after the newline are left for the next line.
+        let mut two = LineAccumulator::new(10, Grammar::Line);
+        assert_eq!(two.feed(b"ab\ncd\n"), Step::Done(3));
