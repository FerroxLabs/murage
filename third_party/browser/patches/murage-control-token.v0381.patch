+    // ---- rev B tests: textually identical on 1ccca49 + the test-only shim and on rev B ----
+
+    #[tokio::test]
+    async fn oversized_unterminated_frame_after_relayed_handshake_is_cut_off() {
+        // The daemon BufReader and the rig's duplex buffer may hold bytes the daemon never consumed.
+        const BUFREADER_CAP: usize = 8192;
+        const DUPLEX_CAP: usize = 65536;
+        let rig = rig();
+        tokio::time::sleep(Duration::from_millis(80)).await;
+        let (reader, mut writer) = tokio::io::split(rig.client);
+        let mut reader = BufReader::new(reader);
+        let token = Token::from_hex(TOKEN).unwrap();
+        // A real handshake, standing in for one a squatter relayed.
+        let _session = client_handshake_async(&mut reader, &mut writer, &token)
+            .await
+            .expect("handshake");
+        let prefix = format!("ab1 {} {} ", "0".repeat(16), "0".repeat(64));
+        assert_eq!(prefix.len(), 86);
+        let chunk = vec![b'a'; 65536];
+        let mut remaining = COMMAND_PAYLOAD_MAX + 1024 * 1024;
+        let mut accepted = 0usize;
+        let mut write_failed = false;
+        let guard = tokio::time::timeout(Duration::from_secs(20), async {
+            if writer.write_all(prefix.as_bytes()).await.is_err() {
+                write_failed = true;
+                return;
+            }
+            accepted += prefix.len();
+            while remaining > 0 {
+                let n = remaining.min(chunk.len());
+                if writer.write_all(&chunk[..n]).await.is_err() {
+                    write_failed = true;
+                    return;
+                }
+                accepted += n;
+                remaining -= n;
+            }
+        })
+        .await;
+        assert!(guard.is_ok(), "the daemon stopped reading but kept the connection open");
+        assert!(write_failed, "the daemon accepted {accepted} bytes of one unterminated line");
+        let limit = 86 + COMMAND_PAYLOAD_MAX + 1 + BUFREADER_CAP + DUPLEX_CAP;
+        assert!(accepted <= limit, "accepted {accepted} bytes, more than {limit}");
+        tokio::time::timeout(Duration::from_secs(2), rig.task)
+            .await
