+        assert_eq!(s.open_bytes(tampered.as_bytes()), Err(FrameError::BadMac));
+        assert_eq!(s.open_bytes(&third).unwrap(), "three");
+        // an unframed command line, and a legacy JSON frame
+        assert_eq!(s.open_bytes(b"{\"id\":\"1\",\"action\":\"close\"}\n"), Err(FrameError::Grammar));
+        assert_eq!(s.open_bytes(b"garbage\n"), Err(FrameError::Grammar));
+        // a client's own line reflected back to it is the wrong direction
+        let (s2, c2) = handshake_pair(&token(GOOD), &token(GOOD));
+        let (_s2, mut c2) = (s2.unwrap(), c2.unwrap());
