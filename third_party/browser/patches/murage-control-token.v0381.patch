+    #[tokio::test]
+    async fn daemon_frame_drip_fails_at_the_frame_deadline() {
+        // A peer that completes a real handshake and then sends one byte every 250 ms of a frame that
+        // never ends must not hold the connection past the frame deadline (injected as 600 ms).
+        let rig = rig_with(Duration::from_millis(600));
+        let (reader, mut writer) = tokio::io::split(rig.client);
+        let mut reader = BufReader::new(reader);
+        let token = Token::from_hex(TOKEN).unwrap();
+        let _session = client_handshake_async(&mut reader, &mut writer, &token)
+            .await
+            .expect("handshake");
+        let started = std::time::Instant::now();
+        let prefix = format!("ab1 {} {} ", "0".repeat(16), "0".repeat(64)).into_bytes();
+        let drip = tokio::spawn(async move {
+            for byte in prefix.iter().cycle().take(40) {
+                if writer.write_all(&[*byte]).await.is_err() {
+                    return;
+                }
+                tokio::time::sleep(Duration::from_millis(250)).await;
+            }
+        });
