+// Murage patch tests: the stream port refuses every client that does not hold the control token.
+
+use super::*;
+use crate::native::control_token::{Gate, Token};
+use futures_util::StreamExt;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio_tungstenite::tungstenite::client::IntoClientRequest;
+use tokio_tungstenite::tungstenite::Message;
+
+const TOKEN: &str = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+const OTHER: &str = "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100";
+
+async fn gated_server() -> StreamServer {
+    let (server, _slot) = StreamServer::start_without_client_with_gate(
+        0,
+        "ctl".to_string(),
+        true,
+        Arc::new(IdleActivity::new()),
+        Gate::Token(Token::from_hex(TOKEN).unwrap()),
+    )
+    .await
+    .expect("server start");
+    server
+}
+
+async fn raw(port: u16, request: &[u8]) -> String {
+    let mut stream = tokio::net::TcpStream::connect(("127.0.0.1", port))
+        .await
+        .expect("connect");
+    stream.write_all(request).await.expect("write");
+    let mut out = Vec::new();
+    let _ = tokio::time::timeout(Duration::from_secs(8), stream.read_to_end(&mut out)).await;
+    String::from_utf8_lossy(&out).to_string()
+}
+
+fn status_line(response: &str) -> &str {
+    response.lines().next().unwrap_or("")
+}
+
+async fn ws(
+    port: u16,
+    bearer: Option<&str>,
+) -> Result<
+    tokio_tungstenite::WebSocketStream<tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>>,
+    tokio_tungstenite::tungstenite::Error,
+> {
+    let mut request = format!("ws://127.0.0.1:{port}/")
+        .into_client_request()
+        .unwrap();
+    if let Some(token) = bearer {
+        request
+            .headers_mut()
+            .insert("authorization", format!("Bearer {token}").parse().unwrap());
+    }
+    tokio_tungstenite::connect_async(request)
+        .await
+        .map(|(socket, _)| socket)
+}
+
+fn refused_with_401<T>(result: Result<T, tokio_tungstenite::tungstenite::Error>) -> bool {
+    matches!(
+        result,
+        Err(tokio_tungstenite::tungstenite::Error::Http(response)) if response.status().as_u16() == 401
+    )
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn tokenless_websocket_is_refused_before_any_frame() {
+    let server = gated_server().await;
+    server.broadcast_frame(r#"{"type":"frame","data":"secret"}"#);
+    assert!(refused_with_401(ws(server.port(), None).await));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn wrong_token_websocket_is_refused() {
+    let server = gated_server().await;
+    assert!(refused_with_401(ws(server.port(), Some(OTHER)).await));
+    assert!(refused_with_401(
+        ws(server.port(), Some(&TOKEN[..63])).await
+    ));
+    assert!(refused_with_401(ws(server.port(), Some("")).await));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn right_token_websocket_is_accepted_and_frames_flow() {
+    let server = gated_server().await;
+    server.broadcast_frame(r#"{"type":"frame","data":"fresh"}"#);
+    let mut socket = ws(server.port(), Some(TOKEN)).await.expect("accepted");
+    let mut saw_frame = false;
+    for _ in 0..10 {
+        let message = tokio::time::timeout(Duration::from_secs(5), socket.next())
+            .await
+            .expect("timed out")
+            .expect("ended")
+            .expect("ws error");
+        if let Message::Text(text) = message {
+            let parsed: Value = serde_json::from_str(&text).unwrap();
+            if parsed.get("type").and_then(|v| v.as_str()) == Some("frame") {
+                assert_eq!(parsed.get("data").and_then(|v| v.as_str()), Some("fresh"));
