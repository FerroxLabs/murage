+        fn fake_daemon<T: Send + 'static>(
+            then: impl FnOnce(TcpStream, Session) -> T + Send + 'static,
+        ) -> (std::net::SocketAddr, std::thread::JoinHandle<T>) {
+            let listener = TcpListener::bind("127.0.0.1:0").unwrap();
