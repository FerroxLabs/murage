+        "GET /api/tabs HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".to_string(),
+        "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".to_string(),
+        format!(
+            "POST /api/command HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nOrigin: http://127.0.0.1:{port}\r\nContent-Type: application/json\r\nContent-Length: 20\r\n\r\n{{\"action\":\"close\"}}  "
+        ),
+    ] {
+        let response = raw(port, request.as_bytes()).await;
+        assert!(status_line(&response).contains("401"), "{request}\n=> {response}");
+        assert!(!response.contains("Access-Control-Allow-Origin"));
+    }
+    // A wrong token is the same refusal.
+    let wrong = format!("GET /api/status HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer {OTHER}\r\n\r\n");
+    assert!(status_line(&raw(port, wrong.as_bytes()).await).contains("401"));
+    // A non-bearer scheme is not a token either.
+    let basic = format!("GET /api/status HTTP/1.1\r\nHost: x\r\nAuthorization: Basic {TOKEN}\r\n\r\n");
+    assert!(status_line(&raw(port, basic.as_bytes()).await).contains("401"));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn an_authorization_line_in_the_body_does_not_authenticate() {
+    let server = gated_server().await;
+    let body = format!("Authorization: Bearer {TOKEN}\r\n\r\n");
+    let request = format!(
+        "POST /api/command HTTP/1.1\r\nHost: x\r\nContent-Length: {}\r\n\r\n{body}",
+        body.len()
+    );
+    assert!(status_line(&raw(server.port(), request.as_bytes()).await).contains("401"));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn right_token_http_is_served_and_options_still_answers() {
+    let server = gated_server().await;
+    let port = server.port();
+    let ok = format!("GET /api/status HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer {TOKEN}\r\nConnection: close\r\n\r\n");
+    assert!(status_line(&raw(port, ok.as_bytes()).await).contains("200"));
+    let options = "OPTIONS /api/status HTTP/1.1\r\nHost: x\r\n\r\n";
+    assert!(status_line(&raw(port, options.as_bytes()).await).contains("204"));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn a_head_split_across_writes_is_still_read_whole() {
+    let server = gated_server().await;
+    let mut stream = tokio::net::TcpStream::connect(("127.0.0.1", server.port()))
+        .await
+        .unwrap();
+    stream.write_all(b"GET /api/status HTTP/1.1\r\nHost: x\r\n").await.unwrap();
+    tokio::time::sleep(Duration::from_millis(150)).await;
+    stream
+        .write_all(format!("Authorization: Bearer {TOKEN}\r\nConnection: close\r\n\r\n").as_bytes())
+        .await
+        .unwrap();
+    let mut out = Vec::new();
+    let _ = tokio::time::timeout(Duration::from_secs(8), stream.read_to_end(&mut out)).await;
+    assert!(String::from_utf8_lossy(&out).starts_with("HTTP/1.1 200"));
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn an_oversized_head_is_refused_not_trusted() {
+    let server = gated_server().await;
+    let mut head = format!("GET /api/status HTTP/1.1\r\nHost: x\r\nX-Pad: {}", "a".repeat(9000));
+    head.push_str(&format!("\r\nAuthorization: Bearer {TOKEN}\r\n\r\n"));
+    let response = raw(server.port(), head.as_bytes()).await;
+    assert!(status_line(&response).contains("400"), "{response}");
+    server.shutdown().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn no_valid_token_means_no_listener() {
+    let result = StreamServer::start_without_client_with_gate(
+        0,
+        "ctl-refuse".to_string(),
+        true,
+        Arc::new(IdleActivity::new()),
+        Gate::Refuse,
+    )
+    .await;
+    assert!(result.is_err());
+}
