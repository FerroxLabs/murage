+/// Peek (consume nothing) until the request head is complete. A head that is not complete within
+/// the deadline, or does not fit, is None. `peek` returns at once with bytes already seen, so a
+/// short sleep (not the peek) is what keeps this from spinning.
+async fn peek_head(stream: &TcpStream, buf: &mut [u8; HEAD_MAX]) -> Option<usize> {
+    tokio::time::timeout(HEAD_DEADLINE, async {
+        loop {
+            let n = stream.peek(&mut buf[..]).await.ok()?;
+            if n == 0 {
+                return None;
+            }
+            if buf[..n].windows(4).any(|w| w == b"\r\n\r\n") {
+                return Some(n);
+            }
+            if n == HEAD_MAX {
+                return None;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .ok()
+    .flatten()
