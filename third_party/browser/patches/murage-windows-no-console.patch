diff --git a/cli/src/native/no_console.rs b/cli/src/native/no_console.rs
new file mode 100644
index 0000000..376963a
--- /dev/null
+++ b/cli/src/native/no_console.rs
@@ -0,0 +1,28 @@
+//! Murage patch (0.36.0-omb.3): keep child consoles from appearing on Windows.
+//!
+//! The daemon is started with DETACHED_PROCESS, so it owns no console. Every console-subsystem program it
+//! then spawns (chrome-headless-shell.exe, ffmpeg, aws, this executable itself) makes Windows allocate a
+//! brand new console window unless the spawn passes CREATE_NO_WINDOW. These helpers add that flag on
+//! Windows and do nothing elsewhere, so Unix process-group handling is untouched.
+
+#[cfg(windows)]
+const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+/// Sets CREATE_NO_WINDOW on Windows; use only on commands with no other creation flags.
+pub fn hide_std(cmd: &mut std::process::Command) -> &mut std::process::Command {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(CREATE_NO_WINDOW);
+    }
+    cmd
+}
+
+/// Sets CREATE_NO_WINDOW on Windows; use only on commands with no other creation flags.
+pub fn hide_tokio(cmd: &mut tokio::process::Command) -> &mut tokio::process::Command {
+    #[cfg(windows)]
+    {
+        cmd.creation_flags(CREATE_NO_WINDOW);
+    }
+    cmd
+}
