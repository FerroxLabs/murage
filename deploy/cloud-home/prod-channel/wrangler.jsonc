// PRODUCTION. Deploy from this directory with the production Cloudflare token (account b83123326a4b9ad76831b9cb9365b33b, zone murage.ai):
//   wrangler deploy --config wrangler.jsonc
// The bucket must exist first (wrangler r2 bucket create murage-prod-releases). The channel is the custom domain releases.murage.ai, which is
// what the prod image pin names; there is no workers.dev name.
{
  "name": "murage-prod-releases",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "account_id": "b83123326a4b9ad76831b9cb9365b33b",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "releases.murage.ai", "custom_domain": true }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "murage-prod-releases" }]
}
