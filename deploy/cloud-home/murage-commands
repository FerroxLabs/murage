class Unsupported(Exception):
    pass


class Expired(Exception):
    """The command's run deadline passed before an irreversible step: nothing more is done."""


def before_deadline(ctx, command):
    if ctx["now"]() >= command["expiresAt"]:
        raise Expired()


# ---- strict command shapes ------------------------------------------------------------------------------------------

def _exact(value, fields):
    if not isinstance(value, dict) or set(value) != set(fields):
        raise Unsupported()

def _int(value, minimum=0):
    return type(value) is int and minimum <= value <= MAX_SAFE

def _reason(payload):
    _exact(payload, ("reason",))
    if not isinstance(payload["reason"], str) or not REASON.fullmatch(payload["reason"]):
        raise Unsupported()

def _update(payload):
    # "sequence" is the release the rollout controller (or the customer's Update button, which carries the fleet's latest PROMOTED
    # sequence) wants installed. It is required: a command without one would install whatever the channel serves, which during a
    # rollout is the release the waves have not promoted yet. run_update refuses any other sequence.
    _exact(payload, ("keep", "reason", "sequence"))
    if not _int(payload["sequence"], 1):
        raise Unsupported()
    if payload["keep"] != ["files", "settings", "logins"] or not isinstance(payload["reason"], str) or not REASON.fullmatch(payload["reason"]):
        raise Unsupported()

def _reset(payload):
    _exact(payload, ("resetId", "from", "snapshotFirst", "snapshotTag", "keepSnapshotDays"))
    if (not isinstance(payload["resetId"], str) or not UUID.fullmatch(payload["resetId"]) or payload["from"] != "last_good_backup"
            or payload["snapshotFirst"] is not True or payload["snapshotTag"] != PRE_RESET_TAG + "-" + payload["resetId"]
            or not _int(payload["keepSnapshotDays"], 7) or payload["keepSnapshotDays"] > 30):
        raise Unsupported()

def _undo(payload):
    _exact(payload, ("resetId", "snapshotTag"))
    if (not isinstance(payload["resetId"], str) or not UUID.fullmatch(payload["resetId"])
            or payload["snapshotTag"] != PRE_RESET_TAG + "-" + payload["resetId"]):
        raise Unsupported()

def _logs(payload):
    _exact(payload, ("maxLines", "redact", "chatContent"))
    if not _int(payload["maxLines"], 1) or payload["maxLines"] > LOG_CHUNK * LOG_CHUNKS or payload["redact"] is not True or payload["chatContent"] is not False:
        raise Unsupported()

def _export(payload):
    _exact(payload, ("requestId", "deliverBy", "format", "path", "maxBytes"))
    rid = payload["requestId"]
    if (not isinstance(rid, str) or not REQUEST_ID.fullmatch(rid) or not _int(payload["deliverBy"], 1)
            or payload["format"] != "tar.zst.age" or payload["path"] != "exports/%s/archive.tar.zst.age" % rid
            or not _int(payload["maxBytes"], 1)):
        raise Unsupported()

SHAPES = {"restart_service": _reason, "safe_mode": _reason, "update_software": _update, "reset_from_backup": _reset,
          "undo_reset": _undo, "collect_logs": _logs, "export_archive": _export}

def command_envelope(value):
    """The outer command. A malformed id cannot be acknowledged, so it is skipped (None)."""
    if (not isinstance(value, dict) or set(value) != {"id", "kind", "payload", "issuedAt", "expiresAt"}
            or not isinstance(value["id"], str) or not UUID.fullmatch(value["id"]) or not _int(value["expiresAt"], 1)):
        return None
    return value


# ---- transport ------------------------------------------------------------------------------------------------------

OPERATIONS = {"commands": "GET", "commands/ack": "POST", "logs": "POST", "export-ready": "POST", "update-state": "POST"}

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *_args, **_kwargs):
        raise ValueError("Redirect refused")

def machine_request(binding, operation, body=None):
    method = OPERATIONS.get(operation)
    if method is None or (method == "GET") != (body is None):
        raise ValueError("Invalid command operation")
    url = binding["adminUrl"] + "/v1/machines/" + binding["homeId"] + "/" + operation
    headers = {"Authorization": "Bearer " + binding["credential"], "Content-Type": "application/json", "User-Agent": "murage-home/1"}
    request = urllib.request.Request(url, headers=headers, method=method,
                                     data=None if body is None else json.dumps(body, allow_nan=False).encode())
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(request, timeout=30) as response:
        raw = response.read(262145)
        if response.status not in (200, 202) or len(raw) > 262144:
            raise ValueError("Command response refused")
    return strict_json(raw.decode("utf-8"))

def strict_json(raw):
    def pairs(items):
        result = {}
        for name, value in items:
            if name in result:
                raise ValueError("Duplicate field")
            result[name] = value
        return result
    return json.loads(raw, object_pairs_hook=pairs, parse_constant=lambda _v: (_ for _ in ()).throw(ValueError("Invalid number")))

def fetch(url, destination=None, limit=65536):
    """HTTPS only, no proxy, no redirect. Returns bytes, or streams to destination and returns its sha256 hex."""
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError("Release URL refused")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(urllib.request.Request(url, headers={"User-Agent": "murage-home/1"}), timeout=60) as response:
        if response.status != 200:
            raise ValueError("Release fetch refused")
        if destination is None:
            raw = response.read(limit + 1)
            if len(raw) > limit:
                raise ValueError("Oversize release file")
            return raw
        digest, total = hashlib.sha256(), 0
        with open(destination, "wb") as out:
            while True:
                chunk = response.read(1 << 20)
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("Oversize release archive")
                digest.update(chunk)
                out.write(chunk)
        return digest.hexdigest(), total


# ---- host operations (each replaceable in tests) ----------------------------------------------------------------------

def run_process(argv, env=None, stdin=None, limit=8 << 20, timeout=None):
    """An argument vector, never a shell. Output is returned (capped), never logged."""
    if not isinstance(argv, list) or not all(isinstance(a, str) and "\0" not in a for a in argv):
        raise ValueError("Invalid argument vector")
    process = subprocess.Popen(argv, stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, env=env if env is not None else {"PATH": "/usr/bin:/bin"}, close_fds=True)
    try:
        out, _ = process.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        return 124, b""
    return process.returncode, out[:limit]

def systemctl(*args):
    return run_process(["/usr/bin/systemctl"] + list(args), timeout=300)[0]

def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module

def unit_state(unit):
    """systemd's ActiveState of a unit ("active", "inactive", "deactivating", "failed", ...); "unknown" when it cannot be read."""
    code, out = run_process(["/usr/bin/systemctl", "show", "-p", "ActiveState", "--value", unit], timeout=60)
    value = out.decode(errors="replace").strip() if code == 0 else ""
    return value if re.fullmatch(r"[a-z-]{1,32}", value) else "unknown"

def disk_free(target):
    info = os.statvfs(target)
    return info.f_bavail * info.f_frsize

def default_context(binding, backup_module=None, control_module=None):
    def app_healthy():
        # The Murage app answering /api/health through Caddy (murage-control's probe), never the unit merely running.
        return bool(control_module and control_module.app_responding(binding.get("publicOrigin", "")))
    return {"binding": binding, "request": machine_request, "systemctl": systemctl, "run": run_process, "fetch": fetch,
            "now": lambda: int(time.time() * 1000), "sleep": time.sleep, "backup": backup_module,
            "upload": upload_export, "environs": process_environs, "unit_state": unit_state, "app_healthy": app_healthy,
            "disk_free": disk_free, "spawn": subprocess.Popen, "verify": verify_signature, "peer": peer_identity, "gate": None,
            "paths": {"data": DATA, "state": STATE, "config": CONFIG, "run": RUN, "libexec": LIBEXEC, "releases": RELEASES,
                      "update_state": UPDATE_STATE, "trust": TRUST, "gate": GATE_RUN}}

def path(ctx, name, *rest):
    return os.path.join(ctx["paths"][name], *rest)


# ---- journal: every command id runs at most once ------------------------------------------------------------------------

def journal_file(ctx, command_id):
    return path(ctx, "state", "commands", command_id + ".json")

def journal_read(ctx, command_id):
    try:
        with open(journal_file(ctx, command_id), "rb") as handle:
            return json.loads(handle.read(65536))
    except FileNotFoundError:
        return None

def write_private(target, value):
    """Durable once it returns: the file's data is fsynced, it is renamed into place, and then its directory is fsynced, so the new
    entry itself survives a power cut (fsync of the file alone does not persist the rename). Every record the runner relies on after a
    crash (the start inhibition, swap phases, journals, results) is written this way, before the step that depends on it."""
    directory = os.path.dirname(target)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
        fsync_dir(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def journal_claim(ctx, command_id, record):
    target = journal_file(ctx, command_id)
    os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(record, handle)
        handle.flush()
        os.fsync(handle.fileno())
    fsync_dir(os.path.dirname(target))

def journal_prune(ctx, keep_ms=30 * 86400000):
    directory = path(ctx, "state", "commands")
    cutoff = ctx["now"]() - keep_ms
    for name in os.listdir(directory) if os.path.isdir(directory) else []:
        record = journal_read(ctx, name[:-5]) if name.endswith(".json") else None
        if record and record.get("state") == "finished" and record.get("acked") and record.get("startedAt", 0) < cutoff:
            os.unlink(os.path.join(directory, name))


# ---- the poll -----------------------------------------------------------------------------------------------------------

def poll_once(ctx):
    binding = ctx["binding"]
    response = ctx["request"](binding, "commands")
    _exact_or_error(response, ("homeId", "generation", "pollEveryMs", "commands"))
    if (response["homeId"] != binding["homeId"] or response["generation"] != binding["generation"]
            or not isinstance(response["commands"], list) or len(response["commands"]) > 10):
        raise ValueError("Command list refused")
    handled = []
    for raw in response["commands"]:
        command = command_envelope(raw)
        if command is None:
            continue
        handled.append((command["kind"] if command["kind"] in SHAPES else "unknown", handle(ctx, command)))
    return handled

def _exact_or_error(value, fields):
    if not isinstance(value, dict) or set(value) != set(fields):
        raise ValueError("Command response refused")

def handle(ctx, command):
    cid, kind = command["id"], command["kind"]
    record = journal_read(ctx, cid)
    if record is None:
        record = {"kind": kind if kind in SHAPES else "unknown", "state": "running", "startedAt": ctx["now"](), "acked": False,
                  "deadline": command["expiresAt"]}
        payload = command.get("payload")
        if kind in ("reset_from_backup", "undo_reset") and isinstance(payload, dict) and isinstance(payload.get("resetId"), str) \
                and UUID.fullmatch(payload["resetId"]):
            record["resetId"] = payload["resetId"]  # what start-up recovery needs, nothing more
        journal_claim(ctx, cid, record)
        try:
            if kind not in SHAPES:
                raise Unsupported()
            SHAPES[kind](command["payload"])
            before_deadline(ctx, command)  # never started after its run deadline
            if kind in BLOCKED_BY_RECOVERY and recovery_pending(ctx):
                raise Blocked()  # an unfinished reset/undo recovery or an update in flight owns the home: no conflicting work until it completes
            outcome = RUNNERS[kind](ctx, command)
        except Unsupported:
            outcome = "unsupported"
        except Exception:
            outcome = "failed"
        if kind == "update_software" and update_inflight_for(ctx, cid):
            # The update is in flight (verify, rollback, or Stuck): its command stays "running", never acked; driven every loop and at start.
            print("Self-service recovery pending", file=sys.stderr)
            return "pending"
        if swap_state(ctx, record) in ("swap", "committed"):
            # Data may be swapped in with sign-ins not yet carried, or a rollback not finished: never reported as done (or failed).
            # The command stays "running" with its swap record; recovery is retried every loop and at start.
            print("Self-service recovery pending", file=sys.stderr)
            return "pending"
        if outcome == "failed" and swap_state(ctx, record) == "carried":
            outcome = "done"  # fully installed (sign-ins carried): whatever failed after that, the reset (or undo) happened
        record.update(state="finished", outcome=outcome)
        if outcome == "reported":  # logs / export-ready acknowledged it
            record.update(outcome="done", acked=True)
        write_private(journal_file(ctx, cid), record)
        forget_results(ctx, cid, record)
    elif record.get("state") == "running":
        # Interrupted (crash, stop, power loss): never run again. A reset or undo is finished or rolled back first.
        try:
            outcome = recover(ctx, record, command, cid)
        except Exception:
            print("Self-service recovery pending", file=sys.stderr)
            return "pending"  # still "running": retried on the next poll and at start, never reported as a guess
        record.update(state="finished", outcome=outcome)
        write_private(journal_file(ctx, cid), record)
        forget_results(ctx, cid, record)
    if not record.get("acked"):
        acknowledge(ctx, cid, record)
    print("Self-service command %s: %s" % (record["kind"], record["outcome"]), file=sys.stderr)
    return record["outcome"]

def _swap_of(record):
    reset_id = record.get("resetId")
    if record.get("kind") in ("reset_from_backup", "undo_reset") and isinstance(reset_id, str) and UUID.fullmatch(reset_id):
        return reset_id, "undo" if record["kind"] == "undo_reset" else "reset"
    return None

class Blocked(Exception):
    """A data command arrived while a reset or undo recovery is unfinished."""

DATA_KINDS = ("reset_from_backup", "undo_reset", "update_software", "export_archive")
# Restart and safe mode would start the home's writers under an unfinished recovery: refused like data work.
BLOCKED_BY_RECOVERY = DATA_KINDS + ("restart_service", "safe_mode")

def swap_state(ctx, record):
    """The phase of this command's swap record: None (no swap began), "swap", "committed", "carried" or "rolled_back".
    An unreadable record counts as unfinished."""
    swap = _swap_of(record)
    try:
        found = read_swap(ctx, *swap) if swap else None
    except ValueError:
        return "swap"
    return found["phase"] if found else None

def recovery_pending(ctx):
    """True while the home must not be started by this runner and no data command may run: an update in flight, a journal or trust root
    that cannot be validated, a release layout the phase-aware predicate refuses (fail closed: the only False is an explicit, fully
    validated "no inflight, layout sane, every swap terminal"), or any reset or undo whose swap is not finished (installed with sign-ins
    carried, or rolled back). A query: it never stops anything (the driver does)."""
    try:
        state = read_update_state(ctx)
        layout_ok(state, current_target(ctx), SlotEnv(ctx, release_config(ctx)))
    except (Stuck, LayoutRefused, OSError, ValueError):
        return True
    if state["inflight"] is not None:
        return True
    directory = path(ctx, "state", "commands")
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        if not name.endswith(".json"):
            continue
        record = journal_read(ctx, name[:-5])
        if isinstance(record, dict) and record.get("state") == "running" and swap_state(ctx, record) in ("swap", "committed"):
            return True
    swaps = path(ctx, "state", "swaps")
    for name in os.listdir(swaps) if os.path.isdir(swaps) else []:
        try:
            with open(os.path.join(swaps, name), "rb") as handle:
                if json.loads(handle.read(1 << 20)).get("phase") in ("swap", "committed"):
                    return True
        except (OSError, ValueError, AttributeError):
            return True
    return False

def forget_results(ctx, cid, record):
    forget_swaps(ctx, record)  # the update journal's lastResult is never unlinked: the next update overwrites it

def forget_swaps(ctx, record):
    """The swap record outlives the staging tree until the terminal outcome is journaled (never before), and is kept while any
    staging is left (a rollback that needs a person)."""
    swap = _swap_of(record)
    if swap and not os.path.isdir(work_dir(ctx, *swap)):
        try:
            os.unlink(swap_record(ctx, *swap))
        except FileNotFoundError:
            pass

def retry_unacknowledged(ctx):
    """Finished results the control plane has not acknowledged are re-sent on their own, whether or not the command is still listed
    (a reset that happened must never stay reported as failed or lost because a poll stopped listing it)."""
    directory = path(ctx, "state", "commands")
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        if not name.endswith(".json") or not UUID.fullmatch(name[:-5]):
            continue
        record = journal_read(ctx, name[:-5])
        if isinstance(record, dict) and record.get("state") == "finished" and not record.get("acked") \
                and record.get("outcome") in ("done", "failed", "unsupported"):
            acknowledge(ctx, name[:-5], record)

def acknowledge(ctx, cid, record):
    try:
        answer = ctx["request"](ctx["binding"], "commands/ack",
                                {"generation": ctx["binding"]["generation"], "commandId": cid, "outcome": record["outcome"]})
        if answer != {"acknowledged": True}:
            return
    except urllib.error.HTTPError as error:
        if error.code not in (404, 409):  # gone or stale: nothing more to tell
            return
    except Exception:
        return  # the command stays listed; the next poll acknowledges again without running it
    record["acked"] = True
    write_private(journal_file(ctx, cid), record)

def recover(ctx, record, command=None, cid=None):
    reset_id = record.get("resetId")
    if reset_id is None and command is not None and isinstance(command.get("payload"), dict):
        reset_id = command["payload"].get("resetId")
    if record.get("kind") in ("reset_from_backup", "undo_reset") and isinstance(reset_id, str) and UUID.fullmatch(reset_id):
        # An error here propagates: the command stays "running" with its swap record, and recovery is tried again (never guessed).
        outcome = recover_swap(ctx, reset_id, "undo" if record["kind"] == "undo_reset" else "reset")
        if outcome == "done" and record["kind"] == "reset_from_backup":
            try:
                keep_snapshot_from_now(ctx, reset_id)
            except Exception:
                pass  # the record written before the swap still keeps the snapshot keepSnapshotDays from the request
        return outcome
    if record.get("kind") in ("reset_from_backup", "undo_reset"):
        start_home(ctx)  # no reset id recorded: nothing was swapped
    if record.get("kind") == "update_software":
        # Keyed to the command: pending (raised) while its update is in flight, else the journal's recorded outcome for this id.
        return recover_update(ctx, cid)
    if record.get("kind") == "export_archive":
        clean_export_staging(ctx)
    if record.get("kind") == "safe_mode":
        remove_flag(ctx)
    return "failed"

def recover_interrupted(ctx):
    """At start: every journaled command still "running" was interrupted. Resets and undos are rolled back or finished now,
    whether or not the control plane still lists them (it may have failed the job already); each is then reported once."""
    directory = path(ctx, "state", "commands")
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        if not name.endswith(".json") or not UUID.fullmatch(name[:-5]):
            continue
        record = journal_read(ctx, name[:-5])
        if not isinstance(record, dict) or record.get("state") != "running":
            continue
        try:
            outcome = recover(ctx, record, None, name[:-5])
        except Exception:
            print("Self-service recovery pending", file=sys.stderr)
            continue
        record.update(state="finished", outcome=outcome)
        write_private(journal_file(ctx, name[:-5]), record)
        forget_results(ctx, name[:-5], record)
        acknowledge(ctx, name[:-5], record)


# ---- restart and safe mode ------------------------------------------------------------------------------------------------

def flag_path(ctx):
    return path(ctx, "run", "murage-safe-mode")

def remove_flag(ctx):
    try:
        os.unlink(flag_path(ctx))
    except FileNotFoundError:
        pass

def wait_active(ctx, seconds=90):
    for _ in range(max(1, seconds // 3)):
        if ctx["systemctl"]("is-active", "--quiet", HOME_UNIT) == 0:
            return True
        ctx["sleep"](3)
    return False

def restart_home(ctx, safe=False):
    remove_flag(ctx)
    if safe:
        # start-home.sh consumes the flag on the next start: safe mode lasts until the next restart.
        fd = os.open(flag_path(ctx), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.write(fd, b"1\n")
        os.close(fd)
    if ctx["systemctl"]("restart", HOME_UNIT) != 0 or not wait_active(ctx):
        remove_flag(ctx)
        return "failed"
    return "done"

def run_restart(ctx, _command):
    return restart_home(ctx)

def run_safe_mode(ctx, _command):
    return restart_home(ctx, safe=True)


# ---- update ---------------------------------------------------------------------------------------------------------------
# Lane G (lanes/cloud-v2/LANE-G-UPDATE-STATE-MACHINE r2, r3, Amendment A1): two release trees side by side under
# /opt/murage-releases/{A,B}, one atomic flip of the `current` link, every write by this runner. The journal
# /var/lib/murage-update/state.json is the one authoritative record; its phases are installing | installed | flip | verify |
# rollback. Root in the home unit is image code only (murage-home-launch), so nothing a release ships can write the journal, the trust
# root or a slot. In verify and rollback the launcher starts slot code only on a one-shot grant from this process (the gate), and
# every grant follows a counter write, so each start of a not yet verified tree is counted. The launcher and this runner share one
# layout predicate (layout_ok, byte-identical in both files), one seal walk and one journal shape (the block marked "shared" below).

RELEASE_FORMAT = "murage-cloud-home-release-v3"
UPDATE_STATE_FORMAT = "murage-cloud-home-update-state-v3"
PHASES = ("installing", "installed", "flip", "verify", "rollback")
VERIFY_ATTEMPTS, ROLLBACK_ATTEMPTS = 2, 3
HOME_CGROUP = "0::/system.slice/murage-home.service"
GATE_REQUEST_MAX = 256
TRUST_FIELDS = ("channelUrl", "minimumSequence", "imageRevision", "launcherAbi")

# ==== shared with deploy/cloud-home/murage-home-launch.py: byte-identical (T-S4) ====
SLOTS = ("A", "B")
FS_IOC_GETFLAGS, FS_IOC_SETFLAGS, FS_IMMUTABLE_FL = 0x80086601, 0x40086602, 0x00000010
SLOT_OPEN = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
SEAL_OWNER = 0  # the owner every sealed inode must have; a test run without root models it as its own uid
FILE_OPEN = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
MANIFEST_FIELDS = ("format", "sequence", "revision", "arch", "archive", "bytes", "sha256", "treeSha256", "launcherAbi")
JOURNAL_FIELDS = ("format", "installed", "inflight", "lastResult")
INSTALLED_FIELDS = ("slot", "sequence", "revision")
INFLIGHT_FIELDS = ("commandId", "slot", "sequence", "revision", "phase", "verifyAttempts", "rollbackAttempts", "restored", "startedAt",
                   "deadline", "driveId", "reason")
RESULT_FIELDS = ("commandId", "outcome", "reason")
MAX_SAFE_INT = 9007199254740991


class LayoutRefused(Exception):
    """code: home_layout_mismatch | slot_seal_failed, the fixed token the launcher prints and the updater's Stuck carries."""
    def __init__(self, code):
        super().__init__(code)
        self.code = code


def inode_flags(fd):
    """The FS_IOC_GETFLAGS word; 0 on a filesystem without inode flags (nothing there can be immutable)."""
    flags = bytearray(8)
    try:
        fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags)
    except OSError as error:
        if error.errno in (errno.ENOTTY, errno.EOPNOTSUPP, errno.EINVAL):
            return 0
        raise
    return int.from_bytes(flags[:4], sys.byteorder)


def manifest_json(raw):
    """JSON with duplicate fields and non-finite numbers refused."""
    def pairs(items):
        result = {}
        for name, value in items:
            if name in result:
                raise ValueError("Duplicate field")
            result[name] = value
        return result
    return json.loads(raw, object_pairs_hook=pairs, parse_constant=lambda _v: (_ for _ in ()).throw(ValueError("Invalid number")))


def _bounded(value, minimum, maximum=MAX_SAFE_INT):
    return type(value) is int and minimum <= value <= maximum


def parse_manifest(raw, arch):
    """A release manifest (v3), strictly: exact field set, shapes and bounds. The signature is the caller's business. A manifest of
    another format raises ValueError("release_format"), anything else ValueError("release_manifest")."""
    manifest = manifest_json(raw.decode("utf-8"))
    if not isinstance(manifest, dict) or set(manifest) != set(MANIFEST_FIELDS):
        raise ValueError("release_manifest")
    if manifest["format"] != "murage-cloud-home-release-v3":
        raise ValueError("release_format")
    if (not _bounded(manifest["sequence"], 1) or not isinstance(manifest["revision"], str) or not re.fullmatch(r"[0-9a-f]{40}", manifest["revision"])
            or manifest["arch"] != arch or not isinstance(manifest["archive"], str)
            or not re.fullmatch(r"murage-cloud-home-[A-Za-z0-9._-]{1,100}\.tar\.gz", manifest["archive"])
            or not _bounded(manifest["bytes"], 1, 4 << 30) or not isinstance(manifest["sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", manifest["sha256"])
            or not isinstance(manifest["treeSha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", manifest["treeSha256"])
            or not isinstance(manifest["launcherAbi"], str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", manifest["launcherAbi"])):
        raise ValueError("release_manifest")
    return manifest


def parse_update_state(raw):
    """The journal (state.json, v3), strictly: anything but the exact shape raises ValueError."""
    state = manifest_json(raw.decode("utf-8"))
    if not isinstance(state, dict) or set(state) != set(JOURNAL_FIELDS) or state["format"] != "murage-cloud-home-update-state-v3":
        raise ValueError("update_state")
    installed = state["installed"]
    if (not isinstance(installed, dict) or set(installed) != set(INSTALLED_FIELDS) or installed["slot"] not in ("A", "B")
            or not _bounded(installed["sequence"], 1) or not isinstance(installed["revision"], str) or not re.fullmatch(r"[0-9a-f]{40}", installed["revision"])):
        raise ValueError("update_state")
    inflight = state["inflight"]
    if inflight is not None:
        if (not isinstance(inflight, dict) or set(inflight) != set(INFLIGHT_FIELDS)
                or not isinstance(inflight["commandId"], str) or not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", inflight["commandId"])
                or inflight["slot"] not in ("A", "B") or not _bounded(inflight["sequence"], 1)
                or not isinstance(inflight["revision"], str) or not re.fullmatch(r"[0-9a-f]{40}", inflight["revision"])
                or inflight["phase"] not in ("installing", "installed", "flip", "verify", "rollback")
                or not _bounded(inflight["verifyAttempts"], 0, 2) or not _bounded(inflight["rollbackAttempts"], 0, 3)
                or type(inflight["restored"]) is not bool or not _bounded(inflight["startedAt"], 0) or not _bounded(inflight["deadline"], 1)
                or not isinstance(inflight["driveId"], str) or not re.fullmatch(r"[0-9a-f]{32}", inflight["driveId"])
                or not (inflight["reason"] is None or (isinstance(inflight["reason"], str) and re.fullmatch(r"[a-z_]{1,64}", inflight["reason"])))):
            raise ValueError("update_state")
    result = state["lastResult"]
    if result is not None:
        if (not isinstance(result, dict) or set(result) != set(RESULT_FIELDS)
                or not isinstance(result["commandId"], str) or not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", result["commandId"])
                or result["outcome"] not in ("done", "failed")
                or not (result["reason"] is None or (isinstance(result["reason"], str) and re.fullmatch(r"[a-z_]{1,64}", result["reason"])))):
            raise ValueError("update_state")
    return state


def read_trust(trust):
    """The image-owned trust root: a 0700 root directory carrying FS_IMMUTABLE_FL, the Ed25519 public key, release.json (channel, the
    image's sequence floor, the image revision, the launcher ABI) and launcher-abi (the same token). Anything else raises."""
    info = os.lstat(trust)
    fd = os.open(trust, SLOT_OPEN)
    try:
        flags = inode_flags(fd)
    finally:
        os.close(fd)
    if not stat.S_ISDIR(info.st_mode) or (info.st_uid != 0 and os.geteuid() == 0) or stat.S_IMODE(info.st_mode) != 0o700 or not flags & FS_IMMUTABLE_FL:
        raise ValueError("trust_root")
    key = os.path.join(trust, "release-public-key.pem")
    key_info = os.lstat(key)
    if not stat.S_ISREG(key_info.st_mode) or key_info.st_mode & 0o022 or key_info.st_size == 0 or key_info.st_size > 4096:
        raise ValueError("trust_root")
    fd = os.open(os.path.join(trust, "release.json"), FILE_OPEN)
    with os.fdopen(fd, "rb") as handle:
        raw = handle.read(4097)
    config = manifest_json(raw.decode("utf-8")) if len(raw) <= 4096 else None
    if not isinstance(config, dict) or set(config) != {"channelUrl", "minimumSequence", "imageRevision", "launcherAbi"}:
        raise ValueError("trust_root")
    if (not isinstance(config["channelUrl"], str) or not _bounded(config["minimumSequence"], 1)
            or not isinstance(config["imageRevision"], str) or not re.fullmatch(r"[0-9a-f]{40}", config["imageRevision"])
            or not isinstance(config["launcherAbi"], str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", config["launcherAbi"])):
        raise ValueError("trust_root")
    fd = os.open(os.path.join(trust, "launcher-abi"), FILE_OPEN)
    with os.fdopen(fd, "rb") as handle:
        abi = handle.read(256)
    if abi.decode("utf-8", errors="replace").strip() != config["launcherAbi"]:
        raise ValueError("trust_root")
    return {"channelUrl": config["channelUrl"], "key": key, "minimumSequence": config["minimumSequence"], "imageRevision": config["imageRevision"],
            "launcherAbi": config["launcherAbi"]}


def links_stay_inside(links):
    """Resolves every symlink component by component through the other links of the tree (rel path -> target text); False when any
    link, followed through the links it crosses, leaves the tree or loops. A lexical check alone misses `a/b/l/../..` where l is
    itself a link that climbs to the top."""
    for rel, target in links.items():
        parent = rel.split("/")[:-1]
        stack, pending, hops = list(parent), target.split("/"), 0
        while pending:
            part = pending.pop(0)
            if part in ("", "."):
                continue
            if part == "..":
                if not stack:
                    return False
                stack.pop()
                continue
            stack.append(part)
            crossed = "/".join(stack)
            if crossed in links:
                hops += 1
                if hops > 40:
                    return False
                stack.pop()
                pending = links[crossed].split("/") + pending
    return True


def seal_walk_digest(dirfd, sealed):
    """The canonical digest of the tree under dirfd, read only through O_NOFOLLOW descriptors (a path is never re-resolved): sorted
    relative paths; per entry type NUL path NUL mode NUL, then size NUL content-sha256 NUL for a file or the link target NUL for a
    symlink (a symlink is never flagged, sealed or not, and is resolved through the other links of the tree); modes normalised to 0755/0644 as safe_extract writes them. With sealed, every directory and regular file (the root
    included) must be uid 0, not group/world writable and carry FS_IMMUTABLE_FL, and no symlink may point outside the tree; a failure
    raises LayoutRefused("slot_seal_failed"). An entry of any other type is refused the same way."""
    entries = []

    def refuse():
        raise LayoutRefused("slot_seal_failed")

    def inspect(fd, info):
        if sealed and (info.st_uid != SEAL_OWNER or info.st_mode & 0o022 or not inode_flags(fd) & FS_IMMUTABLE_FL):
            refuse()

    def walk(fd, prefix):
        inspect(fd, os.fstat(fd))
        for name in sorted(os.listdir(fd)):
            rel = prefix + name
            info = os.lstat(name, dir_fd=fd)
            if stat.S_ISLNK(info.st_mode):
                target = os.readlink(name, dir_fd=fd)
                resolved = os.path.normpath(os.path.join(os.path.dirname(rel), target))
                if "\0" in target or target.startswith("/") or resolved == ".." or resolved.startswith("../"):
                    refuse()
                entries.append(("l", rel, target))
            elif stat.S_ISDIR(info.st_mode):
                child = os.open(name, SLOT_OPEN, dir_fd=fd)
                try:
                    walk(child, rel + "/")
                finally:
                    os.close(child)
                entries.append(("d", rel, "0755"))
            elif stat.S_ISREG(info.st_mode):
                child = os.open(name, FILE_OPEN, dir_fd=fd)
                try:
                    detail = os.fstat(child)
                    if not stat.S_ISREG(detail.st_mode):
                        refuse()
                    inspect(child, detail)
                    digest = hashlib.sha256()
                    with os.fdopen(child, "rb", closefd=False) as stream:
                        for chunk in iter(lambda: stream.read(1 << 20), b""):
                            digest.update(chunk)
                finally:
                    os.close(child)
                entries.append(("f", rel, "0755" if detail.st_mode & 0o111 else "0644", str(detail.st_size), digest.hexdigest()))
            else:
                refuse()

    walk(dirfd, "")
    if not links_stay_inside({entry[1]: entry[2] for entry in entries if entry[0] == "l"}):
        refuse()
    total = hashlib.sha256()
    for entry in sorted(entries, key=lambda item: item[1]):
        total.update("\0".join(entry).encode() + b"\0")
    return total.hexdigest()


def verified_slot(env, name):
    """Slot `name` through its own descriptor: sealed (seal walk), its stored manifest signature-verified (env.manifest) and the tree
    digest equal to the manifest's treeSha256. Returns the manifest; raises LayoutRefused."""
    try:
        fd = env.open_slot(name)
    except OSError:
        raise LayoutRefused("home_layout_mismatch") from None
    try:
        digest = seal_walk_digest(fd, True)
    finally:
        os.close(fd)
    try:
        manifest = env.manifest(name)
    except (OSError, ValueError):
        raise LayoutRefused("home_layout_mismatch") from None
    if manifest["treeSha256"] != digest:
        raise LayoutRefused("slot_seal_failed")
    return manifest


def layout_ok(state, current, env):
    """[A1] The phase-aware layout predicate, one function in murage-home-launch and murage-commands. state: the strict journal;
    current: what the `current` link names; env: open_slot(name) -> dirfd, manifest(name) -> the signature-verified stored manifest,
    trust -> {"minimumSequence", "launcherAbi"}. Committed group (no update in flight, or one before the flip): `current` is the
    installed slot, sealed, and its signed sequence is the journal's and at or above the image floor. Transition group (flip, verify,
    rollback): `current` is within what the phase allows, the candidate differs from the installed slot, and BOTH slots are sealed and
    matched to their own signed manifests, the candidate's to the in-flight record, the trust ABI and the sequence floor. Returns
    {slot: manifest} for the slots it verified; raises LayoutRefused(home_layout_mismatch | slot_seal_failed) for any other shape."""
    installed, inflight = state["installed"], state["inflight"]
    live = installed["slot"]
    if current not in ("A", "B"):
        raise LayoutRefused("home_layout_mismatch")
    phase = inflight["phase"] if inflight is not None else None
    if phase in (None, "installing", "installed"):
        if current != live:
            raise LayoutRefused("home_layout_mismatch")
        committed = verified_slot(env, live)
        if committed["sequence"] != installed["sequence"] or committed["sequence"] < env.trust["minimumSequence"]:
            raise LayoutRefused("home_layout_mismatch")
        return {live: committed}
    candidate = inflight["slot"]
    allowed = {"flip": (live, candidate), "verify": (candidate,), "rollback": (live,) if inflight["restored"] else (live, candidate)}
    if candidate == live or phase not in allowed or current not in allowed[phase]:
        raise LayoutRefused("home_layout_mismatch")
    committed = verified_slot(env, live)
    if committed["sequence"] != installed["sequence"] or committed["sequence"] < env.trust["minimumSequence"]:
        raise LayoutRefused("home_layout_mismatch")
    incoming = verified_slot(env, candidate)
    if (incoming["sequence"] != inflight["sequence"] or incoming["revision"] != inflight["revision"] or incoming["launcherAbi"] != env.trust["launcherAbi"]
            or incoming["sequence"] <= max(env.trust["minimumSequence"], committed["sequence"])):
        raise LayoutRefused("home_layout_mismatch")
    return {live: committed, candidate: incoming}
