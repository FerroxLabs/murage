BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"

def _polymod(values):
    generator = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]
    check = 1
    for value in values:
        top = check >> 25
        check = (check & 0x1ffffff) << 5 ^ value
        for i in range(5):
            check ^= generator[i] if ((top >> i) & 1) else 0
    return check

def age_identity(key):
    """The age X25519 identity for 32 secret bytes (AGE-SECRET-KEY-1..., bech32)."""
    hrp, data, acc, bits = "age-secret-key-", [], 0, 0
    for byte in key:
        acc, bits = (acc << 8) | byte, bits + 8
        while bits >= 5:
            bits -= 5
            data.append((acc >> bits) & 31)
    if bits:
        data.append((acc << (5 - bits)) & 31)
    expanded = [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp]
    polymod = _polymod(expanded + data + [0] * 6) ^ 1
    checksum = [(polymod >> 5 * (5 - i)) & 31 for i in range(6)]
    return (hrp + "1" + "".join(BECH32[d] for d in data + checksum)).upper()

def export_rules(ctx):
    """backup-excludes.txt (the same list the backup refuses to run without) plus the export-only skips."""
    with open(path(ctx, "config", "backup-excludes.txt")) as handle:
        patterns = [l.strip() for l in handle if l.strip() and not l.startswith("#")]
    backup = ctx["backup"]
    if any(r not in patterns for r in backup.REQUIRED_EXCLUDES):
        raise ValueError("Exclusion list incomplete")
    expressions = []
    for pattern in patterns:
        body = re.escape(pattern).replace(r"\*\*", "\0").replace(r"\*", "[^/]*").replace("\0", ".*")
        if pattern.startswith("/"):  # anchored: matched against the /data path
            expressions.append(re.compile("^" + body + "(/.*)?$"))
        else:
            expressions.append(re.compile("(^|/)" + body + "(/.*)?$"))
    return expressions

def excluded(rel, rules):
    absolute = "/data/" + rel
    if rel.split("/")[0] in WORK_DIRS or any(rel == s or rel.startswith(s + "/") for s in EXPORT_SKIP) or is_credential(rel):
        return True
    return any(r.search(absolute) if r.pattern.startswith("^") else r.search(rel) for r in rules)

def contains_secret(full, known, scan_limit=16 << 20):
    try:
        if os.lstat(full).st_size > scan_limit:
            return False
        with open(full, "rb") as handle:
            content = handle.read(scan_limit)
    except OSError:
        return True
    return any(value.encode() in content for value in known)

def write_tar(ctx, stream, known, rules, stopped=lambda: False):
    data = ctx["paths"]["data"]
    skipped = 0
    with tarfile.open(fileobj=stream, mode="w|", format=tarfile.PAX_FORMAT) as tar:
        for current, dirs, files in os.walk(data, followlinks=False):
            if stopped():
                raise ExportStopped()
            rel_dir = os.path.relpath(current, data)
            keep = []
            for name in sorted(dirs):
                rel = name if rel_dir == "." else rel_dir + "/" + name
                full = os.path.join(current, name)
                if excluded(rel, rules):
                    continue
                if os.path.islink(full):
                    files.append(name)  # a link to a directory is stored as a link
                    continue
                keep.append(name)
                tar.add(full, arcname="data/" + rel, recursive=False)
            dirs[:] = keep
            for name in sorted(files):
                if stopped():
                    raise ExportStopped()
                rel = name if rel_dir == "." else rel_dir + "/" + name
                full = os.path.join(current, name)
                if excluded(rel, rules):
                    continue
                info = os.lstat(full)
                if stat.S_ISLNK(info.st_mode):
                    tar.add(full, arcname="data/" + rel, recursive=False)
                elif stat.S_ISREG(info.st_mode):
                    if contains_secret(full, known):
                        skipped += 1  # a file holding a home secret is left out
                        continue
                    tar.add(full, arcname="data/" + rel, recursive=False)
    return skipped

class ExportStopped(Exception):
    """The archive outgrew its limit, the disk's headroom or the run deadline while it was being produced."""

def sftp_target(repository):
    """(user, host, port) of the backup space from the restic repository the provisioner writes (sftp://user@host:23/restic), or the
    older sftp:user@host:path form (port 22). Validated; the port is kept."""
    if repository.startswith("sftp://"):
        parts = urllib.parse.urlsplit(repository)
        try:
            port = parts.port or 22
        except ValueError:
            raise ValueError("No backup space") from None
        user, host = parts.username, parts.hostname
        if parts.password is not None or parts.query or parts.fragment:
            raise ValueError("No backup space")
    else:
        match = re.fullmatch(r"sftp:([^@/:]+)@([^@/:]+):.*", repository)
        if not match:
            raise ValueError("No backup space")
        user, host, port = match.group(1), match.group(2), 22
    if (not isinstance(user, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", user) or user.startswith("-")
            or not isinstance(host, str) or not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", host) or host.startswith(("-", "."))
            or not 1 <= port <= 65535):
        raise ValueError("No backup space")
    return user, host, port

def upload_export(ctx, local, remote):
    """sftp batch to the backup space (the restic sub-account). Fixed commands; the paths are validated above."""
    cfg = backup_config(ctx)
    user, host, port = sftp_target(cfg["repository"])
    directory = os.path.dirname(remote)
    with tempfile.NamedTemporaryFile("w", prefix="murage-export-", suffix=".batch", delete=False) as batch:
        batch.write("-mkdir exports\n-mkdir %s\nput %s %s.part\n-rm %s\nrename %s.part %s\n"
                    % (directory, local, remote, remote, remote, remote))
    try:
        code, _ = ctx["run"](["sftp", "-b", batch.name, "-P", str(port), "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
                              "-o", "UserKnownHostsFile=" + cfg["knownHosts"], "-i", cfg["sshKey"], user + "@" + host], timeout=6 * 3600)
    finally:
        os.unlink(batch.name)
    if code != 0:
        raise ValueError("Export upload failed")

# The export never fills the data disk: production stops before less than this is left (or the archive passes maxBytes).
EXPORT_HEADROOM_BYTES = 2 << 30

def export_staging(ctx):
    return path(ctx, "data", ".murage-export")

def clean_export_staging(ctx):
    """Export staging belongs to the one export that may run (ops lock): anything left there was abandoned by an interruption."""
    shutil.rmtree(export_staging(ctx), ignore_errors=True)

EXPORT_DEADLINE_POLL_SECONDS = 1
EXPORT_STOP_SECONDS = 60

def bounded_wait(child, halt):
    """A child's exit code, waited for at most EXPORT_STOP_SECONDS (then killed and waited again, briefly). None: it did not exit."""
    try:
        return child.wait(timeout=EXPORT_STOP_SECONDS)
    except subprocess.TimeoutExpired:
        halt("stuck")
        try:
            return child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            return None

def produce_archive(ctx, command, archive, recipient, known, rules, limit):
    """tar | zstd | age, written here by this process so the size is enforced while the archive is produced: past `limit`, below the
    disk headroom or past the run deadline both children are stopped and ExportStopped is raised. Returns (bytes, sha256 hex)."""
    env = {"PATH": "/usr/bin:/bin"}
    spawn = ctx["spawn"]
    zstd = spawn(["zstd", "-q", "-T0", "-c"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env, close_fds=True)
    age = spawn(["age", "-r", recipient], stdin=zstd.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env, close_fds=True)
    zstd.stdout.close()
    state = {"size": 0, "digest": hashlib.sha256(), "stop": None}
    data = ctx["paths"]["data"]

    def halt(reason):
        state["stop"] = reason
        for child in (zstd, age):
            try:
                child.kill()
            except OSError:
                pass

    def drain():
        try:
            fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as out:
                chunks = 0
                while True:
                    chunk = age.stdout.read(1 << 20)
                    if not chunk:
                        return
                    if state["size"] + len(chunk) > limit:
                        return halt("limit")
                    chunks += 1
                    if chunks % 16 == 0 and (ctx["disk_free"](data) < EXPORT_HEADROOM_BYTES or ctx["now"]() >= command["expiresAt"]):
                        return halt("room")
                    state["size"] += len(chunk)
                    state["digest"].update(chunk)
                    out.write(chunk)
        except BaseException:
            halt("error")

    finished = threading.Event()

    def deadline_watch():
        # The run deadline holds whatever the output does (a highly compressible archive writes almost nothing).
        while not finished.wait(EXPORT_DEADLINE_POLL_SECONDS):
            if ctx["now"]() >= command["expiresAt"]:
                return halt("deadline")

    reader = threading.Thread(target=drain, daemon=True)
    watch = threading.Thread(target=deadline_watch, daemon=True)
    reader.start()
    watch.start()

    def stopped():
        if state["stop"] is None and ctx["now"]() >= command["expiresAt"]:
            halt("deadline")
        return state["stop"] is not None

    try:
        write_tar(ctx, zstd.stdin, known, rules, stopped=stopped)
    except (OSError, ValueError, ExportStopped, tarfile.TarError):
        if state["stop"] is None:
            halt("error")
    finally:
        try:
            zstd.stdin.close()
        except OSError:
            pass
        zstd_code, age_code = bounded_wait(zstd, halt), None
        reader.join(EXPORT_STOP_SECONDS)
        if reader.is_alive():
            halt("stuck")
            reader.join(EXPORT_STOP_SECONDS)
        age_code = bounded_wait(age, halt)
        finished.set()
        watch.join(EXPORT_STOP_SECONDS)
    if reader.is_alive() or zstd_code is None or age_code is None:
        raise ValueError("Export children did not stop")
    if state["stop"] is not None:
        raise ExportStopped()
    if zstd_code != 0 or age_code != 0:
        raise ValueError("Export archive failed")
    return state["size"], state["digest"].hexdigest()

def run_export(ctx, command):
    payload = command["payload"]
    rid, remote = payload["requestId"], payload["path"]
    rules = export_rules(ctx)
    known = known_secrets(ctx)
    lock = ops_lock(ctx)
    work = os.path.join(export_staging(ctx), rid)
    key = bytearray(random_source.token_bytes(32))
    try:
        clean_export_staging(ctx)
        os.makedirs(work, mode=0o700)
        # The identity goes to age-keygen on stdin: it is never written to a file.
        code, out = ctx["run"](["age-keygen", "-y"], stdin=(age_identity(bytes(key)) + "\n").encode(), timeout=60)
        recipient = out.decode(errors="replace").strip()
        if code != 0 or not re.fullmatch(r"age1[0-9a-z]{58}", recipient):
            raise ValueError("Export key failed")
        limit = min(payload["maxBytes"], ctx["disk_free"](ctx["paths"]["data"]) - EXPORT_HEADROOM_BYTES)
        if limit <= 0:
            return "failed"  # no room on the data disk: the operator sends it by hand
        archive = os.path.join(work, "archive.tar.zst.age")
        try:
            size, digest = produce_archive(ctx, command, archive, recipient, known, rules, limit)
        except ExportStopped:
            return "failed"  # over the home's archive budget, the disk's headroom or the deadline: the operator sends it by hand
        before_deadline(ctx, command)  # the upload is the step that uses storage: never begun after the run deadline
        ctx["upload"](ctx, archive, remote)
        binding = ctx["binding"]
        body = {"generation": binding["generation"], "commandId": command["id"], "requestId": rid, "file": remote,
                "format": "tar.zst.age", "bytes": size, "sha256": digest,
                "key": base64.urlsafe_b64encode(bytes(key)).decode().rstrip("=")}
        for attempt in range(3):
            try:
                answer = ctx["request"](binding, "export-ready", body)
                if isinstance(answer, dict) and answer.get("accepted") is True:
                    return "reported"
                return "failed"
            except urllib.error.HTTPError:
                return "failed"
            except Exception:
                if attempt == 2:
                    return "failed"
                ctx["sleep"](10)
        return "failed"
    finally:
        for i in range(len(key)):
            key[i] = 0
        clean_export_staging(ctx)
        lock.close()


def run(ctx, monotonic=time.monotonic):
    # Before any command is accepted: an interrupted code swap is finished or rolled back, abandoned export staging removed, and
    # interrupted resets and undos recovered.
    for step in (recover_update, clean_export_staging, recover_interrupted, release_stale_inhibit):
        try:
            step(ctx)
        except Exception:
            print("Self-service start-up recovery unavailable", file=sys.stderr)
    next_prune = monotonic()
    while True:
        try:
            poll_once(ctx)
        except Exception:
            # Remote bytes and local errors stay private.
            print("Self-service command poll unavailable", file=sys.stderr)
        try:
            recover_interrupted(ctx)  # unfinished recoveries (a sign-in carry that failed) are retried until they complete
            release_stale_inhibit(ctx)
            retry_unacknowledged(ctx)
        except Exception:
            print("Self-service command poll unavailable", file=sys.stderr)
        if monotonic() >= next_prune:
            try:
                prune_reset_snapshots(ctx)
                journal_prune(ctx)
            except Exception:
                print("Self-service housekeeping unavailable", file=sys.stderr)
            next_prune = monotonic() + 3600
        ctx["sleep"](POLL_SECONDS)


