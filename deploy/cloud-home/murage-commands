class Stuck(Exception):
    """The update can move neither forward nor back without an operator (code: a fixed token). Nothing in the journal is cleared;
    drive_update stops the home and its slices before raising (A1.3); every blocked kind stays refused; re-driven each poll."""
    def __init__(self, code):
        super().__init__(code)
        self.code = code


class Pending(Exception):
    """The update is still in flight after this drive (or another driver holds the lock): driven again on the next poll or start."""


class LauncherRefused(Exception):
    """An update refused with a fixed reason token (code). The ack stays "failed" (the control plane's outcome set is closed); the
    distinct reason is the one fixed line printed and the journal's lastResult.reason."""
    def __init__(self, code):
        super().__init__(code)
        self.code = code


def verify_signature(raw, signature, key):
    """Ed25519 over the raw bytes (openssl pkeyutl -rawin), with the image's OpenSSL 3. The one place a release signature is checked."""
    with tempfile.TemporaryDirectory(prefix="murage-release-") as work:
        for name, value in (("manifest", raw), ("signature", signature)):
            with open(os.path.join(work, name), "wb") as handle:
                handle.write(value)
        code, out = run_process(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", key, "-rawin",
                                 "-in", os.path.join(work, "manifest"), "-sigfile", os.path.join(work, "signature")], timeout=60)
    return code == 0 and b"Signature Verified Successfully" in out


def verify_manifest(ctx, raw, signature, key):
    """The signature first (ctx["verify"]), then the strict v3 shape. ValueError on refusal (message: release_signature | release_format |
    release_manifest)."""
    if not isinstance(signature, bytes) or len(signature) != 64 or not ctx["verify"](raw, signature, key):
        raise ValueError("release_signature")
    return parse_manifest(raw, os.uname().machine)


def release_config(ctx):
    """The trust root, re-read on every drive and every manifest verification (never cached). Invalid: Stuck(trust_root_invalid), never
    "no channel"."""
    try:
        trust = read_trust(ctx["paths"]["trust"])
    except (OSError, ValueError):
        raise Stuck("trust_root_invalid") from None
    parsed = urllib.parse.urlsplit(trust["channelUrl"])
    if parsed.scheme != "https" or not parsed.hostname or parsed.query or parsed.fragment or parsed.username:
        raise Stuck("trust_root_invalid")
    trust["channelUrl"] = trust["channelUrl"].rstrip("/")
    return trust


def update_state_file(ctx):
    return path(ctx, "update_state", "state.json")


def manifest_files(ctx, slot):
    return path(ctx, "update_state", "manifests", slot + ".json"), path(ctx, "update_state", "manifests", slot + ".sig")


def read_update_state(ctx):
    """The journal, strictly (parse_update_state). OSError for a missing or unreadable file, ValueError for any other shape: both are
    "owed" to recovery_pending and Stuck to drive_update."""
    fd = os.open(update_state_file(ctx), FILE_OPEN)
    with os.fdopen(fd, "rb") as handle:
        raw = handle.read(65537)
    if len(raw) > 65536:
        raise ValueError("update_state")
    return parse_update_state(raw)


def set_frozen_fd(fd, frozen):
    """Sets or clears FS_IMMUTABLE_FL on an open descriptor; a filesystem without inode flags is left alone (the seal walk then refuses
    it, which is the right answer for a slot)."""
    value = inode_flags(fd)
    wanted = value | FS_IMMUTABLE_FL if frozen else value & ~FS_IMMUTABLE_FL
    if wanted == value:
        return
    try:
        set_inode_flags(fd, wanted)
    except OSError as error:
        if error.errno not in (errno.ENOTTY, errno.EOPNOTSUPP, errno.EINVAL):
            raise


def freeze(target, frozen):
    """FS_IMMUTABLE_FL on one file or directory, by path (never through a link at its last component). Missing: nothing to do."""
    try:
        info = os.lstat(target)
    except FileNotFoundError:
        return
    fd = os.open(target, SLOT_OPEN if stat.S_ISDIR(info.st_mode) else FILE_OPEN)
    try:
        set_frozen_fd(fd, frozen)
    finally:
        os.close(fd)


def seal_tree(fd, frozen):
    """FS_IMMUTABLE_FL on every regular file and directory under fd (and fd itself), through descriptors only."""
    for name in os.listdir(fd):
        info = os.lstat(name, dir_fd=fd)
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, SLOT_OPEN, dir_fd=fd)
            try:
                seal_tree(child, frozen)
            finally:
                os.close(child)
        elif stat.S_ISREG(info.st_mode):
            child = os.open(name, FILE_OPEN, dir_fd=fd)
            try:
                set_frozen_fd(child, frozen)
            finally:
                os.close(child)
    set_frozen_fd(fd, frozen)


_LAST_STATE_WRITTEN = {}


def write_update_state(ctx, state):
    """The one writer of the journal: FS_IMMUTABLE_FL lifted on the directory and the file around a write_private (tmp + fsync + rename +
    directory fsync) and set again after; the flags are a guard, never state. A file that no longer holds what this process last wrote
    is logged (update_state_tampered) and overwritten from the in-memory record, which is the only record a drive decides from."""
    target = update_state_file(ctx)
    directory = os.path.dirname(target)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    last = _LAST_STATE_WRITTEN.get(target)
    if last is not None and os.path.exists(target):
        with open(target, "rb") as handle:
            if handle.read(65537) != last:
                print("update_state_tampered", file=sys.stderr)
    freeze(directory, False)
    freeze(target, False)
    try:
        write_private(target, state)
        _LAST_STATE_WRITTEN[target] = json.dumps(state).encode()
    finally:
        freeze(target, True)
        freeze(directory, True)


def write_bytes_private(target, data):
    directory = os.path.dirname(target)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
        fsync_dir(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def store_manifest(ctx, slot, raw, signature):
    """The signed manifest of an installed slot, kept under /var/lib/murage-update/manifests (the launcher and every later gate verify
    the slot against it)."""
    manifest, sig = manifest_files(ctx, slot)
    state_dir = ctx["paths"]["update_state"]
    freeze(state_dir, False)
    try:
        os.makedirs(os.path.dirname(manifest), mode=0o700, exist_ok=True)
        freeze(os.path.dirname(manifest), False)
        for target in (manifest, sig):
            freeze(target, False)
        write_bytes_private(manifest, raw)
        write_bytes_private(sig, signature)
        for target in (manifest, sig):
            freeze(target, True)
        freeze(os.path.dirname(manifest), True)
    finally:
        freeze(state_dir, True)


def remove_manifest(ctx, slot):
    manifest, sig = manifest_files(ctx, slot)
    state_dir = ctx["paths"]["update_state"]
    freeze(state_dir, False)
    try:
        freeze(os.path.dirname(manifest), False)
        for target in (manifest, sig):
            freeze(target, False)
            try:
                os.unlink(target)
            except FileNotFoundError:
                pass
        if os.path.isdir(os.path.dirname(manifest)):
            fsync_dir(os.path.dirname(manifest))
            freeze(os.path.dirname(manifest), True)
    finally:
        freeze(state_dir, True)


def read_stored_manifest(ctx, slot):
    manifest, sig = manifest_files(ctx, slot)
    fd = os.open(manifest, FILE_OPEN)
    with os.fdopen(fd, "rb") as handle:
        raw = handle.read(65537)
    fd = os.open(sig, FILE_OPEN)
    with os.fdopen(fd, "rb") as handle:
        signature = handle.read(129)
    if len(raw) > 65536 or len(signature) > 128:
        raise ValueError("release_manifest")
    return raw, signature


class SlotEnv:
    """What layout_ok needs from this runner: a slot by descriptor under /opt/murage-releases, its stored manifest signature-verified
    against the trust key, and the trust floor and ABI."""
    def __init__(self, ctx, trust):
        self.ctx, self.trust = ctx, trust

    def open_slot(self, name):
        releases = os.open(self.ctx["paths"]["releases"], SLOT_OPEN)
        try:
            return os.open(name, SLOT_OPEN, dir_fd=releases)
        finally:
            os.close(releases)

    def manifest(self, name):
        raw, signature = read_stored_manifest(self.ctx, name)
        return verify_manifest(self.ctx, raw, signature, self.trust["key"])


def current_target(ctx):
    """What the `current` link names, read relative to the releases directory's descriptor; None when there is no such link."""
    try:
        releases = os.open(ctx["paths"]["releases"], SLOT_OPEN)
    except OSError:
        return None
    try:
        return os.readlink("current", dir_fd=releases)
    except OSError:
        return None
    finally:
        os.close(releases)


def idle_slot(installed):
    return "B" if installed == "A" else "A"


def flip_current(ctx, slot):
    """The flip (and the flip back): FS_IMMUTABLE_FL lifted on the releases directory, a fresh link renamed over `current` (atomic),
    the directory fsynced, the flag set again, the link re-read. Idempotent."""
    releases = ctx["paths"]["releases"]
    current, temporary = os.path.join(releases, "current"), os.path.join(releases, "current.tmp")
    freeze(releases, False)
    try:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        os.symlink(slot, temporary)
        os.rename(temporary, current)
        fsync_dir(releases)
    finally:
        freeze(releases, True)
    if current_target(ctx) != slot:
        raise OSError(errno.EIO, "Current link did not move")


def wipe_slot(ctx, state, slot):
    """The idle slot's tree removed before an install (the only rmtree of a release tree). Astra D: the target is re-derived under the
    drive lock at wipe time from `current`: it must differ from what `current` names, from the installed slot (which must be what
    `current` names), and by inode from the live tree; FS_IMMUTABLE_FL on the releases directory is lifted only after that passes.
    Any failure is Stuck(wipe_target). A slot that does not exist (a fresh image) is nothing to wipe."""
    live = current_target(ctx)
    installed = state["installed"]["slot"]
    if slot not in SLOTS or slot == live or slot == installed or installed != live:
        raise Stuck("wipe_target")
    releases_dir = ctx["paths"]["releases"]
    releases = os.open(releases_dir, SLOT_OPEN)
    try:
        try:
            target = os.open(slot, SLOT_OPEN, dir_fd=releases)
        except FileNotFoundError:
            remove_manifest(ctx, slot)
            return
        try:
            live_fd = os.open(live, SLOT_OPEN, dir_fd=releases)
            try:
                mine, theirs = os.fstat(target), os.fstat(live_fd)
                if (mine.st_dev, mine.st_ino) == (theirs.st_dev, theirs.st_ino):
                    raise Stuck("wipe_target")
            finally:
                os.close(live_fd)
            freeze(releases_dir, False)
            seal_tree(target, False)
        finally:
            os.close(target)
        shutil.rmtree(slot, dir_fd=releases)
        fsync_dir(releases_dir)
    finally:
        os.close(releases)
        freeze(releases_dir, True)
    remove_manifest(ctx, slot)


def seal_slot(ctx, slot):
    """After the digest: FS_IMMUTABLE_FL on every regular file and directory of the slot (its root included), then on the releases
    directory."""
    releases = os.open(ctx["paths"]["releases"], SLOT_OPEN)
    try:
        fd = os.open(slot, SLOT_OPEN, dir_fd=releases)
        try:
            seal_tree(fd, True)
        finally:
            os.close(fd)
    finally:
        os.close(releases)
    freeze(ctx["paths"]["releases"], True)


def archive_parts(member):
    """The path components of a release member, or ValueError: no absolute name, no empty-after-cleanup name, no `..`, no NUL."""
    name = member.name
    if "\0" in name or name.startswith("/"):
        raise ValueError("Release entry refused")
    parts = [part for part in name.split("/") if part not in ("", ".")]
    if not parts or ".." in parts:
        raise ValueError("Release entry refused")
    return parts


def open_archive(path, expect=None):
    """The one open of a downloaded release: O_NOFOLLOW, a regular file owned by root (or by this process), and, when `expect` is
    (sha256 hex, size), its bytes hashed from this very descriptor, so the digest covers exactly what validate and extract then read.
    Returns a rewound binary file object; both passes read it, nothing re-opens the path."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.geteuid()):
            raise ValueError("Release archive refused")
        handle = os.fdopen(fd, "rb")
    except BaseException:
        os.close(fd)
        raise
    try:
        if expect is not None:
            digest, total = hashlib.sha256(), 0
            for chunk in iter(lambda: handle.read(1 << 20), b""):
                digest.update(chunk)
                total += len(chunk)
            if digest.hexdigest() != expect[0] or total != expect[1]:
                raise LauncherRefused("archive_digest")
        handle.seek(0)
    except BaseException:
        handle.close()
        raise
    return handle


def validate_archive(archive):
    """Pass 1 of safe_extract, before anything is created: every member is a regular file, directory or relative symlink with a clean
    name (no hardlink, device, fifo, absolute or `..` name), no member sits below a symlink of the archive, and every symlink, resolved
    through the other symlinks of the archive's own member set, stays inside the tree and does not loop (links_stay_inside)."""
    links, others, total = {}, set(), 0
    archive.seek(0)
    with tarfile.open(fileobj=archive, mode="r:gz") as tar:
        for member in tar:
            rel = "/".join(archive_parts(member))
            if rel in links or rel in others:
                raise ValueError("Release entry repeated")
            if member.issym():
                if "\0" in member.linkname or not member.linkname or member.linkname.startswith("/"):
                    raise ValueError("Release link refused")
                links[rel] = member.linkname
            elif member.isdir() or member.isreg():
                if member.isreg():
                    total += member.size
                    if total > (16 << 30):
                        raise ValueError("Release too large")
                others.add(rel)
            else:
                raise ValueError("Release entry type refused")
    for rel in list(links) + sorted(others):
        parts = rel.split("/")
        for depth in range(1, len(parts)):
            if "/".join(parts[:depth]) in links:
                raise ValueError("Release entry below a link refused")
    if set(links) & others or not links_stay_inside(links):
        raise ValueError("Release link refused")


def safe_extract(archive, target, expect=None):
    """Regular files, directories and in-tree relative symlinks only; root-owned, never group/world writable, no set-id. The whole
    archive is validated before the first create (validate_archive); every entry is then written relative to a directory descriptor,
    walking from the extract root one O_NOFOLLOW|O_DIRECTORY openat per component, so a path is never re-resolved through a link."""
    with open_archive(archive, expect) as handle:
        validate_archive(handle)
        extract_validated(handle, target)


def extract_validated(handle, target):
    """Pass 2 of safe_extract, from the same descriptor as pass 1."""
    os.makedirs(target, mode=0o755)
    root = os.open(target, SLOT_OPEN)
    held = []  # [(component, fd)] the open directory chain of the previous member; held[0] is below root

    def descend(parts):
        keep = 0
        while keep < len(held) and keep < len(parts) and held[keep][0] == parts[keep]:
            keep += 1
        while len(held) > keep:
            os.close(held.pop()[1])
        for part in parts[keep:]:
            parent = held[-1][1] if held else root
            try:
                os.mkdir(part, 0o755, dir_fd=parent)
            except FileExistsError:
                pass
            try:
                held.append((part, os.open(part, SLOT_OPEN, dir_fd=parent)))
            except OSError:
                raise ValueError("Release entry refused") from None
        return held[-1][1] if held else root

    try:
        handle.seek(0)
        with tarfile.open(fileobj=handle, mode="r:gz") as tar:
            for member in tar:
                parts = archive_parts(member)
                parent = descend(parts[:-1])
                leaf = parts[-1]
                if member.issym():
                    os.symlink(member.linkname, leaf, dir_fd=parent)
                    if os.geteuid() == 0:
                        os.chown(leaf, 0, 0, dir_fd=parent, follow_symlinks=False)
                elif member.isdir():
                    try:
                        os.mkdir(leaf, 0o755, dir_fd=parent)
                    except FileExistsError:
                        pass
                    try:
                        fd = os.open(leaf, SLOT_OPEN, dir_fd=parent)
                    except OSError:
                        raise ValueError("Release entry refused") from None
                    try:
                        os.fchmod(fd, 0o755)
                        if os.geteuid() == 0:
                            os.fchown(fd, 0, 0)
                    finally:
                        os.close(fd)
                elif member.isreg():
                    fd = os.open(leaf, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=parent)
                    with os.fdopen(fd, "wb") as out:
                        shutil.copyfileobj(tar.extractfile(member), out, 1 << 20)
                        out.flush()
                        os.fchmod(out.fileno(), 0o755 if member.mode & 0o111 else 0o644)
                        if os.geteuid() == 0:
                            os.fchown(out.fileno(), 0, 0)
                else:
                    raise ValueError("Release entry type refused")
    finally:
        while held:
            os.close(held.pop()[1])
        os.close(root)

LAUNCHER_INSTALLER = "murage-install-launchers"


def launcher_module(ctx):
    """The launcher list step that lives on the image (build-image.sh puts it in libexec): plan, apply_modes and check_abi for a staged
    release. Never from the release itself. An image without it cannot take an update (fail closed)."""
    target = os.path.join(ctx["paths"]["libexec"], LAUNCHER_INSTALLER)
    try:
        info = os.lstat(target)
        if not stat.S_ISREG(info.st_mode) or (info.st_uid != 0 and os.geteuid() == 0) or info.st_mode & 0o022:
            raise FileNotFoundError(target)
        return load_module("murage_install_launchers", target)
    except (OSError, SyntaxError):
        raise LauncherRefused("launcher_installer_missing") from None


def gate_server(ctx):
    """The start gate (r3 sec. 3): a root-only unix socket under /run/murage-update served by a thread of this process. It holds one
    in-memory grant, set by the drive that is inside verify or rollback right after its counter write, and answers `grant` once, to a
    peer that is uid 0, lives in murage-home.service's cgroup (read through a pidfd taken before and checked alive after, so a recycled
    pid cannot pass) and runs the image's python3; everything else, and every second request, is `deny`. Returns the listening socket."""
    directory = ctx["paths"]["gate"]
    os.makedirs(directory, mode=0o700, exist_ok=True)
    target = os.path.join(directory, "gate.sock")
    try:
        os.unlink(target)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    mask = os.umask(0o077)
    try:
        server.bind(target)
    finally:
        os.umask(mask)
    os.chmod(target, 0o600)
    server.listen(8)
    ctx["gate"] = {"lock": threading.Lock(), "grant": None}

    def serve():
        while True:
            try:
                connection, _ = server.accept()
            except OSError:
                return
            with connection:
                try:
                    connection.settimeout(5)
                    connection.sendall(gate_answer(ctx, connection))
                except OSError:
                    pass

    threading.Thread(target=serve, name="murage-update-gate", daemon=True).start()
    return server


def peer_identity(pid, uid):
    """The facts the gate checks about a connected peer: its uid (from SO_PEERCRED), its cgroup line and its executable."""
    with open("/proc/%d/cgroup" % pid, encoding="ascii") as stream:
        cgroup = stream.read(4096).strip()
    return {"uid": uid, "cgroup": cgroup, "exe": os.path.realpath("/proc/%d/exe" % pid)}


def gate_answer(ctx, connection):
    try:
        pid, uid, _gid = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        pidfd = os.pidfd_open(pid)
        try:
            peer = ctx["peer"](pid, uid)
            signal.pidfd_send_signal(pidfd, 0)  # the process the facts describe is still alive: no recycled pid
        finally:
            os.close(pidfd)
        if peer["uid"] != 0 or peer["cgroup"] != HOME_CGROUP or not re.fullmatch(r"/usr/bin/python3(\.[0-9]{1,3})?", peer["exe"]):
            return b"deny\n"
        raw = connection.recv(GATE_REQUEST_MAX + 1)
        if len(raw) > GATE_REQUEST_MAX:
            return b"deny\n"
        request = strict_json(raw.decode("utf-8"))
        _exact(request, ("slot",))
        if request["slot"] not in SLOTS:
            return b"deny\n"
        gate = ctx["gate"]
        with gate["lock"]:
            grant = gate["grant"]
            if grant is not None and grant["slot"] == request["slot"]:
                gate["grant"] = None
                return b"grant\n"
        return b"deny\n"
    except Exception:
        return b"deny\n"


def grant_and_start(ctx, drive_id, slot):
    """One counted start of slot code: the grant is set (after the caller's counter write) and the unit started; the launcher consumes
    the grant, so a second start (systemd's Restart=, a boot, an operator) runs no slot code."""
    gate = ctx["gate"]
    with gate["lock"]:
        gate["grant"] = {"driveId": drive_id, "slot": slot}
    return ctx["systemctl"]("start", HOME_UNIT)


def drive_lock(ctx):
    """flock on /run/murage-update/lock: the poll loop and --recover-update never interleave; a second holder gets Pending."""
    directory = ctx["paths"]["gate"]
    os.makedirs(directory, mode=0o700, exist_ok=True)
    handle = open(os.path.join(directory, "lock"), "a")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise Pending() from None
    return handle


def drive_update(ctx, release=None):
    """The single driver (r2 sec. 4, r3 sec. 4, A1). One load of the journal per drive, every durable write before the step it
    authorises, every handler idempotent so a resume re-runs it. `release` ({"manifest", "raw", "signature"}) is given only by
    run_update for the install it just journaled; a resume at `installing` without it aborts (nothing live was touched). Returns the
    outcome ("done" | "failed") when the update ended in this drive, None when nothing was in flight; raises Pending while it stays in
    flight, Stuck (after the explicit stop of the home and its slices, A1.3) when an operator is needed."""
    lock = drive_lock(ctx)
    try:
        try:
            return drive_phases(ctx, release)
        except Stuck as stuck:
            print("Self-service update stuck: " + stuck.code, file=sys.stderr)
            stop_writers(ctx)
            raise
    finally:
        lock.close()


def drive_phases(ctx, release):
    trust = release_config(ctx)
    try:
        state = read_update_state(ctx)
    except (OSError, ValueError):
        raise Stuck("update_state_invalid") from None
    env = SlotEnv(ctx, trust)
    try:
        layout_ok(state, current_target(ctx), env)
    except LayoutRefused as refused:
        raise Stuck(refused.code) from None
    if state["inflight"] is None:
        return None
    drive_id = random_source.token_hex(16)
    state["inflight"]["driveId"] = drive_id  # mirrored into the record at its next write, for the logs
    while True:
        inflight = state["inflight"]
        phase, slot = inflight["phase"], inflight["slot"]
        if phase == "installing":
            if release is None or release["manifest"]["revision"] != inflight["revision"] or release["manifest"]["sequence"] != inflight["sequence"]:
                abort_install(ctx, state, "install_interrupted")
                return "failed"
            try:
                install_release(ctx, state, trust, release)
            except Stuck:
                raise
            except LauncherRefused as refused:
                abort_install(ctx, state, refused.code)
                return "failed"
            except Exception:
                abort_install(ctx, state, "install_failed")
                return "failed"
            release = None
            inflight["phase"] = "installed"
            write_update_state(ctx, state)
        elif phase == "installed":
            if ctx["now"]() >= inflight["deadline"]:
                abort_install(ctx, state, "expired")  # the run deadline passed before the irreversible step: nothing live was touched
                start_home(ctx)
                return "failed"
            if not stop_writers(ctx):
                abort_install(ctx, state, "writers_running")
                start_home(ctx)
                return "failed"
            inflight["phase"] = "flip"
            write_update_state(ctx, state)
        elif phase == "flip":
            try:
                flip_current(ctx, slot)
            except OSError:
                enter_rollback(ctx, state, "flip_failed")
                continue
            inflight.update(phase="verify", verifyAttempts=0)
            write_update_state(ctx, state)
        elif phase == "verify":
            if ctx["unit_state"](HOME_UNIT) != "active":
                if inflight["verifyAttempts"] >= VERIFY_ATTEMPTS:
                    enter_rollback(ctx, state, "unhealthy")
                    continue
                inflight["verifyAttempts"] += 1  # the counter is written before the one start it bounds
                write_update_state(ctx, state)
                remove_flag(ctx)
                grant_and_start(ctx, drive_id, slot)
            if wait_healthy(ctx):
                # The commit: one write, from this drive's own observation. The previous slot is kept until the next install.
                state["installed"] = {"slot": slot, "sequence": inflight["sequence"], "revision": inflight["revision"]}
                finish_update(ctx, state, "done", None)
                return "done"
            enter_rollback(ctx, state, "unhealthy")
        elif phase == "rollback":
            previous = state["installed"]["slot"]
            if not inflight["restored"]:
                # [A1] the flip back never happens under a running candidate: if stop_writers reports a unit still up, Stuck before the flip.
                if not stop_writers(ctx):
                    raise Stuck("rollback_stop")
                try:
                    verified_slot(env, previous)  # signed manifest and seal only; there is no unsigned path
                except LayoutRefused:
                    raise Stuck("rollback_gate") from None
                try:
                    flip_current(ctx, previous)
                except OSError:
                    raise Stuck("rollback_flip") from None
                inflight["restored"] = True
                write_update_state(ctx, state)
            # Health is accepted only after THIS drive has taken the home down and started the previous slot itself: a candidate that
            # kept serving is never recorded by finish_update. A unit that will not leave active is Stuck; rollbackAttempts progresses
            # on every drive regardless of what is still active, so an unhealthy rollback always reaches Stuck("rollback_unhealthy").
            if not stop_writers(ctx):
                raise Stuck("rollback_stop")
            if inflight["rollbackAttempts"] >= ROLLBACK_ATTEMPTS:
                raise Stuck("rollback_unhealthy")
            inflight["rollbackAttempts"] += 1
            write_update_state(ctx, state)
            remove_flag(ctx)
            grant_and_start(ctx, drive_id, previous)
            if wait_healthy(ctx):
                finish_update(ctx, state, "failed", inflight["reason"] or "unhealthy")
                return "failed"
            stop_writers(ctx)  # the restored release did not answer: taken down, counted again on the next poll
            raise Pending()
        else:
            raise Stuck("update_state_invalid")


def enter_rollback(ctx, state, reason):
    """phase := rollback (written), then the explicit stop (A1.3): the unhealthy candidate may still be up and Wants= will not take it down."""
    state["inflight"].update(phase="rollback", restored=False, reason=reason)
    write_update_state(ctx, state)
    stop_writers(ctx)


def abort_install(ctx, state, reason):
    """installing or installed failed before anything live was touched: the idle slot is wiped, the record closed as failed/<reason>."""
    inflight = state["inflight"]
    try:
        wipe_slot(ctx, state, inflight["slot"])
    except Stuck:
        raise
    except OSError:
        # A partial or symlink idle slot is left: keep inflight and Stuck, never clear the record over a slot that was not wiped.
        raise Stuck("wipe_target") from None
    print("Self-service update refused: " + reason, file=sys.stderr)
    state["inflight"] = None
    state["lastResult"] = {"commandId": inflight["commandId"], "outcome": "failed", "reason": reason}
    write_update_state(ctx, state)


def finish_update(ctx, state, outcome, reason):
    """The terminal write (commit, or rollback complete), then and only then the inhibit is lifted and the home started."""
    inflight = state["inflight"]
    state["inflight"] = None
    state["lastResult"] = {"commandId": inflight["commandId"], "outcome": outcome, "reason": reason}
    write_update_state(ctx, state)
    start_home(ctx)


def install_release(ctx, state, trust, release):
    """The installing phase: wipe the idle slot (re-derived), download (bytes and digest against the signed manifest), safe_extract,
    required files, the launcher list (plan, modes, ABI), the tree digest against the signed treeSha256, the manifest stored beside the
    journal, then the seal. Nothing live is touched."""
    manifest, slot = release["manifest"], state["inflight"]["slot"]
    releases, state_dir = ctx["paths"]["releases"], ctx["paths"]["update_state"]
    wipe_slot(ctx, state, slot)
    if ctx["disk_free"](releases) < manifest["bytes"] * 4:
        raise LauncherRefused("disk_space")
    download = os.path.join(state_dir, "download.tar.gz")
    freeze(state_dir, False)
    try:
        arch = os.uname().machine
        digest, size = ctx["fetch"](trust["channelUrl"] + "/" + arch + "/" + manifest["archive"], download, limit=manifest["bytes"])
        if digest != manifest["sha256"] or size != manifest["bytes"]:
            raise LauncherRefused("archive_digest")
        tree = os.path.join(releases, slot)
        freeze(releases, False)
        safe_extract(download, tree, (manifest["sha256"], manifest["bytes"]))
        for required in ("dist-server/cloud-home-supervisor.js", "dist-server/index.js"):
            if not os.path.isfile(os.path.join(tree, required)):
                raise LauncherRefused("release_incomplete")
        module = launcher_module(ctx)
        launcher_source = os.path.join(tree, "deploy", "cloud-home")
        try:
            entries = module.plan(launcher_source)
            module.apply_modes(tree, entries)
            module.check_abi(tree, trust["launcherAbi"])
        except module.LauncherError as error:
            raise LauncherRefused(error.code) from None
        fd = os.open(tree, SLOT_OPEN)
        try:
            found = seal_walk_digest(fd, False)
        finally:
            os.close(fd)
        if found != manifest["treeSha256"]:
            raise LauncherRefused("tree_digest")
        store_manifest(ctx, slot, release["raw"], release["signature"])
        seal_slot(ctx, slot)
    finally:
        freeze(state_dir, False)  # store_manifest sets the directory flag again; the download is removed under a lifted flag
        if os.path.exists(download):
            os.unlink(download)
        freeze(state_dir, True)
        freeze(releases, True)


def run_update(ctx, command):
    """update_software: the drive entry checks (trust, journal, layout), the manifest from the channel verified against the trust key,
    the idle refusals (same revision: done; at or below the signed floor: downgrade; another launcher ABI: launcher_abi_mismatch; the
    run deadline; disk), then one write (installing) and the drive. The in-process path and the resume path are the same function."""
    layout_outcome = drive_update(ctx)  # Stuck or Pending propagate: the command stays pending while the journal is owed
    if layout_outcome is not None:
        return layout_outcome
    trust = release_config(ctx)
    state = read_update_state(ctx)
    live = layout_ok(state, current_target(ctx), SlotEnv(ctx, trust))[state["installed"]["slot"]]
    arch = os.uname().machine
    raw = ctx["fetch"](trust["channelUrl"] + "/" + arch + "/manifest.json")
    signature = ctx["fetch"](trust["channelUrl"] + "/" + arch + "/manifest.json.sig", limit=128)
    try:
        manifest = verify_manifest(ctx, raw, signature, trust["key"])
    except ValueError as error:
        return refuse_update(str(error) if str(error) in ("release_signature", "release_format", "release_manifest") else "release_manifest")
    target = command["payload"]["sequence"]
    # The command names ONE sequence. Already on it: done. The channel's manifest names another (a newer release is not yet promoted,
    # or the channel was changed): refuse, never install a sequence nobody asked for.
    if live["sequence"] == target:
        return "done"
    if manifest["sequence"] != target:
        return refuse_update("sequence_mismatch")
    if manifest["revision"] == state["installed"]["revision"]:
        return "done"  # already this release
    if manifest["sequence"] <= max(trust["minimumSequence"], live["sequence"]):
        return refuse_update("downgrade")  # never below the signed floor, even signed
    if manifest["launcherAbi"] != trust["launcherAbi"]:
        return refuse_update("launcher_abi_mismatch")  # the launchers are image-pinned: this release needs a fresh home image
    before_deadline(ctx, command)
    state["inflight"] = {"commandId": command["id"], "slot": idle_slot(state["installed"]["slot"]), "sequence": manifest["sequence"],
                         "revision": manifest["revision"], "phase": "installing", "verifyAttempts": 0, "rollbackAttempts": 0, "restored": False,
                         "startedAt": ctx["now"](), "deadline": command["expiresAt"], "driveId": random_source.token_hex(16), "reason": None}
    write_update_state(ctx, state)
    return drive_update(ctx, {"manifest": manifest, "raw": raw, "signature": signature})


def refuse_update(reason):
    print("Self-service update refused: " + reason, file=sys.stderr)
    return "failed"


def update_inflight_for(ctx, cid):
    """True while the journal holds this command's update. A journal that cannot be read holds no command: that is Stuck for the driver
    (which stops the home and surfaces it every poll), and the command is answered failed, never left as a guess."""
    try:
        inflight = read_update_state(ctx)["inflight"]
    except (OSError, ValueError):
        return False
    return inflight is not None and inflight["commandId"] == cid


def recover_update(ctx, cid):
    """The outcome of this command's update: pending (raised) while its record is in flight or the journal is unreadable; its lastResult
    once it ended; failed when the journal never recorded it."""
    try:
        state = read_update_state(ctx)
    except (OSError, ValueError):
        raise Pending() from None
    if state["inflight"] is not None and state["inflight"]["commandId"] == cid:
        raise Pending()
    result = state["lastResult"]
    return result["outcome"] if result and result["commandId"] == cid else "failed"


def drive_pending_update(ctx):
    """At start and on every poll: an update in flight (or an unreadable journal) is driven, whether or not its command is still
    journaled or listed. Stuck and Pending are the drive's answers, not errors of the poll."""
    try:
        state = read_update_state(ctx)
    except (OSError, ValueError):
        state = None
    if state is None or state["inflight"] is not None:
        try:
            drive_update(ctx)
        except Pending:
            print("Self-service recovery pending", file=sys.stderr)
        except Stuck as stuck:
            print("Self-service recovery pending", file=sys.stderr)
            return stuck.code
    return None


UPDATE_REPORT_SECONDS = 600

def update_report(ctx, stuck):
    """What the updater says about itself, in fixed vocabulary only: the installed sequence, the journal's lastResult (command id, outcome,
    reason token) and a Stuck code. An unreadable journal is itself Stuck."""
    try:
        state = read_update_state(ctx)
    except (OSError, ValueError):
        return {"installedSequence": None, "lastResult": None, "stuck": stuck or "update_state_invalid"}
    result = state["lastResult"]
    return {"installedSequence": state["installed"]["sequence"], "stuck": stuck,
            "lastResult": None if result is None else {"commandId": result["commandId"], "outcome": result["outcome"], "reason": result["reason"]}}

def report_update_state(ctx, stuck=None):
    """Tells the control plane (POST update-state) what the updater reports, when it changed and at least every UPDATE_REPORT_SECONDS. An
    older control plane answers 404: noted, and asked again only at the interval. Any other failure is retried on the next loop."""
    body = update_report(ctx, stuck)
    key = json.dumps(body, sort_keys=True)
    now = ctx["now"]()
    last = ctx.get("update_reported")
    if last is not None and last[0] == key and now - last[1] < UPDATE_REPORT_SECONDS * 1000:
        return
    try:
        answer = ctx["request"](ctx["binding"], "update-state", dict(body, generation=ctx["binding"]["generation"]))
    except urllib.error.HTTPError as error:
        if error.code == 404:
            ctx["update_reported"] = (key, now)
        return
    except Exception:
        return
    if answer == {"recorded": True}:
        ctx["update_reported"] = (key, now)


UPDATE_HEALTH_SECONDS, UPDATE_HEALTH_PASSES = 180, 2

def wait_healthy(ctx, seconds=UPDATE_HEALTH_SECONDS, passes=UPDATE_HEALTH_PASSES):
    """Bounded: the unit is active AND the Murage app answers its health check on `passes` consecutive probes, within `seconds`.
    systemd's Type=simple says nothing about readiness, so is-active alone is never enough."""
    good = 0
    for _ in range(max(1, seconds // 3)):
        if ctx["systemctl"]("is-active", "--quiet", HOME_UNIT) == 0 and ctx["app_healthy"]():
            good += 1
            if good >= passes:
                return True
        else:
            good = 0
        ctx["sleep"](3)
    return False


# ---- reset and undo -----------------------------------------------------------------------------------------------------

def backup_config(ctx):
    with open(path(ctx, "config", "backup.json"), "rb") as handle:
        cfg = strict_json(handle.read(16384).decode())
    if not isinstance(cfg, dict) or not isinstance(cfg.get("repository"), str) or not isinstance(cfg.get("passwordFile"), str):
        raise ValueError("Invalid backup config")
    return cfg

def restic(ctx, cfg, args, limit=16 << 20):
    backup = ctx["backup"]
    return ctx["run"](["restic"] + args + backup.restic_options(cfg), env=backup.restic_env(cfg), limit=limit, timeout=4 * 3600)

def restic_time(value):
    match = re.fullmatch(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)", value)
    if not match:
        raise ValueError("Invalid snapshot time")
    zone = "+00:00" if match.group(3) == "Z" else match.group(3)
    return datetime.datetime.fromisoformat(match.group(1) + "." + (match.group(2) or "0").ljust(6, "0")[:6] + zone)

HEX64 = re.compile(r"[0-9a-f]{64}")
COMPLETE_TAG = "complete"

def list_snapshots(ctx, cfg, tags):
    code, out = restic(ctx, cfg, ["snapshots", "--json", "--tag", ",".join(tags)])
    if code != 0:
        raise ValueError("Snapshot list unavailable")
    snapshots = json.loads(out.decode())
    return [s for s in snapshots if isinstance(s, dict) and isinstance(s.get("id"), str) and HEX64.fullmatch(s["id"])
            and isinstance(s.get("time"), str) and all(t in (s.get("tags") or []) for t in tags)]

def last_good_snapshot(ctx, cfg):
    """The newest nightly that murage-backup confirmed complete (restic exit 0, tagged "complete"). A nightly that skipped unreadable
    files (restic exit 3) is never a reset source."""
    candidates = list_snapshots(ctx, cfg, ["nightly", COMPLETE_TAG])
    return max(candidates, key=lambda s: restic_time(s["time"]))["id"] if candidates else None

def ops_lock(ctx, wait_seconds=7200):
    handle = open(path(ctx, "run", "murage-data-ops.lock"), "a")
    for _ in range(max(1, wait_seconds // 5)):
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            ctx["sleep"](5)
    handle.close()
    raise ValueError("Data operations busy")

def work_dir(ctx, reset_id, operation):
    return path(ctx, "data", ".murage-reset", operation + "-" + reset_id)

def swap_record(ctx, reset_id, operation):
    """The durable swap manifest and commit marker: on the state disk, outside the staging tree the swap deletes."""
    return path(ctx, "state", "swaps", operation + "-" + reset_id + ".json")

def read_swap(ctx, reset_id, operation):
    try:
        with open(swap_record(ctx, reset_id, operation), "rb") as handle:
            record = json.loads(handle.read(1 << 20))
    except FileNotFoundError:
        return None
    if (not isinstance(record, dict) or record.get("phase") not in ("swap", "committed", "carried", "rolled_back")
            or not all(isinstance(record.get(k), list) and all(isinstance(n, str) and "/" not in n and n not in ("", ".", "..") for n in record[k])
                       for k in ("aside", "incoming"))):
        raise ValueError("Invalid swap record")
    return record

# Every unit that writes /data. The home unit's own stop also stops the slices (ExecStopPost), but that is not waited for.
WRITERS = (HOME_UNIT, "murage-turns.slice", "murage-browsers.slice")

# A persistent start inhibition, honoured by murage-home.service and murage-home-recover.service themselves (ConditionPathExists=!),
# so no start of the home (the recovery timer, a boot, an explicit start) can pass while a data transition is unresolved. Set durably
# BEFORE the writers are stopped; cleared only once the transition is durably resolved (carried, rolled back, committed or put back).
INHIBIT = "recovery-inhibit"

def inhibit_path(ctx):
    return path(ctx, "state", INHIBIT)

def inhibit_starts(ctx):
    """Publishes the inhibition durably (file and directory entry flushed) before anything stops a writer. An inhibition already present
    is flushed again: it may have been published by a run that crashed before its directory reached the disk."""
    if not os.path.exists(inhibit_path(ctx)):
        write_private(inhibit_path(ctx), {"since": ctx["now"]()})
    else:
        fsync_dir(os.path.dirname(inhibit_path(ctx)))

def start_home(ctx):
    """The only way the runner starts the home after a data transition: lifts the inhibition, then starts it. While any other reset or
    undo swap is still unresolved the inhibition stays and nothing is started."""
    if recovery_pending(ctx):
        return 0
    # Every terminal record that resolved the transition was written durably (write_private flushes its directory) before this point,
    # so the inhibition is never lifted ahead of the record that justifies lifting it.
    try:
        os.unlink(inhibit_path(ctx))
        fsync_dir(os.path.dirname(inhibit_path(ctx)))
    except FileNotFoundError:
        pass
    return ctx["systemctl"]("start", HOME_UNIT)

def release_stale_inhibit(ctx):
    """An inhibition with nothing unresolved behind it (all recovered) is lifted and the home started."""
    if os.path.exists(inhibit_path(ctx)) and not recovery_pending(ctx):
        start_home(ctx)

def stop_writers(ctx):
    """Inhibits every start of the home first, then stops the home and its turn/browser slices and confirms each is inactive.
    False: something still runs; touch nothing."""
    inhibit_starts(ctx)
    ok = ctx["systemctl"]("stop", *WRITERS) == 0
    for _ in range(20):
        states = [ctx["unit_state"](unit) for unit in WRITERS]
        if all(state in ("inactive", "failed") for state in states):
            return ok
        ctx["sleep"](3)
    return False

def fsync_dir(directory):
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def is_credential(rel):
    parts = rel.split("/")
    return (os.path.basename(rel) in CREDENTIAL_NAMES or any(rel == s or rel.endswith("/" + s) for s in CREDENTIAL_SUFFIXES)
            or (len(parts) >= 3 and parts[0] == SIGNIN_ROOT and parts[-1] == SIGNIN_DIR))

# r5 R5.1 (murage-turn-launch.py MASK_NAMES, ensure_placeholder): before a turn mounts its masks, the launcher makes these directories in
# the bots' workspaces immutable (FS_IMMUTABLE_FL), so nothing a running turn holds can move them. Nobody, root included, can rename or
# delete an immutable directory or change what is in it until the flag is cleared. A reset or undo runs with every writer stopped (no
# turn holds a mask), so it clears the flag on the placeholders of the tree it moved aside before it carries or deletes anything, and
# freezes each one again at its place in the new tree (the launcher also freezes every placeholder again before a turn mounts on it).
PLACEHOLDER_NAMES = frozenset((".claude", ".codex", ".fuigo", ".grok", ".kimi-code", ".opencode"))
WORKSPACES = "home/workspaces"
PLACEHOLDER_OPEN = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC

def set_inode_flags(fd, value):
    fcntl.ioctl(fd, FS_IOC_SETFLAGS, value.to_bytes(4, sys.byteorder) + bytes(4))

def placeholder_frozen(full):
    """True when full is a real directory (never through a link at its last component) carrying FS_IMMUTABLE_FL."""
    try:
        fd = os.open(full, PLACEHOLDER_OPEN)
    except OSError:
        return False
    try:
        return bool(inode_flags(fd) & FS_IMMUTABLE_FL)
    finally:
        os.close(fd)

def freeze_placeholder(full, frozen):
    """Sets (frozen) or clears FS_IMMUTABLE_FL on the directory at full. Nothing there, or not a directory: nothing to do. Idempotent."""
    try:
        fd = os.open(full, PLACEHOLDER_OPEN)
    except OSError as error:
        if error.errno in (errno.ENOENT, errno.ELOOP, errno.ENOTDIR):
            return
        raise
    try:
        value = inode_flags(fd)
        wanted = value | FS_IMMUTABLE_FL if frozen else value & ~FS_IMMUTABLE_FL
        if wanted != value:
            set_inode_flags(fd, wanted)
    finally:
        os.close(fd)

def frozen_placeholders(root):
    """Relative paths (from root) of the immutable placeholders under root/home/workspaces, at any depth, nested ones included (a turn
    whose folder is inside a .fuigo folder has placeholders below it). Links are never followed, and a credential-named folder is never
    entered: it moves whole, with whatever is frozen inside it (what an owner keeps in a .claude folder is not read)."""
    found = []
    for current, dirs, _files in os.walk(os.path.join(root, WORKSPACES), followlinks=False):
        for name in [d for d in dirs if d in PLACEHOLDER_NAMES]:
            full = os.path.join(current, name)
            if placeholder_frozen(full):
                found.append(os.path.relpath(full, root))
            if name in CREDENTIAL_NAMES:
                dirs.remove(name)
    return sorted(found)

def thaw_tree(root):
    """Clears FS_IMMUTABLE_FL on every directory left under root (the moved-aside tree, about to be deleted, with every writer stopped):
    nothing frozen anywhere in it can keep the reset from finishing. Links are never followed."""
    for current, dirs, _files in os.walk(root, followlinks=False):
        for name in dirs:
            full = os.path.join(current, name)
            if placeholder_frozen(full):
                freeze_placeholder(full, False)

def read_frozen(manifest):
    """The placeholders a reset recorded before clearing their flags ([] before any was recorded). Read whole; a damaged list raises
    (the recovery stays pending for a person rather than guessing)."""
    try:
        with open(manifest, "rb") as handle:
            found = json.loads(handle.read())
    except FileNotFoundError:
        return []
    if not isinstance(found, list) or not all(placeholder_rel(r) for r in found):
        raise ValueError("Invalid placeholder list")
    return sorted(found)

def placeholder_rel(rel):
    """A placeholder path a swap record may name: relative, under home/workspaces, no empty, "." or ".." part, a placeholder name last."""
    parts = rel.split("/") if isinstance(rel, str) else []
    return (len(parts) >= 4 and "/".join(parts[:2]) == WORKSPACES and parts[-1] in PLACEHOLDER_NAMES
            and all(p not in ("", ".", "..") for p in parts))

def credential_paths(root, depth=None, skip_top=()):
    """Engine sign-in paths under root (relative), never descending into them: names only, nothing is opened. At every depth by
    default: the reset deletes the tree it moved aside, so a sign-in folder the search did not reach would be lost with it."""
    found = []
    for current, dirs, files in os.walk(root, followlinks=False):
        rel_dir = os.path.relpath(current, root)
        if rel_dir == ".":
            dirs[:] = [d for d in dirs if d not in skip_top]
        if depth is not None and rel_dir != "." and rel_dir.count("/") >= depth:
            dirs[:] = []
            continue
        for name in list(dirs) + files:
            rel = name if rel_dir == "." else rel_dir + "/" + name
            if is_credential(rel):
                found.append(rel)
                if name in dirs:
                    dirs.remove(name)
    return found

def ensure_parent(data, previous, rel):
    """Creates the missing parents of data/rel like their counterparts in previous (owner, mode). Never through a link."""
    current, source = data, previous
    for part in rel.split("/")[:-1]:
        current, source = os.path.join(current, part), os.path.join(source, part)
        if os.path.lexists(current):
            if os.path.islink(current) or not os.path.isdir(current):
                raise ValueError("Unsafe sign-in parent")
            continue
        info = os.lstat(source)
        os.mkdir(current, 0o700)
        if os.geteuid() == 0:
            os.chown(current, info.st_uid, info.st_gid)
        os.chmod(current, stat.S_IMODE(info.st_mode))

def carry_preflight(data, restored):
    """Before anything is swapped: every current sign-in can be carried into the restored tree (each parent there is missing or a real
    directory, never a link or a file). Otherwise the reset is refused with nothing changed."""
    for rel in credential_paths(data, skip_top=WORK_DIRS):
        current = restored
        for part in rel.split("/")[:-1]:
            current = os.path.join(current, part)
            if not os.path.lexists(current):
                break
            if os.path.islink(current) or not os.path.isdir(current):
                raise ValueError("Sign-in path blocked in the restored data")

def carry_credentials(previous, data, displaced=None, extra=()):
    """Engine sign-ins never leave the home (never in a backup): a reset or undo keeps the ones it had. Missing parents are recreated;
    the current sign-in wins over anything at the same path; every one is verified moved before the previous tree may be deleted.
    extra: credential-named placeholders found at any depth (credential_paths stops at its depth), carried the same way."""
    found = credential_paths(previous)
    for rel in found + [r for r in extra if r not in found]:
        if not os.path.lexists(os.path.join(previous, rel)):
            continue  # inside a folder carried whole just before, or carried by an earlier, interrupted run
        target = os.path.join(data, rel)
        ensure_parent(data, previous, rel)
        if os.path.lexists(target):
            if displaced is None:
                raise ValueError("Sign-in path occupied")
            os.makedirs(displaced, mode=0o700, exist_ok=True)
            os.rename(target, os.path.join(displaced, rel.replace("/", "%")))
        os.rename(os.path.join(previous, rel), target)
    if credential_paths(previous) or any(os.path.lexists(os.path.join(previous, r)) for r in extra):
        raise ValueError("Sign-ins not carried")

# The home's own sign-in state (paired devices, revocations, recovery and pair-hold ledgers) lives in the app database. It is never
# rolled back by a reset or undo: the current rows replace the restored ones before the swap. Outstanding pairing codes are carried
# only when minted at the home's current generation pin: legacy codes (no generation) and codes of a superseded generation are dropped
# (Astra STEPUP-EMAIL-8 #1), as the app itself does the moment its pin appears or changes.
AUTH_DB = os.path.join("home", "messages.db")
AUTH_TABLES = ("cloud_meta", "cloud_devices", "cloud_browser_factors", "cloud_owner_watermarks", "cloud_recovery", "cloud_access", "cloud_challenges", "cloud_codes",
               "cloud_nonces", "cloud_lockout", "cloud_code_limits", "cloud_source_limits")

def carry_auth_state(current_db, restored_db, generation=None):
    import sqlite3
    if not os.path.isfile(current_db):
        return
    owner = os.lstat(current_db)
    created = not os.path.exists(restored_db)
    if created:
        os.makedirs(os.path.dirname(restored_db), mode=0o700, exist_ok=True)
    connection = sqlite3.connect(restored_db, isolation_level=None)
    try:
        connection.execute("ATTACH DATABASE ? AS cur", (current_db,))
        connection.execute("BEGIN IMMEDIATE")
        try:
            for table in AUTH_TABLES:
                row = connection.execute("SELECT sql FROM cur.sqlite_master WHERE type='table' AND name=?", (table,)).fetchone()
                exists = connection.execute("SELECT 1 FROM main.sqlite_master WHERE type='table' AND name=?", (table,)).fetchone()
                if row is None:
                    if exists:
                        connection.execute('DELETE FROM main."%s"' % table)
                    continue
                if not exists:
                    connection.execute(row[0])
                mine = [c[1] for c in connection.execute('PRAGMA main.table_info("%s")' % table)]
                theirs = [c[1] for c in connection.execute('PRAGMA cur.table_info("%s")' % table)]
                if sorted(mine) != sorted(theirs):
                    raise ValueError("Sign-in tables differ")
                columns = ",".join('"%s"' % c.replace('"', '""') for c in mine)
                connection.execute('DELETE FROM main."%s"' % table)
                connection.execute('INSERT INTO main."%s" (%s) SELECT %s FROM cur."%s"' % (table, columns, columns, table))
                if table == "cloud_codes":
                    connection.execute("DELETE FROM main.cloud_codes WHERE json_extract(payload,'$.homeGeneration') IS NOT ?", (generation,))
            connection.execute("COMMIT")
        except Exception:
            connection.execute("ROLLBACK")
            raise
    finally:
        connection.close()
    if created and os.geteuid() == 0:
        os.chown(restored_db, owner.st_uid, owner.st_gid)
    os.chmod(restored_db, 0o600)

def swap_in(ctx, work, restored, reset_id, operation):
    """Moves the current top level of /data aside and the restored one in. The swap record (names on both sides) is durable before
    the first rename and marked committed after the last, so recover_swap undoes or finishes it exactly at any interruption."""
    data = ctx["paths"]["data"]
    previous = os.path.join(work, "previous")
    os.makedirs(previous, mode=0o700, exist_ok=True)
    record = {"phase": "swap", "aside": sorted(n for n in os.listdir(data) if n not in WORK_DIRS),
              "incoming": sorted(n for n in os.listdir(restored) if n not in WORK_DIRS)}
    write_private(swap_record(ctx, reset_id, operation), record)
    for name in record["aside"]:
        os.rename(os.path.join(data, name), os.path.join(previous, name))
    for name in record["incoming"]:
        os.rename(os.path.join(restored, name), os.path.join(data, name))
    fsync_dir(data)
    write_private(swap_record(ctx, reset_id, operation), dict(record, phase="committed"))
    finish_swap(ctx, work, reset_id, operation, record)

def finish_swap(ctx, work, reset_id, operation, record):
    data = ctx["paths"]["data"]
    if os.path.isdir(work):
        previous = os.path.join(work, "previous")
        # Every caller has the writers confirmed stopped (swap_in after stop_writers, recover_swap after its own), so no turn holds a
        # mask on a placeholder. Which ones were frozen is durable before any flag is cleared: a recovery after a crash at any step
        # here clears and freezes the same set again (each step is idempotent), never losing one that was already cleared or moved.
        # The set lives in the staging folder (as long as it is needed, and of any size), never in the small swap record.
        manifest = os.path.join(work, "frozen.json")
        known = read_frozen(manifest)
        frozen = sorted(set(known) | set(frozen_placeholders(previous)))
        if frozen != known:
            write_private(manifest, frozen)
        for rel in frozen:
            freeze_placeholder(os.path.join(previous, rel), False)
        carry_credentials(previous, data, os.path.join(work, "displaced"), [r for r in frozen if os.path.basename(r) in CREDENTIAL_NAMES])
        for rel in frozen:
            freeze_placeholder(os.path.join(data, rel), True)
        thaw_tree(previous)
        write_private(swap_record(ctx, reset_id, operation), dict(record, phase="carried"))
        shutil.rmtree(work)
    else:
        write_private(swap_record(ctx, reset_id, operation), dict(record, phase="carried"))

def rollback_swap(ctx, work, record, reset_id, operation):
    """Exactly the state before the swap: every installed restored name goes back into staging, every moved name comes back."""
    data = ctx["paths"]["data"]
    previous = os.path.join(work, "previous")
    restored = os.path.join(work, "restore", data.lstrip("/"))
    stray = os.path.join(work, "stray")
    for name in record["incoming"]:
        if not os.path.lexists(os.path.join(restored, name)) and os.path.lexists(os.path.join(data, name)):
            os.makedirs(restored, mode=0o700, exist_ok=True)
            os.rename(os.path.join(data, name), os.path.join(restored, name))
    for name in record["aside"]:
        if os.path.lexists(os.path.join(previous, name)):
            if os.path.lexists(os.path.join(data, name)):  # never expected (the home is stopped): kept aside, not deleted
                os.makedirs(stray, mode=0o700, exist_ok=True)
                os.rename(os.path.join(data, name), os.path.join(stray, name))
            os.rename(os.path.join(previous, name), os.path.join(data, name))
    fsync_dir(data)
    if os.path.isdir(stray):
        raise ValueError("Unexpected data during the swap")  # recovery stays pending for a person; nothing is deleted
    write_private(swap_record(ctx, reset_id, operation), dict(record, phase="rolled_back"))
    shutil.rmtree(work, ignore_errors=True)

RECOVERY_LOCK_SECONDS = 60

def recover_swap(ctx, reset_id, operation, locked=False):
    """From the swap record: none means no rename ever happened (staging is dropped, failed); "swap" is rolled back exactly (failed);
    "committed"/"carried" is finished (done). Runs under the data-operation lock with every writer confirmed stopped before anything
    is moved; the home is started again only once the swap is resolved (carried or rolled back). Any error leaves the writers stopped
    and the recovery pending (raised)."""
    work = work_dir(ctx, reset_id, operation)
    lock = None if locked else ops_lock(ctx, RECOVERY_LOCK_SECONDS)
    try:
        if not stop_writers(ctx):
            raise ValueError("Writers still running")
        record = read_swap(ctx, reset_id, operation)
        if record is None:
            shutil.rmtree(work, ignore_errors=True)
            outcome = "failed"
        elif record["phase"] == "swap":
            rollback_swap(ctx, work, record, reset_id, operation)
            outcome = "failed"
        elif record["phase"] == "rolled_back":
            shutil.rmtree(work, ignore_errors=True)
            outcome = "failed"
        else:
            finish_swap(ctx, work, reset_id, operation, record)
            outcome = "done"
    finally:
        if lock is not None:
            lock.close()
    start_home(ctx)
    return outcome

def swap_unresolved(ctx, reset_id, operation):
    """True while this reset's (or undo's) swap is neither carried nor rolled back: the home must stay stopped."""
    try:
        found = read_swap(ctx, reset_id, operation)
    except ValueError:
        return True
    return found is not None and found["phase"] in ("swap", "committed")

BACKUP_STAGE_DIR = ".murage-backup"

def place_database_snapshot(restored):
    """A nightly snapshot holds the home database as SQLite's online backup in a staging folder (murage-backup), not the live
    WAL files. Put it where the home reads it and drop any -wal/-shm that came with an older snapshot. Absent: nothing to do."""
    stage = os.path.join(restored, BACKUP_STAGE_DIR)
    staged = os.path.join(stage, "messages.db")
    if os.path.isfile(staged) and not os.path.islink(staged):
        live = os.path.join(restored, AUTH_DB)
        for suffix in ("-wal", "-shm"):
            if os.path.lexists(live + suffix):
                os.unlink(live + suffix)
        os.makedirs(os.path.dirname(live), exist_ok=True)
        os.replace(staged, live)
    shutil.rmtree(stage, ignore_errors=True)

def restore_into_place(ctx, cfg, snapshot, reset_id, operation, check_deadline=lambda: None):
    work = work_dir(ctx, reset_id, operation)
    shutil.rmtree(work, ignore_errors=True)
    os.makedirs(work, mode=0o700)
    target = os.path.join(work, "restore")
    code, _ = restic(ctx, cfg, ["restore", snapshot, "--target", target])
    data = ctx["paths"]["data"]
    restored = os.path.join(target, data.lstrip("/"))
    try:
        if code != 0 or not os.path.isdir(restored):
            raise ValueError("Restore failed")
        place_database_snapshot(restored)
        # The current sign-in state replaces the restored one in the staged copy, before anything is swapped.
        carry_auth_state(os.path.join(data, AUTH_DB), os.path.join(restored, AUTH_DB), ctx["binding"].get("generation"))
        carry_preflight(data, restored)
        check_deadline()  # the swap is the irreversible step: never begun after the run deadline
    except Exception:
        shutil.rmtree(work, ignore_errors=True)
        raise
    try:
        swap_in(ctx, work, restored, reset_id, operation)
    except Exception:
        if recover_swap(ctx, reset_id, operation, locked=True) != "done":
            raise

def keep_record(ctx, reset_id):
    return path(ctx, "state", "resets", reset_id + ".json")

DAY_MS = 86400000

def keep_snapshot_from_now(ctx, reset_id):
    """The pre-reset snapshot is kept keepDays from the reset's completion, so Undo has its full window."""
    target = keep_record(ctx, reset_id)
    with open(target) as handle:
        record = json.load(handle)
    record["keepUntil"] = ctx["now"]() + int(record.get("keepDays", 9)) * DAY_MS
    write_private(target, record)

def pre_reset_snapshot(ctx, cfg, payload):
    """Keeps the current /data as a complete restic snapshot (exit 0 only: exit 3 means files were left out) and returns its exact id,
    verified in the repository with the reset's tags. None: not kept, and nothing may be changed."""
    data = ctx["paths"]["data"]
    code, out = restic(ctx, cfg, ["backup", "--json", "--quiet", data, "--exclude-file", path(ctx, "config", "backup-excludes.txt")]
                       + [arg for name in WORK_DIRS[:2] for arg in ("--exclude", os.path.join(data, name))]
                       + ["--one-file-system", "--tag", PRE_RESET_TAG, "--tag", payload["snapshotTag"]])
    if code != 0:
        return None
    reported = None
    for line in out.decode(errors="replace").splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if isinstance(message, dict) and message.get("message_type") == "summary" and isinstance(message.get("snapshot_id"), str):
            reported = message["snapshot_id"]
    if reported is None or not re.fullmatch(r"[0-9a-f]{8,64}", reported):
        return None
    matches = [s for s in list_snapshots(ctx, cfg, [PRE_RESET_TAG, payload["snapshotTag"]]) if s["id"].startswith(reported)]
    if len(matches) != 1 or os.path.normpath(data) not in [os.path.normpath(p) for p in matches[0].get("paths") or [] if isinstance(p, str)]:
        return None
    return matches[0]["id"]

def run_reset(ctx, command):
    payload = command["payload"]
    cfg = backup_config(ctx)
    lock = ops_lock(ctx)
    try:
        last_good = last_good_snapshot(ctx, cfg)
        if last_good is None:
            return "failed"  # no confirmed complete backup to reset to; nothing was changed
        try:
            if not stop_writers(ctx):
                return "failed"  # something still writes /data: nothing is kept or changed
            kept = pre_reset_snapshot(ctx, cfg, payload)
            if kept is None:
                return "failed"  # the current state could not be kept completely: do not touch it
            # Recorded before the swap (so an aborted reset's snapshot is still forgotten in time); restarted from completion below.
            # Undo restores exactly this snapshot id.
            write_private(keep_record(ctx, payload["resetId"]),
                          {"snapshotTag": payload["snapshotTag"], "snapshotId": kept, "keepDays": payload["keepSnapshotDays"],
                           "keepUntil": ctx["now"]() + payload["keepSnapshotDays"] * DAY_MS})
            restore_into_place(ctx, cfg, last_good, payload["resetId"], "reset", lambda: before_deadline(ctx, command))
            try:
                keep_snapshot_from_now(ctx, payload["resetId"])
            except Exception:
                pass  # the record written before the swap still keeps the snapshot keepSnapshotDays from the request
            return "done"
        finally:
            if not swap_unresolved(ctx, payload["resetId"], "reset"):
                start_home(ctx)  # never while a swap or its sign-in carry is unfinished
    finally:
        lock.close()

def run_undo(ctx, command):
    payload = command["payload"]
    try:
        with open(keep_record(ctx, payload["resetId"])) as handle:
            record = json.load(handle)
    except FileNotFoundError:
        return "failed"  # this home never ran that reset, or its window ended
    if record.get("snapshotTag") != payload["snapshotTag"] or record.get("keepUntil", 0) <= ctx["now"]():
        return "failed"
    cfg = backup_config(ctx)
    lock = ops_lock(ctx)
    try:
        kept = record.get("snapshotId")
        if not isinstance(kept, str) or not HEX64.fullmatch(kept) or kept not in [s["id"] for s in list_snapshots(ctx, cfg, [payload["snapshotTag"]])]:
            return "failed"  # exactly the snapshot that reset verified, or nothing
        try:
            if not stop_writers(ctx):
                return "failed"
            restore_into_place(ctx, cfg, kept, payload["resetId"], "undo", lambda: before_deadline(ctx, command))
            return "done"
        finally:
            if not swap_unresolved(ctx, payload["resetId"], "undo"):
                start_home(ctx)  # never while a swap or its sign-in carry is unfinished
    finally:
        lock.close()


def prune_reset_snapshots(ctx):
    """At keepSnapshotUntil the pre-reset snapshot is forgotten (the nightly prune then frees its data)."""
    directory = path(ctx, "state", "resets")
    if not os.path.isdir(directory):
        return
    now, cfg = ctx["now"](), None
    for name in sorted(os.listdir(directory)):
        if not name.endswith(".json"):
            continue
        with open(os.path.join(directory, name)) as handle:
            record = json.load(handle)
        if record.get("keepUntil", 0) > now or not re.fullmatch(PRE_RESET_TAG + "-" + UUID.pattern, str(record.get("snapshotTag"))):
            continue
        cfg = cfg or backup_config(ctx)
        # restic forget needs snapshot ids (a bare --tag filter with no policy removes nothing).
        code, out = restic(ctx, cfg, ["snapshots", "--json", "--tag", record["snapshotTag"]])
        if code != 0:
            continue
        ids = [s["id"] for s in json.loads(out.decode()) if isinstance(s, dict) and re.fullmatch(r"[0-9a-f]{64}", str(s.get("id")))
               and record["snapshotTag"] in (s.get("tags") or [])]
        if not ids or restic(ctx, cfg, ["forget"] + ids)[0] == 0:
            os.unlink(os.path.join(directory, name))


# ---- redaction (logs and the export's secret scan) ---------------------------------------------------------------------
# The same rules as the control plane's redact() (cloudflare/control-plane/src/self-service.ts), which applies them again.
# Engine sign-in directories are never opened for this: secrets are found by pattern, by field name and by the few
# literal values this runner already holds (its machine credential, the backup password, secret-named environment values).

CREDENTIAL_PATH = re.compile(r"[^\s\"'=]*/(?:\.claude(?:\.json)?|\.codex|\.grok|\.kimi-code|\.gemini|\.qwen|\.cursor|\.factory|\.droid|"
                             r"\.antigravity|\.config/opencode|\.local/share/opencode|auth\.json|\.credentials\.json|credentials(?:\.json)?)"
                             r"(?:/[^\s\"']*)?")
SECRET_NAME = r"[A-Za-z0-9_]*(?:TOKEN|SECRET|KEY|PASSWORD|PASSWD|CREDENTIAL|AUTH|COOKIE|SESSION)[A-Za-z0-9_]*"
SECRET_FIELD = (r"[A-Za-z0-9_.-]*(?:password|passwd|passphrase|secret|token|api[_-]?key|apikey|auth|authorization|credential|cookie|session|"
                r"private[_-]?key|client[_-]?secret|code[_-]?verifier|signature|bearer)[A-Za-z0-9_.-]*")
TEXT_FIELD = r"(?:content|prompt|text|body|transcript|completion|reply|message_text|input|output)"
VALUE = r"(?:\"(?:[^\"\\]|\\.)*\"?|'(?:[^'\\]|\\.)*'?|[^\s,;&}\]]+)"
PATTERNS = [
    (re.compile(r"[\u0000-\u001f\u007f]"), " "),
    (re.compile(r"-----BEGIN [A-Z ]+-----[\s\S]*?(-----END [A-Z ]+-----|$)"), "[redacted-key]"),
    # Whole header values: every cookie in a Cookie line, every scheme of an Authorization line.
    (re.compile(r"\b((?:proxy-)?authorization|cookie|set-cookie)\b(\s*[\"']?\s*[:=]\s*).*$", re.I), r"\1\2[redacted]"),
    (re.compile(r"\b(bearer|basic)\s+[^\s\"',;]+", re.I), r"\1 [redacted]"),
    # name=value, name: value, "name": "value", JSON and query strings: the whole value, quoted values with spaces included.
    (re.compile(r"([\"']?)\b(" + SECRET_FIELD + r")\b\1(\s*[:=]\s*)(?!\[redacted)" + VALUE, re.I), r"\1\2\1\3[redacted]"),
    # Free text a person wrote (chat, prompts, files) under its usual field names.
    (re.compile(r"([\"'])(" + TEXT_FIELD + r")\1(\s*:\s*)\"(?:[^\"\\]|\\.)*\"?", re.I), r'\1\2\1\3"[redacted-text]"'),
    (re.compile(r"\beyJ[\w-]{4,}\.[\w-]{4,}\.[\w-]*"), "[redacted-token]"),
    (re.compile(r"\b(sk-ant-|sk-proj-|sk-|xai-|AIza|AKIA|murage_install_|sk_live_|sk_test_|rk_live_|whsec_|ghp_|gho_|github_pat_|xox[abpr]-|"
                r"sb_secret_|sb_publishable_)[\w.-]+", re.I), "[redacted-token]"),
    (CREDENTIAL_PATH, "[redacted-path]"),
    (re.compile(r"[\w.+-]+@[\w-]+(\.[\w-]+)+"), "[redacted-email]"),
    (re.compile(r"\b(\d{1,3}\.){3}\d{1,3}\b"), "[redacted-ip]"),
    (re.compile(r"\b[0-9a-f]{0,4}(:[0-9a-f]{0,4}){2,7}\b", re.I), lambda m: "[redacted-ip]" if m.group(0).count(":") > 2 else m.group(0)),
    # Long quoted free text.
    (re.compile(r"\"[^\"]{40,}\"|'[^']{40,}'"), '"[redacted-text]"'),
    (re.compile(r"[A-Za-z0-9+/_=-]{24,}"), "[redacted]"),
]

def redact(message, known):
    for value in known:
        message = message.replace(value, "[redacted]")
    for pattern, replacement in PATTERNS:
        message = pattern.sub(replacement, message)
    return message

def process_environs(ctx):
    """Environments that may hold secrets: this process and the Murage server's main process."""
    environs = [dict(os.environ)]
    code, out = ctx["run"](["/usr/bin/systemctl", "show", "-p", "MainPID", "--value", HOME_UNIT], timeout=30)
    pid = out.decode(errors="replace").strip() if code == 0 else ""
    if re.fullmatch(r"[1-9][0-9]{0,9}", pid):
        try:
            with open("/proc/%s/environ" % pid, "rb") as handle:
                pairs = handle.read(1 << 20).split(b"\0")
            environs.append(dict(p.decode(errors="replace").split("=", 1) for p in pairs if b"=" in p))
        except OSError:
            pass
    return environs

def known_secrets(ctx):
    """Literal values that must never leave the home and that this runner already holds: the machine credential, the
    backup password and secret-named environment values. Engine sign-in files are never opened (patterns cover them)."""
    found = {ctx["binding"]["credential"]}
    for environ in ctx["environs"](ctx):
        for name, value in environ.items():
            if re.fullmatch(SECRET_NAME, name, re.I) and len(value) >= 8:
                found.add(value)
    try:
        cfg = backup_config(ctx)
        with open(cfg["passwordFile"], "rb") as handle:
            found.add(handle.read(4096).decode(errors="replace").strip())
    except (OSError, ValueError):
        pass
    return sorted((v for v in found if v and len(v) >= 8), key=len, reverse=True)


# ---- collect_logs ---------------------------------------------------------------------------------------------------------

LEVELS = {0: "error", 1: "error", 2: "error", 3: "error", 4: "warn", 5: "info", 6: "info", 7: "debug"}
# The only messages that leave the home: these diagnostic events (shared/self-service-contract.json logEvents, which both sides are
# tested against). Each is fixed text with bounded numbers or fixed words; nothing a person typed can match one. Any other line, from
# any unit, is replaced by a count before it is sent ("[3 lines omitted]"). Secret scrubbing still runs over what is kept.
LOG_EVENTS = (
    r"server started on port \d{1,5}",
    r"started scheduler in \d{1,7} ms",
    r"backup finished: \d{1,9} files, \d{1,9} MB",
    r"backup refused: exclusion list incomplete",
    r"Cloud control (?:clock authority unavailable|poll unavailable|readiness refused)",
    r"Cloud enrollment refused",
    r"Cloud home stopped: stale generation; operator recovery required",
    r"Cloud home unwrap (?:failed|returned no valid envelope)",
    r"Self-service command (?:restart_service|safe_mode|update_software|reset_from_backup|undo_reset|collect_logs|export_archive|unknown): "
    r"(?:done|failed|unsupported|reported)",
    r"Self-service (?:command poll|housekeeping|start-up recovery) unavailable",
    r"Self-service (?:command runner refused|recovery pending|update rollback unhealthy)",
    # The Cloud door (server/cloud-home/door-log.ts): one fixed line per outcome, no ticket, key, cookie, id or address.
    r"Cloud door (?:state|enter): (?:source_locked|budget_closed|internal_error|origin_refused|query_token_refused|bearer_refused|body_too_large|body_malformed|state_answered|state_rate_limited|door_unconfigured|home_unbound|ticket_malformed|ticket_wrong_type|ticket_bad_signature|ticket_wrong_home|ticket_expired|ticket_bad_times|ticket_stale_step_up|ticket_reused|account_suspended|account_mismatch|device_key_invalid|device_bind_refused|device_proof_refused|assertion_proof_refused|device_limit|desktop_hold_required|pair_hold_refused|signed_in_first|signed_in_known|signed_in_added)",
    r"Cloud door page: (?:no_ticket|device_load|device_save|device_forget|refresh|bounce|v1_record|unexpected|unknown) (?:none|NotAllowedError|AbortError|InvalidStateError|SecurityError|NotSupportedError|ConstraintError|UnknownError|DataError|QuotaExceededError|TimeoutError|TypeError|NetworkError|OperationError|VersionError|ReadOnlyError|SyntaxError|unknown)",
    r"Cloud door page: device_open (?:timeout|blocked|error|unknown) (?:chrome|safari|firefox|edge|other|unknown)",
    r"Cloud owner factor: (?:owner_factor_issued|owner_factor_renewed|owner_factor_withheld)(?: (?:stale_proof|proof_kind_after_revoke))?",
    r"(?:Error|TypeError|RangeError|ReferenceError|SyntaxError|AbortError|TimeoutError)(?: \[ERR_[A-Z0-9_]{1,60}\])?",
    r"at (?:(?:async )?[A-Za-z0-9_$.<>\[\] ]{1,100} )?\(?(?:/opt/murage/[A-Za-z0-9_./@-]{1,200}|node:[a-z_/]{1,80}):\d{1,7}:\d{1,7}\)?",
    r"\[\d{1,4} lines? omitted\]",
)
LOG_EVENT_PATTERNS = tuple(re.compile(p) for p in LOG_EVENTS)

def allowed_event(message):
    """The message itself when it is an allowed diagnostic event, else None (it is never sent)."""
    text = re.sub(r"[\u0000-\u001f\u007f]", " ", message).strip()
    return text if any(p.fullmatch(text) for p in LOG_EVENT_PATTERNS) else None

def run_logs(ctx, command):
    limit = command["payload"]["maxLines"]
    argv = ["journalctl", "--no-pager", "-o", "json", "-n", str(limit)]
    for unit in LOG_UNITS:
        argv += ["-u", unit]
    code, out = ctx["run"](argv, limit=16 << 20, timeout=120)
    if code != 0:
        return "failed"
    known = known_secrets(ctx)
    lines = []
    for raw in out.splitlines()[-limit:]:
        try:
            entry = json.loads(raw)
            message = entry.get("MESSAGE")
            if isinstance(message, list):
                message = bytes(b for b in message if isinstance(b, int) and 0 <= b < 256).decode(errors="replace")
            if not isinstance(message, str) or not message.strip():
                continue
            at = int(entry["__REALTIME_TIMESTAMP"]) // 1000  # microseconds -> epoch milliseconds
            level = LEVELS.get(int(entry.get("PRIORITY", 6)), "info")
        except (ValueError, KeyError, TypeError):
            continue
        source = LOG_UNITS.get(entry.get("_SYSTEMD_UNIT"))
        if source is None:
            continue  # not an allow-listed unit (journalctl -u also matches other fields): dropped, never relabelled
        if not 0 <= at <= MAX_SAFE:
            continue
        event = allowed_event(message)
        text = redact(event, known)[:LOG_MESSAGE].strip() if event is not None else ""
        if text and text == event:
            lines.append({"at": at, "level": level, "source": source, "message": text})
            continue
        # Not an allowed event (or scrubbing had to change it): only the fact that a line was there is sent, never its text.
        last = lines[-1] if lines else None
        omitted = re.fullmatch(r"\[(\d{1,4}) lines? omitted\]", last["message"]) if last else None
        if omitted and last["source"] == source and last["level"] == level and int(omitted.group(1)) < 9999:
            count = int(omitted.group(1)) + 1
            last["message"] = "[%d lines omitted]" % count
        else:
            lines.append({"at": at, "level": level, "source": source, "message": "[1 line omitted]"})
    chunks = [lines[i:i + LOG_CHUNK] for i in range(0, len(lines), LOG_CHUNK)][:LOG_CHUNKS] or [[]]
    binding = ctx["binding"]
    for index, chunk in enumerate(chunks):
        answer = ctx["request"](binding, "logs", {"generation": binding["generation"], "commandId": command["id"], "chunk": index,
                                                  "final": index == len(chunks) - 1, "lines": chunk})
        if not isinstance(answer, dict) or answer.get("accepted") is not True:
            return "failed"
    return "reported"


# ---- export_archive -------------------------------------------------------------------------------------------------------

BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"

def _polymod(values):
    generator = [0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3]
    check = 1
    for value in values:
        top = check >> 25
        check = (check & 0x1ffffff) << 5 ^ value
        for i in range(5):
            check ^= generator[i] if ((top >> i) & 1) else 0
    return check

def age_identity(key):
    """The age X25519 identity for 32 secret bytes (AGE-SECRET-KEY-1..., bech32)."""
    hrp, data, acc, bits = "age-secret-key-", [], 0, 0
    for byte in key:
        acc, bits = (acc << 8) | byte, bits + 8
        while bits >= 5:
            bits -= 5
            data.append((acc >> bits) & 31)
    if bits:
        data.append((acc << (5 - bits)) & 31)
    expanded = [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp]
    polymod = _polymod(expanded + data + [0] * 6) ^ 1
    checksum = [(polymod >> 5 * (5 - i)) & 31 for i in range(6)]
    return (hrp + "1" + "".join(BECH32[d] for d in data + checksum)).upper()

def export_rules(ctx):
    """backup-excludes.txt (the same list the backup refuses to run without) plus the export-only skips."""
    with open(path(ctx, "config", "backup-excludes.txt")) as handle:
        patterns = [l.strip() for l in handle if l.strip() and not l.startswith("#")]
    backup = ctx["backup"]
    if any(r not in patterns for r in backup.REQUIRED_EXCLUDES):
        raise ValueError("Exclusion list incomplete")
    expressions = []
    for pattern in patterns:
        body = re.escape(pattern).replace(r"\*\*", "\0").replace(r"\*", "[^/]*").replace("\0", ".*")
        if pattern.startswith("/"):  # anchored: matched against the /data path
            expressions.append(re.compile("^" + body + "(/.*)?$"))
        else:
            expressions.append(re.compile("(^|/)" + body + "(/.*)?$"))
    return expressions

def excluded(rel, rules):
    absolute = "/data/" + rel
    if rel.split("/")[0] in WORK_DIRS or any(rel == s or rel.startswith(s + "/") for s in EXPORT_SKIP) or is_credential(rel):
        return True
    return any(r.search(absolute) if r.pattern.startswith("^") else r.search(rel) for r in rules)

def contains_secret(full, known, scan_limit=16 << 20):
    try:
        if os.lstat(full).st_size > scan_limit:
            return False
        with open(full, "rb") as handle:
            content = handle.read(scan_limit)
    except OSError:
        return True
    return any(value.encode() in content for value in known)

def write_tar(ctx, stream, known, rules, stopped=lambda: False):
    data = ctx["paths"]["data"]
    skipped = 0
    with tarfile.open(fileobj=stream, mode="w|", format=tarfile.PAX_FORMAT) as tar:
        for current, dirs, files in os.walk(data, followlinks=False):
            if stopped():
                raise ExportStopped()
            rel_dir = os.path.relpath(current, data)
            keep = []
            for name in sorted(dirs):
                rel = name if rel_dir == "." else rel_dir + "/" + name
                full = os.path.join(current, name)
                if excluded(rel, rules):
                    continue
                if os.path.islink(full):
                    files.append(name)  # a link to a directory is stored as a link
                    continue
                keep.append(name)
                tar.add(full, arcname="data/" + rel, recursive=False)
            dirs[:] = keep
            for name in sorted(files):
                if stopped():
                    raise ExportStopped()
                rel = name if rel_dir == "." else rel_dir + "/" + name
                full = os.path.join(current, name)
                if excluded(rel, rules):
                    continue
                info = os.lstat(full)
                if stat.S_ISLNK(info.st_mode):
                    tar.add(full, arcname="data/" + rel, recursive=False)
                elif stat.S_ISREG(info.st_mode):
                    if contains_secret(full, known):
                        skipped += 1  # a file holding a home secret is left out
                        continue
                    tar.add(full, arcname="data/" + rel, recursive=False)
    return skipped

class ExportStopped(Exception):
    """The archive outgrew its limit, the disk's headroom or the run deadline while it was being produced."""

def sftp_target(repository):
    """(user, host, port) of the backup space from the restic repository the provisioner writes (sftp://user@host:23/restic), or the
    older sftp:user@host:path form (port 22). Validated; the port is kept."""
    if repository.startswith("sftp://"):
        parts = urllib.parse.urlsplit(repository)
        try:
            port = parts.port or 22
        except ValueError:
            raise ValueError("No backup space") from None
        user, host = parts.username, parts.hostname
        if parts.password is not None or parts.query or parts.fragment:
            raise ValueError("No backup space")
    else:
        match = re.fullmatch(r"sftp:([^@/:]+)@([^@/:]+):.*", repository)
        if not match:
            raise ValueError("No backup space")
        user, host, port = match.group(1), match.group(2), 22
    if (not isinstance(user, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", user) or user.startswith("-")
            or not isinstance(host, str) or not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", host) or host.startswith(("-", "."))
            or not 1 <= port <= 65535):
        raise ValueError("No backup space")
    return user, host, port

def upload_export(ctx, local, remote):
    """sftp batch to the backup space (the restic sub-account). Fixed commands; the paths are validated above."""
    cfg = backup_config(ctx)
    user, host, port = sftp_target(cfg["repository"])
    directory = os.path.dirname(remote)
    with tempfile.NamedTemporaryFile("w", prefix="murage-export-", suffix=".batch", delete=False) as batch:
        batch.write("-mkdir exports\n-mkdir %s\nput %s %s.part\n-rm %s\nrename %s.part %s\n"
                    % (directory, local, remote, remote, remote, remote))
    try:
        code, _ = ctx["run"](["sftp", "-b", batch.name, "-P", str(port), "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
                              "-o", "UserKnownHostsFile=" + cfg["knownHosts"], "-i", cfg["sshKey"], user + "@" + host], timeout=6 * 3600)
    finally:
        os.unlink(batch.name)
    if code != 0:
        raise ValueError("Export upload failed")

# The export never fills the data disk: production stops before less than this is left (or the archive passes maxBytes).
EXPORT_HEADROOM_BYTES = 2 << 30

def export_staging(ctx):
    return path(ctx, "data", ".murage-export")

def clean_export_staging(ctx):
    """Export staging belongs to the one export that may run (ops lock): anything left there was abandoned by an interruption."""
    shutil.rmtree(export_staging(ctx), ignore_errors=True)

EXPORT_DEADLINE_POLL_SECONDS = 1
EXPORT_STOP_SECONDS = 60

def bounded_wait(child, halt):
    """A child's exit code, waited for at most EXPORT_STOP_SECONDS (then killed and waited again, briefly). None: it did not exit."""
    try:
        return child.wait(timeout=EXPORT_STOP_SECONDS)
    except subprocess.TimeoutExpired:
        halt("stuck")
        try:
            return child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            return None

def produce_archive(ctx, command, archive, recipient, known, rules, limit):
    """tar | zstd | age, written here by this process so the size is enforced while the archive is produced: past `limit`, below the
    disk headroom or past the run deadline both children are stopped and ExportStopped is raised. Returns (bytes, sha256 hex)."""
    env = {"PATH": "/usr/bin:/bin"}
    spawn = ctx["spawn"]
    zstd = spawn(["zstd", "-q", "-T0", "-c"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env, close_fds=True)
    age = spawn(["age", "-r", recipient], stdin=zstd.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env, close_fds=True)
    zstd.stdout.close()
    state = {"size": 0, "digest": hashlib.sha256(), "stop": None}
    data = ctx["paths"]["data"]

    def halt(reason):
        state["stop"] = reason
        for child in (zstd, age):
            try:
                child.kill()
            except OSError:
                pass

    def drain():
        try:
            fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as out:
                chunks = 0
                while True:
                    chunk = age.stdout.read(1 << 20)
                    if not chunk:
                        return
                    if state["size"] + len(chunk) > limit:
                        return halt("limit")
                    chunks += 1
                    if chunks % 16 == 0 and (ctx["disk_free"](data) < EXPORT_HEADROOM_BYTES or ctx["now"]() >= command["expiresAt"]):
                        return halt("room")
                    state["size"] += len(chunk)
                    state["digest"].update(chunk)
                    out.write(chunk)
        except BaseException:
            halt("error")

    finished = threading.Event()

    def deadline_watch():
        # The run deadline holds whatever the output does (a highly compressible archive writes almost nothing).
        while not finished.wait(EXPORT_DEADLINE_POLL_SECONDS):
            if ctx["now"]() >= command["expiresAt"]:
                return halt("deadline")

    reader = threading.Thread(target=drain, daemon=True)
    watch = threading.Thread(target=deadline_watch, daemon=True)
    reader.start()
    watch.start()

    def stopped():
        if state["stop"] is None and ctx["now"]() >= command["expiresAt"]:
            halt("deadline")
        return state["stop"] is not None

    try:
        write_tar(ctx, zstd.stdin, known, rules, stopped=stopped)
    except (OSError, ValueError, ExportStopped, tarfile.TarError):
        if state["stop"] is None:
            halt("error")
    finally:
        try:
            zstd.stdin.close()
        except OSError:
            pass
        zstd_code, age_code = bounded_wait(zstd, halt), None
        reader.join(EXPORT_STOP_SECONDS)
        if reader.is_alive():
            halt("stuck")
            reader.join(EXPORT_STOP_SECONDS)
        age_code = bounded_wait(age, halt)
        finished.set()
        watch.join(EXPORT_STOP_SECONDS)
    if reader.is_alive() or zstd_code is None or age_code is None:
        raise ValueError("Export children did not stop")
    if state["stop"] is not None:
        raise ExportStopped()
    if zstd_code != 0 or age_code != 0:
        raise ValueError("Export archive failed")
    return state["size"], state["digest"].hexdigest()

def run_export(ctx, command):
    payload = command["payload"]
    rid, remote = payload["requestId"], payload["path"]
    rules = export_rules(ctx)
    known = known_secrets(ctx)
    lock = ops_lock(ctx)
    work = os.path.join(export_staging(ctx), rid)
    key = bytearray(random_source.token_bytes(32))
    try:
        clean_export_staging(ctx)
        os.makedirs(work, mode=0o700)
        # The identity goes to age-keygen on stdin: it is never written to a file.
        code, out = ctx["run"](["age-keygen", "-y"], stdin=(age_identity(bytes(key)) + "\n").encode(), timeout=60)
        recipient = out.decode(errors="replace").strip()
        if code != 0 or not re.fullmatch(r"age1[0-9a-z]{58}", recipient):
            raise ValueError("Export key failed")
        limit = min(payload["maxBytes"], ctx["disk_free"](ctx["paths"]["data"]) - EXPORT_HEADROOM_BYTES)
        if limit <= 0:
            return "failed"  # no room on the data disk: the operator sends it by hand
        archive = os.path.join(work, "archive.tar.zst.age")
        try:
            size, digest = produce_archive(ctx, command, archive, recipient, known, rules, limit)
        except ExportStopped:
            return "failed"  # over the home's archive budget, the disk's headroom or the deadline: the operator sends it by hand
        before_deadline(ctx, command)  # the upload is the step that uses storage: never begun after the run deadline
        ctx["upload"](ctx, archive, remote)
        binding = ctx["binding"]
        body = {"generation": binding["generation"], "commandId": command["id"], "requestId": rid, "file": remote,
                "format": "tar.zst.age", "bytes": size, "sha256": digest,
                "key": base64.urlsafe_b64encode(bytes(key)).decode().rstrip("=")}
        for attempt in range(3):
            try:
                answer = ctx["request"](binding, "export-ready", body)
                if isinstance(answer, dict) and answer.get("accepted") is True:
                    return "reported"
                return "failed"
            except urllib.error.HTTPError:
                return "failed"
            except Exception:
                if attempt == 2:
                    return "failed"
                ctx["sleep"](10)
        return "failed"
    finally:
        for i in range(len(key)):
            key[i] = 0
        clean_export_staging(ctx)
        lock.close()


def run(ctx, monotonic=time.monotonic):
    # Before any command is accepted: an update in flight is driven forward or back, abandoned export staging removed, and
    # interrupted resets and undos recovered.
    for step in (drive_pending_update, clean_export_staging, recover_interrupted, release_stale_inhibit):
        try:
            step(ctx)
        except Exception:
            print("Self-service start-up recovery unavailable", file=sys.stderr)
    next_prune = monotonic()
    while True:
        try:
            poll_once(ctx)
        except Exception:
            # Remote bytes and local errors stay private.
            print("Self-service command poll unavailable", file=sys.stderr)
        try:
            stuck = drive_pending_update(ctx)  # an update in flight is driven on every loop, whether or not its command is still listed
            report_update_state(ctx, stuck)
            recover_interrupted(ctx)  # unfinished recoveries (a sign-in carry that failed) are retried until they complete
            release_stale_inhibit(ctx)
            retry_unacknowledged(ctx)
        except Exception:
            print("Self-service command poll unavailable", file=sys.stderr)
        if monotonic() >= next_prune:
            try:
                prune_reset_snapshots(ctx)
                journal_prune(ctx)
            except Exception:
                print("Self-service housekeeping unavailable", file=sys.stderr)
            next_prune = monotonic() + 3600
        ctx["sleep"](POLL_SECONDS)


RUNNERS = {"restart_service": run_restart, "safe_mode": run_safe_mode, "update_software": run_update, "reset_from_backup": run_reset,
           "undo_reset": run_undo, "collect_logs": run_logs, "export_archive": run_export}


# ---- main -----------------------------------------------------------------------------------------------------------------

def main(recover_only=False):
    control = load_module("murage_control", CONTROL)
    backup = load_module("murage_backup", BACKUP)
    deadline = time.monotonic() + 300
    while True:
        try:
            binding = control.load_private_binding()
            break
        except FileNotFoundError:
            if time.monotonic() >= deadline:
                raise ValueError("Command binding readiness expired") from None
            time.sleep(5)
    ctx = default_context(binding, backup, control)
    os.makedirs(path(ctx, "state", "commands"), mode=0o700, exist_ok=True)
    if recover_only:
        # `murage-commands --recover-update`: the same drive_update, once, in the foreground, with no override flags (I3). The grants it
        # issues are answered by the gate it serves; while the service is up that service owns the gate socket and drives the update on
        # its own, so the foreground run only reports and leaves (exit 75) rather than stealing the socket.
        if unit_state("murage-commands.service") == "active":
            print("Self-service update runner is active; it drives the update itself", file=sys.stderr)
            return 75
        gate_server(ctx)
        try:
            drive_update(ctx)
        except Pending:
            print("Self-service recovery pending", file=sys.stderr)
            return 75
        except Stuck:
            return 1
        return 0
    gate_server(ctx)
    run(ctx)

if __name__ == "__main__":
    try:
        if os.geteuid() != 0 or sys.argv[1:] not in ([], ["--recover-update"]):
            raise ValueError("Root runner required")
        os.umask(0o077)
        sys.exit(main(recover_only=bool(sys.argv[1:])))
    except Exception:
        print("Self-service command runner refused", file=sys.stderr)
        sys.exit(78)
