#!/bin/bash
# mount -o ro -t TYPE DEV DIR: lay a fixture tree for DEV into DIR.
. "$(dirname "$0")/common.sh"
[[ $1 == -o && $2 == ro && $3 == -t ]] || { echo "mount mock: not a read-only typed mount: $*" >&2; exit 32; }
dev=$5 dir=$6
echo "mount $*" >> "${MOCK_LOG:-/dev/null}"
cfg() { # cfg ROOT_ARG [EXTRA]
    mkdir -p "$(dirname "$dir/$1")"
    cat > "$dir/$1"
}
linux_line() { printf '\tlinux\t/boot/vmlinuz-6.8.0-142-generic %s ro  consoleblank=0 console=tty1 %s\n' "$1" "${2:-}"; }
case $dev in
    /dev/sda1)
        mkdir -p "$dir/var/lib/dpkg" "$dir/boot/grub"
        printf '# GRUB Environment Block\nsaved_entry=0\n' > "$dir/boot/grub/grubenv"
        [[ $scn == grubenv_prefix ]] && printf '# GRUB Environment Block\nprefix=/\n' > "$dir/boot/grub/grubenv"
        for k in vmlinuz vmlinuz-6.8.0-142-generic initrd.img-6.8.0-142-generic vmlinuz-6.8.0-138-generic initrd.img-6.8.0-138-generic; do : > "$dir/boot/$k"; done
        printf 'Package: bash\nStatus: install ok installed\n' > "$dir/var/lib/dpkg/status"
        # the rest of the boot closure: GRUB modules, lists and fonts, and the systemd generators (usr-merged: /lib is a link)
        mkdir -p "$dir/boot/grub/x86_64-efi" "$dir/boot/grub/i386-pc" "$dir/boot/grub/fonts" "$dir/usr/lib/systemd/system-generators" "$dir/etc/systemd/system-generators" "$dir/usr/libexec/netplan"
        ln -s usr/lib "$dir/lib"
        for m in normal ext2 part_gpt gzio; do printf 'module %s\n' "$m" > "$dir/boot/grub/x86_64-efi/$m.mod"; done
        printf 'ext2\n' > "$dir/boot/grub/x86_64-efi/fs.lst"; printf 'glyphs\n' > "$dir/boot/grub/fonts/unicode.pf2"; printf 'boot\n' > "$dir/boot/grub/i386-pc/boot.img"
        printf '#!/bin/sh\nfstab\n' > "$dir/usr/lib/systemd/system-generators/systemd-fstab-generator"; chmod 755 "$dir/usr/lib/systemd/system-generators/systemd-fstab-generator"
        printf 'netplan generate\n' > "$dir/usr/libexec/netplan/generate"
        ln -s ../../../libexec/netplan/generate "$dir/usr/lib/systemd/system-generators/netplan"
        ln -s /dev/null "$dir/etc/systemd/system-generators/systemd-gpt-auto-generator"
        [[ $scn == extra_module ]] && printf 'evil\n' > "$dir/boot/grub/x86_64-efi/evil.mod"
        [[ $scn == wrong_hash_module ]] && printf 'module normal, replaced\n' > "$dir/boot/grub/x86_64-efi/normal.mod"
        [[ $scn == missing_module ]] && rm "$dir/boot/grub/x86_64-efi/ext2.mod"
        [[ $scn == extra_lst ]] && printf 'x\n' > "$dir/boot/grub/x86_64-efi/command.lst"
        [[ $scn == extra_grub_dotfile ]] && printf 'x\n' > "$dir/boot/grub/.hidden"
        [[ $scn == extra_generator ]] && { printf '#!/bin/sh\nevil\n' > "$dir/usr/lib/systemd/system-generators/evil-generator"; chmod 755 "$dir/usr/lib/systemd/system-generators/evil-generator"; }
        [[ $scn == extra_etc_generator ]] && { printf '#!/bin/sh\nevil\n' > "$dir/etc/systemd/system-generators/zz"; }
        [[ $scn == wrong_hash_generator ]] && printf '#!/bin/sh\nreplaced\n' > "$dir/usr/lib/systemd/system-generators/systemd-fstab-generator"
        [[ $scn == wrong_link_target_file ]] && printf 'replaced\n' > "$dir/usr/libexec/netplan/generate"
        [[ $scn == generator_link_changed ]] && { rm "$dir/usr/lib/systemd/system-generators/netplan"; ln -s ../../../libexec/netplan/other "$dir/usr/lib/systemd/system-generators/netplan"; printf 'x\n' > "$dir/usr/libexec/netplan/other"; }
        [[ $scn == generator_link_newline ]] && { rm "$dir/usr/lib/systemd/system-generators/netplan"; ln -s $'../../../libexec/netplan/generate\n' "$dir/usr/lib/systemd/system-generators/netplan"; }
        [[ $scn == lib_link_newline ]] && { rm "$dir/lib"; ln -s $'usr/lib\n' "$dir/lib"; }
        [[ $scn == generator_link_outside ]] && { rm "$dir/usr/lib/systemd/system-generators/netplan"; ln -s /etc/hostname "$dir/usr/lib/systemd/system-generators/netplan"; }
        [[ $scn == generator_dir_link ]] && { mv "$dir/etc/systemd/system-generators" "$dir/etc/elsewhere"; ln -s ../../elsewhere "$dir/etc/systemd/system-generators"; mv "$dir/etc/elsewhere" "$dir/elsewhere"; }
        [[ $scn == run_generator ]] && { mkdir -p "$dir/run/systemd/system-generators"; printf 'x\n' > "$dir/run/systemd/system-generators/evil"; }
        [[ $scn == lib_not_link ]] && { rm "$dir/lib"; mkdir -p "$dir/lib/systemd/system-generators"; printf 'x\n' > "$dir/lib/systemd/system-generators/evil"; }
        rarg="root=UUID=$ROOT_UUID"
        [[ -n $root_label ]] && rarg="root=LABEL=cloudimg-rootfs"
        [[ $scn == grub_uuid_mismatch ]] && rarg="root=UUID=$OTHER_UUID"
        extra=""
        [[ $scn == init_override ]] && extra="init=/bin/bash"
        {
            # the shape of Ubuntu's generated grub.cfg: comments, functions, if blocks, variable expansion, submenu
            cat <<'STOCK'
#
# DO NOT EDIT THIS FILE
#
### BEGIN /etc/grub.d/00_header ###
if [ -s $prefix/grubenv ]; then
  set have_grubenv=true
  load_env
fi
if [ "${next_entry}" ] ; then
   set default="${next_entry}"
   set next_entry=
   save_env next_entry
   set boot_once=true
else
   set default="0"
fi
function savedefault {
  if [ -z "${boot_once}" ]; then
    saved_entry="${chosen}"
    save_env saved_entry
  fi
}
function load_video {
  if [ x$feature_all_video_module = xy ]; then
    insmod all_video
  else
    insmod efi_gop
    insmod efi_uga
  fi
}
if loadfont unicode ; then
  set gfxmode=auto
  load_video
  insmod gfxterm
fi
terminal_output console
terminal_input console
export menuentry_id_option
function gfxmode {
  set gfxmode=${1}
  load_video
}
function recordfail {
  set recordfail=1
  # comment with chainloader and source words in it
  save_env recordfail
}
if [ $grub_platform = efi ]; then
  set timeout=0
elif sleep --interruptible 0 ; then
  set timeout=0
fi
set linux_gfx_mode=text
export linux_gfx_mode
### END /etc/grub.d/00_header ###
submenu 'Advanced options for Ubuntu' $menuentry_id_option 'gnulinux-advanced-ed286e63' {
STOCK
            echo "menuentry 'Ubuntu' {"
            echo "	recordfail"
            echo "	gfxmode \$linux_gfx_mode"
            echo "	insmod part_gpt"
            echo "	if [ x\$grub_platform = xxen ]; then insmod xzio; insmod lzopio; fi"
            echo "	set root='hd0,gpt1'"
            echo "	search --no-floppy --fs-uuid --set=root --hint-bios=hd0,gpt1 $ROOT_UUID"
            linux_line "$rarg" "$extra"
            echo "	initrd	/boot/initrd.img-6.8.0-142-generic"
            echo "}"
            [[ $scn == search_mismatch ]] && echo "	search --no-floppy --fs-uuid --set=root $OTHER_UUID"
            [[ $scn == second_entry_mismatch ]] && { echo "menuentry 'Other' {"; linux_line "root=UUID=$OTHER_UUID"; echo "}"; }
            [[ $scn == set_prefix ]] && echo "	set prefix=/var/tmp"
            [[ $scn == bad_arg_break ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro break=premount"
            [[ $scn == bad_arg_run ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro systemd.run=/bin/bash"
            [[ $scn == initrd_second ]] && echo "	initrd	/boot/initrd.img-6.8.0-142-generic (hd0,gpt15)/evil.cpio"
            [[ $scn == initrd_var ]] && echo "	initrd	\$prefix/evil.img"
            [[ $scn == kernel_missing ]] && echo "	linux	/boot/no-such-kernel root=UUID=$ROOT_UUID ro"
            [[ $scn == kernel_on_esp ]] && echo "	linux	/EFI/evil/vmlinuz root=UUID=$ROOT_UUID ro"
            [[ $scn == legacy_cfg ]] && echo "	legacy_configfile /boot/menu.lst"
            [[ $scn == insmod_path ]] && echo "	insmod (hd0,gpt15)/evil.mod"
            [[ $scn == function_override ]] && echo "	function linux { echo x; }"
            [[ $scn == search_set_prefix ]] && echo "	search --no-floppy --fs-uuid --set=prefix $ROOT_UUID"
            [[ $scn == set_quoted_cfgdir ]] && echo '	set "config_directory=(hd0,gpt1)/opt/evil"'
            [[ $scn == set_var_name ]] && echo '	set $x=(hd0,gpt1)/opt/evil'
            [[ $scn == unset_prefix ]] && echo "	unset prefix"
            [[ $scn == load_env_arg ]] && echo "	load_env --file /evil.env"
            [[ $scn == search_file ]] && echo "	search --file /boot/marker --fs-uuid --set=root $ROOT_UUID"
            [[ $scn == chainload ]] && echo "	chainloader (hd1)+1"
            [[ $scn == quoted_init ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro \"init=/bin/bash\""
            [[ $scn == escaped_init ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro init\\=/bin/bash"
            [[ $scn == var_init ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro \$extra"
            [[ $scn == semicolon_chain ]] && echo "	linux	/boot/vmlinuz root=UUID=$ROOT_UUID ro ; chainloader (hd0,gpt15)+1"
            [[ $scn == source_other ]] && echo "	source (hd0,gpt15)/evil.cfg"
            [[ $scn == var_command ]] && echo '	$cmd /boot/vmlinuz root=UUID=x'
            [[ $scn == other_disk_kernel ]] && echo "	linux	(hd1,gpt1)/vmlinuz root=UUID=$ROOT_UUID ro"
            [[ $scn == set_root_other ]] && echo "	set root='hd1,gpt1'"
            [[ $scn == assign_root_other ]] && echo "	root=(hd1,gpt1)"
            [[ $scn == good_custom ]] && { echo '	if [ -f ${config_directory}/custom.cfg ]; then'; echo '	  source ${config_directory}/custom.cfg'; echo '	fi'; }
            [[ $scn == brace_chain ]] && echo "	menuentry 'x' { chainloader (hd0,gpt15)+1 }"
        } > "$dir/boot/grub/grub.cfg"
        [[ $scn == ubuntu_stock ]] && cp "$(dirname "$0")/ubuntu-24.04-grub.cfg" "$dir/boot/grub/grub.cfg"
        # the grub.cfg read from the real staging images (x86 447987145, arm64 447986942 with its root UUID set to the mock's)
        [[ $scn == real_x86_cfg ]] && cp "$(dirname "$0")/staging-x86-grub.cfg" "$dir/boot/grub/grub.cfg"
        [[ $scn == real_arm64_cfg ]] && cp "$(dirname "$0")/staging-arm64-grub.cfg" "$dir/boot/grub/grub.cfg"
        [[ $scn == hwmatch_other ]] && { cp "$(dirname "$0")/staging-x86-grub.cfg" "$dir/boot/grub/grub.cfg"; sed -i.bak 's#hwmatch ${prefix}/gfxblacklist.txt 3#hwmatch (hd1,gpt1)/list 3#' "$dir/boot/grub/grub.cfg"; rm -f "$dir/boot/grub/grub.cfg.bak"; }
        [[ $scn == hwmatch_extra_arg ]] && { cp "$(dirname "$0")/staging-x86-grub.cfg" "$dir/boot/grub/grub.cfg"; sed -i.bak 's#hwmatch ${prefix}/gfxblacklist.txt 3#hwmatch ${prefix}/gfxblacklist.txt 3 x#' "$dir/boot/grub/grub.cfg"; rm -f "$dir/boot/grub/grub.cfg.bak"; }
        [[ $scn == custom_cfg_mismatch ]] && { echo "menuentry 'x' {"; linux_line "root=/dev/sdb1"; echo "}"; } > "$dir/boot/grub/custom.cfg"
        [[ $scn == grub_dir_link ]] && { mkdir -p "$dir/elsewhere"; mv "$dir/boot/grub"/* "$dir/elsewhere/"; rmdir "$dir/boot/grub"; ln -s ../elsewhere "$dir/boot/grub"; }
        [[ $scn == sym_in_grub ]] && ln -s grub.cfg "$dir/boot/grub/alias"
        [[ $scn == nested_dir_link ]] && { mkdir -p "$dir/elsewhere"; ln -s ../../elsewhere "$dir/boot/grub/sub"; }
        [[ $scn == grub_symlink ]] && { rm "$dir/boot/grub/grub.cfg"; mkdir -p "$dir/elsewhere"; printf 'x\n' > "$dir/elsewhere/g"; ln -s ../elsewhere/g "$dir/boot/grub/grub.cfg"; }
        ;;
    /dev/sda13)
        mkdir -p "$dir/grub"
        { echo "menuentry 'b' {"; linux_line "root=UUID=$ROOT_UUID"; echo "}"; } > "$dir/grub/grub.cfg"
        ;;
    /dev/sda15)
        mkdir -p "$dir/EFI/BOOT"
        L=BOOTX64.EFI; [[ ${MOCK_ARCH:-x86_64} == aarch64 && $scn != esp_x64_on_arm ]] && L=BOOTAA64.EFI
        [[ $scn == missing_loader ]] && { exit 0; }
        if [[ $scn == esp_nul_tail ]]; then printf 'efi\0(,gpt1)/boot/grub~evil\0' > "$dir/EFI/BOOT/$L"; elif [[ $scn == esp_evil_path ]]; then printf 'efi\0(,gpt1)/opt/evil\0' > "$dir/EFI/BOOT/$L"; elif [[ $scn == esp_no_prefix ]]; then printf 'efi' > "$dir/EFI/BOOT/$L"; elif [[ $scn == esp_wrong_prefix ]]; then printf 'efi (,gpt9)/boot/grub' > "$dir/EFI/BOOT/$L"; else printf 'efi\0prefix\0(,gpt1)/boot/grub\0' > "$dir/EFI/BOOT/$L"; fi
        [[ $scn == esp_extra_file ]] && echo x > "$dir/EFI/BOOT/fbx64.efi"
        if [[ $scn == esp_grub_mismatch ]]; then
            mkdir -p "$dir/EFI/ubuntu"
            { echo "menuentry 'e' {"; linux_line "root=UUID=$OTHER_UUID"; echo "}"; } > "$dir/EFI/ubuntu/grub.cfg"
        fi
        ;;
    *) echo "mount mock: unexpected device $dev" >&2; exit 32 ;;
esac
exit 0
