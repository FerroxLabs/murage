#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# j5b-journal-edit drop-sent JOURNAL : rewrites the control journal without its `sent` ops, as valid checksummed records (CCCCCCCC <json>\n, CRC32 of the
# json bytes, DESIGN-J5b-r7.md section 4). Used by D6. Atomic: writes JOURNAL.edit, fsyncs, renames. Run it with the control stopped.
import json
import os
import sys
import zlib

if len(sys.argv) != 3 or sys.argv[1] != "drop-sent":
    sys.exit("usage: j5b-journal-edit drop-sent JOURNAL")
path = sys.argv[2]
out = []
with open(path, "rb") as handle:
    data = handle.read()
offset = 0
while offset < len(data):
    end = data.find(b"\n", offset)
    if end < 0:
        break
    crc, _, raw = data[offset:end].partition(b" ")
    if crc != ("%08x" % (zlib.crc32(raw) & 0xFFFFFFFF)).encode():
        break
    ops = [op for op in json.loads(raw)["ops"] if op.get("r") != "sent"]
    if ops:
        body = json.dumps({"v": 1, "ops": ops}, separators=(",", ":")).encode()
        out.append(("%08x" % (zlib.crc32(body) & 0xFFFFFFFF)).encode() + b" " + body + b"\n")
    offset = end + 1
tmp = path + ".edit"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, b"".join(out))
os.fsync(fd)
os.close(fd)
os.rename(tmp, path)
