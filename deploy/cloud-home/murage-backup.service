# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=Murage encrypted nightly backup of /data (restic)
# Never before the backup key is installed on the Storage Box. Requires=: if authorize fails, this backup does not run
# (the next timer run retries authorize first). After the first boot authorize is skipped by its condition, which
# counts as success.
After=data.mount network-online.target murage-backup-authorize.service
Requires=data.mount murage-backup-authorize.service
ConditionPathExists=/etc/murage-home/backup.json

[Service]
Type=oneshot
User=root
UMask=0077
LimitCORE=0
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 -I /usr/local/libexec/murage-backup
TimeoutStartSec=3h
