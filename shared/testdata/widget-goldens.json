          "type": "book.call"
        }
      },
      "cancel": {
        "label": "Not now",
        "action": {
          "type": "cancel"
        }
      },
      "size": "md",
      "children": [
        {
          "type": "DatePicker",
          "id": "n2",
          "name": "date",
          "label": "Date",
          "min": "2026-01-01",
          "max": "2026-12-31"
        },
        {
          "type": "TimePicker",
          "id": "n3",
          "name": "time",
          "label": "Time",
          "defaultValue": "09:05",
          "step": 15
        },
        {
          "type": "Select",
          "id": "n4",
          "name": "length",
          "label": "Length",
          "options": [
            {
              "label": "30 minutes",
              "value": "30"
            },
            {
              "label": "1 hour",
              "value": "60"
