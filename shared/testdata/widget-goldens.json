[
  {
    "name": "book a call form",
    "input": {
      "type": "Card",
      "title": "Book a call",
      "caption": "Pick a slot",
      "size": "md",
      "confirm": {
        "label": "Book it",
        "action": {
          "type": "book.call"
        }
      },
      "cancel": {
        "label": "Not now",
        "action": {
          "type": "cancel"
        }
      },
      "children": [
        {
          "type": "DatePicker",
          "name": "date",
          "label": "Date",
          "min": "2026-01-01",
          "max": "2026-12-31"
        },
        {
          "type": "TimePicker",
          "name": "time",
          "label": "Time",
          "step": 15,
          "defaultValue": "9:05"
        },
        {
          "type": "Select",
          "name": "length",
          "label": "Length",
          "options": [
            {
              "label": "30 minutes",
              "value": "30"
            },
            {
              "label": "1 hour",
              "value": 60
            }
          ]
        },
        {
          "type": "Textarea",
          "name": "note",
          "label": "Note",
          "placeholder": "Anything to add"
        }
      ]
    },
    "canonical": {
      "type": "Card",
